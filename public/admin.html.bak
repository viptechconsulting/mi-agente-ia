     <div class="camp-timing"><label>Hora de envio</label><input type="time" id="camp-birthday-time" value="09:00" style="width:100px;padding:5px 8px;font-size:12px"></div>
     <div style="margin-bottom:10px"><label style="font-size:11px;color:var(--muted)">% de descuento (dejar vacio para no incluir)</label><input type="number" id="camp-birthday-discount" value="15" min="0" max="100" style="width:80px;margin-top:4px"></div>
     <textarea id="camp-birthday-msg" style="min-height:80px;font-size:12px">Feliz cumpleanos {nombre}. En tu dia especial te regalamos un {descuento}% de descuento en tu proxima visita. Escribenos para agendar.</textarea>
     <div class="camp-vars">Variables: <code>{nombre}</code> <code>{descuento}</code> <code>{negocio}</code> <code>{link_reserva}</code></div>
     <button style="font-size:12px;padding:6px 16px" onclick="saveCampaign('birthday')">Guardar</button>
    </div>
   </div>

   <div class="camp-card" id="camp-card-review">
