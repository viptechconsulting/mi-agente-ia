   <div class="admin-lang-toggle">
    <button class="admin-lt-btn active" id="al-es" onclick="setAdminLang('es')">ES</button>
    <button class="admin-lt-btn" id="al-en" onclick="setAdminLang('en')">EN</button>
   </div>
   <button id="themeBtn" onclick="toggleTheme()" class="theme-btn">
    <i data-lucide="sun" id="themeIcon" style="width:14px;height:14px;stroke:currentColor;fill:none;flex-shrink:0"></i>
    <span id="themeTxt" data-i18n="theme_light">Modo claro</span>
   </button>
   <button onclick="logout()" class="theme-btn" style="margin-top:6px;color:#ef4444;border-color:rgba(239,68,68,.2)">
    <i data-lucide="log-out" style="width:14px;height:14px;stroke:currentColor;fill:none;flex-shrink:0"></i>
