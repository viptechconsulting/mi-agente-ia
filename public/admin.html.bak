  web:       { label: 'Web Chat',   color: '#27F59B', icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="20" height="20"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>` },
  whatsapp:  { label: 'WhatsApp',   color: '#25D366', icon: `<svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347zM12 0C5.373 0 0 5.373 0 12c0 2.123.554 4.116 1.527 5.845L.057 23.428a.75.75 0 0 0 .918.919l5.53-1.456A11.946 11.946 0 0 0 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 22c-1.934 0-3.742-.525-5.292-1.436l-.38-.223-3.94 1.037 1.055-3.846-.247-.395A9.942 9.942 0 0 1 2 12C2 6.477 6.477 2 12 2s10 4.477 10 10-4.477 10-10 10z"/></svg>` },
  instagram: { label: 'Instagram',  color: '#E1306C', icon: `<svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>` },
  messenger: { label: 'Messenger',  color: '#0084FF', icon: `<svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20"><path d="M12 0C5.373 0 0 5.373 0 12c0 3.866 1.83 7.307 4.688 9.562V24l4.138-2.273C10.211 21.89 11.094 22 12 22c6.627 0 12-4.925 12-11S18.627 0 12 0zm1.188 14.833l-3.057-3.26-5.965 3.26L10.79 8.25l3.13 3.26 5.893-3.26-6.625 6.583z"/></svg>` },
};
const STAGE_META = {
  'Interested':      { color: '#27F59B', icon: '★' },
  'Needs Follow-Up': { color: '#F59E0B', icon: '◉' },
  'Unknown':         { color: '#6B7280', icon: '?' },
  'Blocked':         { color: '#EF4444', icon: '✕' },
  'Not Interested':  { color: '#F97316', icon: '–' },
};

function loadStats() {
  const period = document.getElementById('statsPeriod')?.value || 'all';
  api(`/api/stats?period=${period}`).then(data => {
    if (!data || data.error) return;
    renderChannels(data.byChannel || [], data.total || 0);
    renderDonut(data.byChannel || [], data.total || 0);
    renderStages(data.byStage || []);
    renderActivity(data.activity || []);
  });
}

function renderChannels(rows, total) {
  const el = document.getElementById('statsChannels');
  if (!el) return;
  const allChannels = ['web','whatsapp','instagram','messenger'];
  const map = Object.fromEntries(rows.map(r => [r.channel, r.count]));
  el.innerHTML = allChannels.map(ch => {
    const m = CHANNEL_META[ch];
    const count = map[ch] || 0;
    const pct = total ? Math.round(count / total * 100) : 0;
    return `
      <div style="display:flex;align-items:center;gap:12px">
        <div style="width:36px;height:36px;border-radius:10px;background:${m.color}18;display:flex;align-items:center;justify-content:center;flex-shrink:0;color:${m.color}">${m.icon}</div>
        <div style="flex:1;min-width:0">
          <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:4px">
            <span style="font-size:13px;color:#d0d8e8;font-weight:500">${m.label}</span>
            <span style="font-size:14px;font-weight:700;color:#e0e8f0">${count}</span>
          </div>
          <div style="height:4px;background:#1a1a2e;border-radius:4px;overflow:hidden">
            <div style="height:100%;width:${pct}%;background:${m.color};border-radius:4px;transition:width .6s ease"></div>
          </div>
        </div>
        <span style="font-size:11px;color:#555;min-width:28px;text-align:right">${pct}%</span>
      </div>`;
  }).join('');
}

function renderDonut(rows, total) {
  const svg = document.getElementById('statsDonut');
  const legend = document.getElementById('statsLegend');
  const tot = document.getElementById('donutTotal');
  if (!svg || !legend || !tot) return;
  tot.textContent = total;

  const R = 64, cx = 80, cy = 80, stroke = 18;
  const circ = 2 * Math.PI * R;

  // Build arcs
  const allCh = ['web','whatsapp','instagram','messenger'];
  const map = Object.fromEntries(rows.map(r => [r.channel, r.count]));
  let offset = -Math.PI / 2; // start from top

  // Remove old arcs (keep text)
  svg.querySelectorAll('circle.arc, circle.bg').forEach(e => e.remove());

  // Background ring
  const bg = document.createElementNS('http://www.w3.org/2000/svg','circle');
  bg.setAttribute('cx', cx); bg.setAttribute('cy', cy); bg.setAttribute('r', R);
  bg.setAttribute('fill','none'); bg.setAttribute('stroke','#1a1a2e');
  bg.setAttribute('stroke-width', stroke); bg.setAttribute('class','bg');
  svg.insertBefore(bg, svg.firstChild);

  if (total === 0) {
    legend.innerHTML = '<span style="font-size:12px;color:#444">Sin datos</span>';
    return;
  }

  allCh.forEach(ch => {
    const count = map[ch] || 0;
    if (!count) return;
    const m = CHANNEL_META[ch];
    const frac = count / total;
    const dash = frac * circ;
    const gap = circ - dash;
    const rotDeg = (offset + Math.PI / 2) * (180 / Math.PI);

    const arc = document.createElementNS('http://www.w3.org/2000/svg','circle');
    arc.setAttribute('cx', cx); arc.setAttribute('cy', cy); arc.setAttribute('r', R);
    arc.setAttribute('fill','none'); arc.setAttribute('stroke', m.color);
    arc.setAttribute('stroke-width', stroke);
    arc.setAttribute('stroke-dasharray', `${dash} ${gap}`);
    arc.setAttribute('stroke-dashoffset', 0);
    arc.setAttribute('transform', `rotate(${rotDeg}, ${cx}, ${cy})`);
    arc.setAttribute('class','arc');
    svg.appendChild(arc);

    offset += frac * 2 * Math.PI;
  });

  legend.innerHTML = allCh.filter(ch => map[ch]).map(ch => {
    const m = CHANNEL_META[ch];
    return `<span style="display:inline-flex;align-items:center;gap:5px;font-size:11px;color:#aaa">
      <span style="width:8px;height:8px;border-radius:50%;background:${m.color};flex-shrink:0;display:inline-block"></span>
      ${m.label}
    </span>`;
  }).join('');
}

function renderStages(rows) {
  const el = document.getElementById('statsStages');
  if (!el) return;
  const maxCount = Math.max(...rows.map(r => r.count), 1);
  el.innerHTML = rows.map(r => {
    const m = STAGE_META[r.stage] || { color: '#666', icon: '•' };
    const pct = Math.round(r.count / maxCount * 100);
    return `
      <div style="display:flex;align-items:center;gap:10px">
        <span style="font-size:14px;width:20px;text-align:center;flex-shrink:0">${m.icon}</span>
        <div style="flex:1;min-width:0">
          <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:3px">
            <span style="font-size:12px;color:#b0bcd0">${r.stage}</span>
            <span style="font-size:13px;font-weight:700;color:#e0e8f0">${r.count}</span>
          </div>
          <div style="height:3px;background:#1a1a2e;border-radius:3px;overflow:hidden">
            <div style="height:100%;width:${pct}%;background:${m.color};border-radius:3px;transition:width .6s ease"></div>
          </div>
        </div>
      </div>`;
  }).join('');
}

function renderActivity(rows) {
  const svg = document.getElementById('statsActivity');
  if (!svg) return;
  if (!rows.length) { svg.innerHTML = `<text x="50%" y="50%" text-anchor="middle" fill="#333" font-size="12">Sin actividad en este período</text>`; return; }

  const W = svg.parentElement?.clientWidth || 500;
  const H = 64;
  const maxC = Math.max(...rows.map(r => r.c), 1);
  const pad = 8;
  const barW = Math.max(2, Math.floor((W - pad * 2) / rows.length) - 2);
  const gold = getComputedStyle(document.documentElement).getPropertyValue('--gold').trim() || '#D4AF37';

  svg.setAttribute('viewBox', `0 0 ${W} ${H}`);
  svg.innerHTML = rows.map((r, i) => {
    const bH = Math.max(3, Math.round((r.c / maxC) * (H - pad * 2)));
    const x = pad + i * ((W - pad * 2) / rows.length);
    const y = H - pad - bH;
    return `<rect x="${x.toFixed(1)}" y="${y}" width="${barW}" height="${bH}" rx="2" fill="${gold}" opacity="0.7"/>`;
  }).join('');
}

function filterCampaigns(q) { /* future: filter campaign rows */ }

function updateHandoffSlider() {
  const cb = document.getElementById('humanHandoffEnabled');
  const slider = document.getElementById('humanHandoffSlider');
  const thumb = document.getElementById('humanHandoffThumb');
  if (!cb || !slider || !thumb) return;
  const on = cb.checked;
  slider.style.background = on ? '#F59E0B' : '#333';
  thumb.style.transform = on ? 'translateX(18px)' : 'translateX(0)';
}

function downloadReport() {
 const days = document.getElementById('reportDays').value;
 window.open(`/api/report/weekly.pdf?days=${days}&pw=${encodeURIComponent(password)}`, '_blank');
}

function previewReport() {
 const days = document.getElementById('reportDays').value;
 const preview = document.getElementById('reportPreview');
 const content = document.getElementById('reportContent');
 content.innerHTML = '<p style="color:#888">Generando... (puede tardar unos segundos por las sugerencias de IA)</p>';
 preview.style.display = 'block';
 fetch(`/api/report/weekly.json?days=${days}`, { headers: { 'x-admin-password': password } })
 .then(r => r.json()).then(d => {
 content.innerHTML = `
 <div style="color:#aaa;font-size:12px;margin-bottom:14px">${d.period} · ${d.generatedAt}</div>
 <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(120px,1fr));gap:10px;margin-bottom:20px">
 <div class="metric"><div class="v">${d.totalConvs}</div><div class="l">Total chats</div></div>
 <div class="metric"><div class="v">${d.resolutionRate===null?'—':d.resolutionRate+'%'}</div><div class="l">Resolución</div></div>
 <div class="metric"><div class="v">${d.ratings.satisfaction===null?'—':d.ratings.satisfaction+'%'}</div><div class="l">Satisfacción</div></div>
 <div class="metric"><div class="v">${d.leads.length}</div><div class="l">Leads</div></div>
 </div>
 <h3 style="color:var(--gold);font-size:13px;letter-spacing:1px">TOP PREGUNTAS</h3>
 ${d.topQuestions.map((q,i) => `<div style="color:#ccc;font-size:13px;margin:4px 0">${i+1}. (${q.count}x) ${q.q.slice(0,120)}</div>`).join('') || '<div style="color:#666">—</div>'}
 <h3 style="color:var(--gold);font-size:13px;letter-spacing:1px;margin-top:20px">LEADS CAPTURADOS</h3>
 ${d.leads.length ? d.leads.map(l => `<div style="color:#ccc;font-size:13px">• ${l.type}: ${l.value}</div>`).join('') : '<div style="color:#666">Ninguno detectado</div>'}
 <h3 style="color:var(--gold);font-size:13px;letter-spacing:1px;margin-top:20px">SUGERENCIAS DE MEJORA (IA)</h3>
 ${d.suggestions.length ? d.suggestions.map(s => `<div style="color:#ccc;font-size:13px;margin:6px 0;padding-left:16px;border-left:2px solid var(--gold)">${s}</div>`).join('') : '<div style="color:#666">—</div>'}
 `;
 });
}

function renderQuick() {
 const list = document.getElementById('quickList');
 if (!list) return;
 list.innerHTML = '';
 (config.quickReplies || []).forEach((q, i) => {
 const div = document.createElement('div');
 div.className = 'faq-item';
 div.innerHTML = `
 <button onclick="removeQuick(${i})">Eliminar</button>
 <label>Etiqueta (texto del botón)</label>
 <input value="${(q.label||'').replace(/"/g,'&quot;')}" onchange="config.quickReplies[${i}].label=this.value">
 <label>Mensaje que se envía al clickear</label>
 <input value="${(q.message||'').replace(/"/g,'&quot;')}" onchange="config.quickReplies[${i}].message=this.value">`;
 list.appendChild(div);
 });
}
function addQuick() { config.quickReplies = config.quickReplies || []; config.quickReplies.push({label:'',message:''}); renderQuick(); }
function removeQuick(i) { config.quickReplies.splice(i,1); renderQuick(); }

const DAY_NAMES = ['Domingo','Lunes','Martes','Miércoles','Jueves','Viernes','Sábado'];
function renderHours() {
 const oh = config.officeHours || {};
 const en = document.getElementById('ohEnabled'); if (en) en.checked = !!oh.enabled;
 const tz = document.getElementById('ohTimezone'); if (tz && oh.timezone) tz.value = oh.timezone;
 const msg = document.getElementById('ohOfflineMessage'); if (msg) msg.value = oh.offlineMessage || '';
 const list = document.getElementById('scheduleList');
 if (!list) return;
 const schedule = oh.schedule || [];
 const order = [1,2,3,4,5,6,0];
 list.innerHTML = order.map(d => {
 const day = schedule.find(s => s.day === d) || { day: d, enabled: false, open: '09:00', close: '18:00' };
 return `
 <div style="display:flex;align-items:center;gap:10px;padding:8px;background:#0c0c0c;border:1px solid #1a1a1a;border-radius:8px;margin-bottom:6px">
 <label style="display:flex;align-items:center;gap:8px;cursor:pointer;flex:0 0 130px;margin:0">
 <input type="checkbox" ${day.enabled?'checked':''} style="width:auto" onchange="setDay(${d},'enabled',this.checked)">
 <span style="color:#ccc">${DAY_NAMES[d]}</span>
 </label>
 <input type="time" value="${day.open}" onchange="setDay(${d},'open',this.value)" style="flex:0 0 120px">
 <span style="color:#888">a</span>
 <input type="time" value="${day.close}" onchange="setDay(${d},'close',this.value)" style="flex:0 0 120px">
 </div>`;
 }).join('');
}

function renderAppearance() {
 const ac2 = document.getElementById('accentColor2');
 if (ac2) ac2.value = config.accentColor || '#D4AF37';
 const bg = document.getElementById('bgColor'); if (bg) bg.value = config.bgColor || '#0a0a0a';
 const ub = document.getElementById('userBubbleColor'); if (ub) ub.value = config.userBubbleColor || '#2a2205';
 const logo = document.getElementById('logoPreview'); if (logo) logo.src = config.logoUrl || '';
 const av = document.getElementById('avatarPreview'); if (av) av.src = config.avatarUrl || '';
 document.querySelectorAll('input[name=pos]').forEach(r => r.checked = r.value === (config.widgetPosition || 'right'));
 updatePreview();
}

function syncAppearance() {
 config.accentColor = document.getElementById('accentColor2').value;
 config.bgColor = document.getElementById('bgColor').value;
 config.userBubbleColor = document.getElementById('userBubbleColor').value;
 updatePreview();
}

function updatePreview() {
 const ac = config.accentColor || '#D4AF37';
 const bg = config.bgColor || '#0a0a0a';
 const ub = config.userBubbleColor || '#2a2205';
 const pos = config.widgetPosition || 'right';
 const launcher = document.getElementById('previewLauncher');
 const panel = document.getElementById('previewPanel');
 if (!launcher) return;
 launcher.style[pos==='right'?'right':'left'] = '16px';
 launcher.style[pos==='right'?'left':'right'] = 'auto';
 panel.style[pos==='right'?'right':'left'] = '16px';
 panel.style[pos==='right'?'left':'right'] = 'auto';
 launcher.style.background = `linear-gradient(135deg,#1a1a1a,${bg})`;
 launcher.style.border = `1px solid ${ac}`;
 launcher.style.boxShadow = `0 6px 20px ${ac}66`;
 launcher.innerHTML = config.logoUrl
 ? `<img src="${config.logoUrl}" style="width:100%;height:100%;object-fit:cover">`
 : `<svg viewBox="0 0 24 24" style="width:22px;height:22px;fill:${ac}"><path d="M12 2a10 10 0 0 0-8.5 15.2L2 22l4.9-1.4A10 10 0 1 0 12 2z"/></svg>`;
 panel.style.background = bg;
 panel.style.borderColor = ac + '40';
 const header = document.getElementById('previewHeader');
 header.style.borderColor = ac + '26';
 header.innerHTML = (config.logoUrl ? `<img src="${config.logoUrl}" style="width:22px;height:22px;border-radius:50%;object-fit:cover">` : '') +
 `<span style="width:6px;height:6px;border-radius:50%;background:${ac};box-shadow:0 0 8px ${ac}"></span>` +
 `<span>${config.businessName || 'Asistente'}</span>`;
 const agentMsg = document.getElementById('previewAgentMsg');
 agentMsg.innerHTML = (config.avatarUrl ? `<img src="${config.avatarUrl}" style="width:22px;height:22px;border-radius:50%;object-fit:cover;flex:0 0 22px">` : '') +
 `<span>${config.welcomeMessage || '¡Hola!'}</span>`;
 const userMsg = document.getElementById('previewUserMsg');
 userMsg.style.background = `linear-gradient(135deg,${ub},#1a1503)`;
 userMsg.style.border = `1px solid ${ac}40`;
 const btn = document.getElementById('previewBtn');
 btn.style.background = `linear-gradient(135deg,${ac},${ac}bb)`;
 const inp = document.getElementById('previewInput');
 inp.style.borderColor = ac + '1f';
}

function uploadImage(input, key, previewId) {
 const f = input.files[0]; if (!f) return;
 const fd = new FormData(); fd.append('file', f);
 fetch('/api/upload/image', { method:'POST', headers:{'x-admin-password': password}, body: fd })
 .then(r => r.json()).then(d => {
 if (d.error) return toast('Error: ' + d.error);
 config[key] = d.url;
 document.getElementById(previewId).src = d.url;
 updatePreview(); toast('Imagen subida ');
 });
}

function clearImg(key, previewId) {
 config[key] = '';
 document.getElementById(previewId).src = '';
 updatePreview();
}

function setDay(d, key, val) {
 config.officeHours = config.officeHours || { schedule: [] };
 config.officeHours.schedule = config.officeHours.schedule || [];
 let day = config.officeHours.schedule.find(s => s.day === d);
 if (!day) { day = { day: d, enabled: false, open: '09:00', close: '18:00' }; config.officeHours.schedule.push(day); }
 day[key] = val;
}

function save() {
 ['businessName','description','hours','contact','products','tone',
 'welcomeMessage','bookingUrl','systemPromptExtra','model','accentColor',
 'agentName','personality','language','voiceExamples',
 'waBaseUrl','waInstance','waApiKey',
 'metaAppId','metaAppSecret',
 'bgColor','userBubbleColor',
 'notifyEmail','smtpHost','smtpPort','smtpUser','smtpPass','smtpFrom'].forEach(k => {
 const el = document.getElementById(k);
 if (el) config[k] = el.value;
 });
 const ac2 = document.getElementById('accentColor2');
 if (ac2 && ac2.value) config.accentColor = ac2.value;
 const t2 = document.getElementById('tone2');
 if (t2 && t2.value) config.tone = t2.value;
 const ad = document.getElementById('autoDetectLanguage');
 if (ad) config.autoDetectLanguage = ad.checked;
 ['notifyOnLead','notifyOnEscalation','smtpSecure','bookingFollowupEnabled'].forEach(k => {
 const el = document.getElementById(k); if (el) config[k] = el.checked;
 });
 // Human handoff
 const hhE = document.getElementById('humanHandoffEnabled'); if (hhE) config.humanHandoffEnabled = hhE.checked;
 ['humanHandoffTriggers','humanHandoffPhone','humanHandoffUserMsg'].forEach(k => {
  const el = document.getElementById(k); if (el) config[k] = el.value;
 });
 const en = document.getElementById('ohEnabled');
 if (en) {
 config.officeHours = config.officeHours || {};
 config.officeHours.enabled = en.checked;
 const tz = document.getElementById('ohTimezone'); if (tz) config.officeHours.timezone = tz.value;
 const msg = document.getElementById('ohOfflineMessage'); if (msg) config.officeHours.offlineMessage = msg.value;
 }
 api('/api/config', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(config) })
 .then(c => { config = c; toast('Guardado '); });
}

function tab(name) {
 document.querySelectorAll('.nav-item').forEach(b => b.classList.remove('active'));
 document.querySelector(`.nav-item[data-tab="${name}"]`)?.classList.add('active');
 document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
 document.getElementById('tab-'+name).classList.add('active');
 if (name === 'convs') loadConvs();
 if (name === 'leads') loadLeads();
 if (name === 'knowledge') loadDocs();
 if (name === 'dashboard') loadDashboard();
 if (name === 'training') loadTraining();
 if (name === 'campanas') loadCampanas();
 if (name === 'citas') loadCitas();
 if (name === 'companies') loadCompaniesList();
 if (name === 'demos') loadDemos();
 if (name === 'users') loadUsers();
 if (name === 'reports') loadStats();
 if (name === 'triggers') renderTriggers();
 if (name === 'billing') loadBillingStatus();
}

function loadDemos() {
 // Show context badge — demos always belong to the Lynkro.io master account
 const badge = document.getElementById('demosContextBadge');
 if (badge && masterCompanyId) {
  const mc = companies.find(c => c.id === masterCompanyId);
  badge.style.display = '';
  badge.textContent = `Demos gestionados desde: ${mc?.name || 'Lynkro.io'}`;
 }

 // Populate parent dropdown AND templates list — only Lynkro.io-owned templates
 fetch('/api/companies?demo=0', { headers: { 'x-admin-password': password, 'x-company-id': masterCompanyId || '' } })
 .then(r => r.json()).then(prod => {
  const templates = masterCompanyId
   ? prod.filter(c => c.parent_company_id === masterCompanyId)
   : prod;
  const sel = document.getElementById('demoParent');
  if (sel) sel.innerHTML = '<option value="">— Empresa vacía (plantilla)</option>' + templates.map(c => `<option value="${c.id}">${c.name}</option>`).join('');
  // Render templates list
  const tl = document.getElementById('templatesListDemo');
  if (tl) tl.innerHTML = templates.length ? templates.map(t => `
   <div class="faq-item" style="padding:12px 16px">
    <div style="display:flex;justify-content:space-between;align-items:center;gap:12px">
     <div>
      <div style="font-weight:600;color:var(--text);font-size:14px">${t.name}</div>
      <div style="color:var(--muted);font-size:11px;margin-top:3px">ID: ${t.id}</div>
     </div>
     <button onclick="editTemplate('${t.id}')" style="background:var(--card);color:var(--gold);border:1px solid var(--border);font-size:11px;white-space:nowrap"> Editar plantilla</button>
     <button onclick="toggleGenerateForm('${t.id}')" style="background:rgba(0,200,90,.1);color:#4ade80;border:1px solid rgba(0,200,90,.3);font-size:11px;white-space:nowrap">Generar con IA</button>
     <button onclick="deleteTemplate('${t.id}','${t.name.replace(/'/g,&quot;\\'&quot;)}')" style="background:var(--card);color:#ef4444;border:1px solid var(--border);font-size:11px;white-space:nowrap">Eliminar</button>
    </div>
    <div id="genform-${t.id}" style="display:none;margin-top:12px">
     <textarea id="geninfo-${t.id}" rows="3" placeholder="Describe el negocio en un párrafo: servicios, ubicación, horarios, diferenciadores, público objetivo..." style="width:100%;resize:vertical;font-size:12px;line-height:1.5;margin-bottom:8px"></textarea>
     <div style="display:flex;gap:8px;align-items:center">
      <button onclick="generateTemplate('${t.id}')" style="background:linear-gradient(135deg,#00C85A,#00A84A);color:#fff;font-size:12px;border:none">Generar ahora</button>
      <span id="genstatus-${t.id}" style="font-size:11px;color:var(--muted)"></span>
     </div>
    </div>
   </div>`).join('') : '<p style="color:#666;font-size:13px">No hay plantillas configuradas.</p>';
 });
 fetch('/api/companies?demo=1', { headers: { 'x-admin-password': password, 'x-company-id': masterCompanyId || '' } })
 .then(r => r.json()).then(demos => {
 const el = document.getElementById('demosList');
 if (!demos.length) { el.innerHTML = '<p style="color:#666">Aún no has creado demos.</p>'; return; }
 el.innerHTML = demos.map(d => {
 const link = `${location.origin}/demo/${d.share_token}`;
 const expired = d.expires_at && Date.now() > d.expires_at;
 const daysLeft = d.expires_at ? Math.ceil((d.expires_at - Date.now()) / 86400000) : null;
 return `
 <div class="faq-item">
 <div style="display:flex;gap:6px;position:absolute;top:10px;right:10px;flex-wrap:wrap;max-width:50%;justify-content:flex-end">
 <button onclick="copyLink('${link}')" style="background:var(--card);color:var(--green);border:1px solid var(--border);font-size:11px"> Copiar link</button>
 <button onclick="openDemoPreview('${link}')" style="background:var(--card);color:var(--green);border:1px solid var(--border);font-size:11px"> Abrir</button>
 <button onclick="switchCompany('${d.id}')" style="background:var(--card);color:var(--muted);border:1px solid var(--border);font-size:11px">Editar</button>
 <button onclick="duplicateDemo('${d.id}')" style="background:var(--card);color:var(--muted);border:1px solid var(--border);font-size:11px">Duplicar</button>
 <button onclick="toggleCompany('${d.id}', ${d.active?0:1})" style="background:${d.active?'#2a2a0a':'#0a2a0a'};color:${d.active?'#fbbf24':'#4ade80'};border:1px solid var(--border);font-size:11px">${d.active?'Desactivar':'Activar'}</button>
 <button onclick="deleteCompanyAdmin('${d.id}','${d.name}')" style="font-size:11px">Eliminar</button>
 </div>
 <div style="margin-right:280px;margin-bottom:12px">
 <div style="font-weight:600;color:var(--green);font-size:15px">
 ${d.name}
 ${!d.active?'<span style="color:#fbbf24;font-size:10px;margin-left:8px">INACTIVA</span>':''}
 ${expired?'<span style="color:#ef4444;font-size:10px;margin-left:8px">EXPIRADA</span>':''}
 </div>
 <div style="color:var(--muted);font-size:12px;margin-top:4px">
 Creada ${new Date(d.created_at).toLocaleDateString()}
 ${d.expires_at?` · ${expired?'expiró':'expira en '+daysLeft+' días'}`:' · sin expiración'}
 ${d.parent_company_id?' · clonada de empresa existente':''}
 </div>
 </div>
 <label>Link compartible</label>
 <input readonly value="${link}" style="font-family:monospace;font-size:12px" onclick="this.select()">
 </div>`;
 }).join('');
 });
}

function createTemplate() {
 const name = document.getElementById('newTemplateName').value.trim();
 const info = document.getElementById('newTemplateInfo').value.trim();
 if (!name) return toast('Falta nombre de plantilla');
 if (!masterCompanyId) return toast('No se encontró la cuenta Lynkro.io');
 fetch('/api/templates', {
  method: 'POST',
  headers: { 'Content-Type': 'application/json', 'x-admin-password': password, 'x-company-id': masterCompanyId },
  body: JSON.stringify({ name })
 }).then(r => r.json()).then(d => {
  if (d.error) return toast('Error: ' + d.error);
  document.getElementById('newTemplateName').value = '';
  document.getElementById('newTemplateInfo').value = '';
  if (info) {
   const genEl = document.getElementById('templateGenerating');
   if (genEl) genEl.style.display = '';
   toast('Plantilla creada — generando contenido con IA...');
   fetch(`/api/templates/${d.id}/generate`, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json', 'x-admin-password': password },
    body: JSON.stringify({ businessInfo: info })
   }).then(r => r.json()).then(g => {
    if (genEl) genEl.style.display = 'none';
    if (g.error) return toast('Plantilla creada pero error en IA: ' + g.error);
    toast(`✓ Contenido generado — ${g.faqsAdded} FAQs agregadas`);
    loadDemos();
   });
  } else {
   toast('Plantilla creada ✓');
   loadDemos();
  }
 });
}

function toggleGenerateForm(id) {
 const el = document.getElementById('genform-' + id);
 if (!el) return;
 el.style.display = el.style.display === 'none' ? '' : 'none';
 if (el.style.display !== 'none') document.getElementById('geninfo-' + id)?.focus();
}

function generateTemplate(id) {
 const info = document.getElementById('geninfo-' + id)?.value.trim();
 if (!info) return toast('Pega la información del negocio primero');
 const status = document.getElementById('genstatus-' + id);
 if (status) status.textContent = ' Generando...';
 fetch(`/api/templates/${id}/generate`, {
  method: 'POST',
  headers: { 'Content-Type': 'application/json', 'x-admin-password': password },
  body: JSON.stringify({ businessInfo: info })
 }).then(r => r.json()).then(d => {
  if (status) status.textContent = '';
  if (d.error) return toast('Error: ' + d.error);
  toast(`✓ Contenido generado — ${d.faqsAdded} FAQs agregadas`);
  document.getElementById('genform-' + id).style.display = 'none';
  loadDemos();
 });
}

function deleteTemplate(id, name) {
 if (!confirm(`¿Eliminar la plantilla "${name}" y todos sus datos? Esto es irreversible.`)) return;
 fetch('/api/templates/' + id, {
  method: 'DELETE',
  headers: { 'x-admin-password': password }
 }).then(r => r.json()).then(d => {
  if (d.error) return toast('Error: ' + d.error);
  toast('Plantilla eliminada');
  loadDemos();
 });
}

function createDemo() {
 const name = document.getElementById('demoName').value.trim();
 const parentCompanyId = document.getElementById('demoParent').value || null;
 const expiresInDays = parseInt(document.getElementById('demoExpiry').value) || null;
 const seedSample = document.getElementById('demoSeed').checked;
 if (!name) return toast('Falta nombre');
 fetch('/api/demos', {
 method: 'POST',
 headers: { 'Content-Type': 'application/json', 'x-admin-password': password, 'x-company-id': masterCompanyId || '' },
 body: JSON.stringify({ name, parentCompanyId, expiresInDays, seedSample })
 }).then(r => r.json()).then(d => {
 if (d.error) return toast('Error: '+d.error);
 toast('Demo creado ✓');
 document.getElementById('demoName').value = '';
 document.getElementById('demoExpiry').value = '';
 loadDemos();
 loadCompaniesList();
 });
}

function duplicateDemo(id) {
 fetch(`/api/demos/${id}/duplicate`, { method: 'POST', headers: { 'x-admin-password': password, 'x-company-id': masterCompanyId || '' } })
 .then(r => r.json()).then(d => {
 if (d.error) return toast('Error: '+d.error);
 toast('Duplicado '); loadDemos();
 });
}

function copyLink(url) {
 navigator.clipboard.writeText(url).then(() => toast('Link copiado '));
}

function openDemoPreview(url) { window.open(url, '_blank'); }

function loadTraining() {
 fetch('/api/training/pending', { headers: { 'x-admin-password': password } })
 .then(r => r.json()).then(rows => {
 const el = document.getElementById('pendingList');
 if (!rows.length) { el.innerHTML = '<p style="color:#4ade80"> No hay preguntas pendientes de entrenar</p>'; return; }
 el.innerHTML = rows.map(r => `
 <div class="faq-item">
 <div style="display:flex;gap:8px;position:absolute;top:10px;right:10px">
 <button onclick="ignoreTraining(${r.message_id})" style="background:#1a1a1a;color:#888;border:1px solid #333;font-size:11px">Ignorar</button>
 </div>
 <div style="margin-right:140px">
 <div style="color:var(--gold);font-size:11px;text-transform:uppercase;letter-spacing:1px;margin-bottom:4px">${r.channel==='whatsapp'?' WhatsApp':' Web'}${r.rating===-1?' · ':''}</div>
 <div style="color:#ccc;margin-bottom:6px"><b>Cliente preguntó:</b><br>${(r.question||'').replace(/</g,'&lt;')}</div>
 ${r.reply ? `<div style="color:#666;font-size:12px;margin-bottom:10px"><b>Agente respondió:</b><br>${r.reply.replace(/</g,'&lt;').slice(0,200)}</div>` : ''}
 </div>
 <label>Respuesta correcta (la que el agente debió haber dado)</label>
 <textarea id="ans_${r.message_id}" placeholder="Escribe aquí la respuesta que enseñarás al agente..."></textarea>
 <br><br>
 <button onclick="teach(${r.message_id}, ${JSON.stringify(r.question).replace(/"/g,'&quot;')})"> Entrenar al agente</button>
 </div>`).join('');
 });

 fetch('/api/training/list', { headers: { 'x-admin-password': password } })
 .then(r => r.json()).then(rows => {
 const el = document.getElementById('trainedList');
 if (!rows.length) { el.innerHTML = '<p style="color:#666">Aún no has entrenado ninguna respuesta.</p>'; return; }
 el.innerHTML = rows.map(r => `
 <div class="faq-item">
 <button onclick="deleteTraining(${r.id})">Eliminar</button>
 <div style="color:var(--gold);font-weight:600;margin-bottom:6px">P: ${r.question.replace(/</g,'&lt;').slice(0,150)}</div>
 <div style="color:#ccc;font-size:13px">R: ${r.answer.replace(/</g,'&lt;').slice(0,300)}</div>
 </div>`).join('');
 });
}

function teach(messageId, question) {
 const answer = document.getElementById('ans_' + messageId).value.trim();
 if (!answer) return toast('Escribe la respuesta correcta');
 fetch('/api/training/teach', {
 method: 'POST',
 headers: { 'Content-Type': 'application/json', 'x-admin-password': password },
 body: JSON.stringify({ question, answer, messageId })
 }).then(() => { toast(' Agente entrenado'); loadTraining(); });
}

function ignoreTraining(messageId) {
 fetch('/api/training/ignore', {
 method: 'POST',
 headers: { 'Content-Type': 'application/json', 'x-admin-password': password },
 body: JSON.stringify({ messageId })
 }).then(() => loadTraining());
}

function deleteTraining(id) {
 if (!confirm('¿Eliminar esta respuesta entrenada?')) return;
 fetch('/api/training/' + id, { method: 'DELETE', headers: { 'x-admin-password': password } })
 .then(() => { toast('Eliminada'); loadTraining(); });
}

let demoHistory = [];

function openDemo() {
 document.getElementById('demoModal').style.display = 'flex';
 resetDemo();
}
function closeDemo() { document.getElementById('demoModal').style.display = 'none'; }
function resetDemo() {
 demoHistory = [];
 const el = document.getElementById('demoMessages');
 el.innerHTML = '';
 const welcome = config.welcomeMessage || '¡Hola! ¿En qué puedo ayudarte?';
 addDemoMsg('assistant', welcome);
 (config.quickReplies || []).forEach(q => {
 const b = document.createElement('button');
 b.textContent = q.label;
 b.className = 'demo-quick';
 b.style.cssText = 'background:#161616;border:1px solid rgba(212,175,55,.3);color:var(--gold);padding:6px 12px;border-radius:16px;cursor:pointer;font-size:12px;margin-right:6px';
 b.onclick = () => { document.querySelectorAll('.demo-quick').forEach(x=>x.remove()); sendDemo(q.message); };
 el.appendChild(b);
 });
}
function addDemoMsg(role, text) {
 const el = document.getElementById('demoMessages');
 const d = document.createElement('div');
 d.style.cssText = role === 'user'
 ? 'align-self:flex-end;background:linear-gradient(135deg,#2a2205,#1a1503);color:#f5e9b8;border:1px solid rgba(212,175,55,.3);padding:10px 14px;border-radius:12px;max-width:85%;font-size:14px;white-space:pre-wrap'
 : 'align-self:flex-start;background:#161616;border:1px solid #222;color:#e8e8e8;padding:10px 14px;border-radius:12px;max-width:85%;font-size:14px;white-space:pre-wrap';
 d.textContent = text;
 el.appendChild(d);
 el.scrollTop = el.scrollHeight;
 return d;
}
async function sendDemo(text) {
 if (!text) return;
 addDemoMsg('user', text);
 const typing = addDemoMsg('assistant', '···');
 typing.style.opacity = '.5';
 try {
 const r = await fetch('/api/chat', {
 method: 'POST',
 headers: { 'Content-Type': 'application/json' },
 body: JSON.stringify({ message: text, demo: true, history: demoHistory })
 });
 const data = await r.json();
 typing.remove();
 if (data.error) addDemoMsg('assistant', 'Error: ' + data.error);
 else {
 demoHistory = data.history;
 addDemoMsg('assistant', data.reply);
 }
 } catch (err) {
 typing.remove();
 addDemoMsg('assistant', 'Error de conexión');
 }
}
document.addEventListener('DOMContentLoaded', () => {
 if (typeof lucide !== 'undefined') lucide.createIcons();
 const form = document.getElementById('demoForm');
 if (form) form.onsubmit = (e) => {
 e.preventDefault();
 const inp = document.getElementById('demoInput');
 const t = inp.value.trim(); inp.value = '';
 sendDemo(t);
 };
});

let dashInterval;
function loadDashboard() {
 const fetchData = () => fetch('/api/dashboard', { headers: { 'x-admin-password': password } })
 .then(r => r.json()).then(renderDashboard);
 fetchData();
 clearInterval(dashInterval);
 dashInterval = setInterval(fetchData, 5000);
}

function renderDashboard(d) {
 const sat = d.ratings.satisfaction;
 const satColor = sat === null ? '#888' : sat >= 70 ? '#4ade80' : sat >= 40 ? '#fbbf24' : '#ef4444';
 document.getElementById('metrics').innerHTML = `
 <div class="metric"><div class="v">${d.convsToday}</div><div class="l">${t('metric_today')}</div></div>
 <div class="metric"><div class="v">${d.convsWeek}</div><div class="l">${t('metric_week')}</div></div>
 <div class="metric"><div class="v">${d.totalConvs}</div><div class="l">${t('metric_total')}</div></div>
 <div class="metric"><div class="v">${d.userMsgs}</div><div class="l">${t('metric_msgs')}</div></div>
 <div class="metric"><div class="v" style="color:${satColor}">${sat===null?'—':sat+'%'}</div><div class="l">${t('metric_satisfaction')}</div></div>
 <div class="metric"><div class="v"> ${d.ratings.up} · ${d.ratings.down}</div><div class="l">${t('metric_ratings')}</div></div>
 <div class="metric"><div class="v" style="color:${d.unresolved?'#ef4444':'#4ade80'}">${d.unresolved}</div><div class="l">${t('metric_unresolved')}</div></div>
 ${(d.byChannel||[]).map(ch => `<div class="metric"><div class="v">${ch.c}</div><div class="l">${ch.ch==='whatsapp'?'WhatsApp':'Web'}</div></div>`).join('')}
 `;

 const ul = document.getElementById('unresolvedList');
 ul.innerHTML = d.unresolvedList.length
 ? d.unresolvedList.map(c => `
 <div class="faq-item">
 <button onclick="resolveConv('${c.id}')" style="background:#0a2a0a;color:#4ade80;border:1px solid #1a4a1a">Marcar resuelto</button>
 <div style="color:#ccc;margin-bottom:6px"><b>Última pregunta:</b> ${(c.last_user_msg||'').replace(/</g,'&lt;').slice(0,200)}</div>
 <div style="color:#666;font-size:11px">${new Date(c.created_at).toLocaleString()} · ${c.visitor_id}</div>
 <a href="#" onclick="viewConv('${c.id}');return false" style="color:var(--gold);font-size:12px">Ver conversación →</a>
 </div>`).join('')
 : '<p style="color:#4ade80"> Todas las consultas atendidas</p>';

 const max = Math.max(1, ...d.topQuestions.map(q => q.count));
 document.getElementById('topQuestions').innerHTML = d.topQuestions.length
 ? d.topQuestions.map(q => `
 <div class="bar-row">
 <div class="label">${q.q.replace(/</g,'&lt;').slice(0,80)}</div>
 <div class="bar" style="width:${(q.count/max)*200}px"></div>
 <div class="count">${q.count}</div>
 </div>`).join('')
 : '<p style="color:#666">Aún no hay datos.</p>';

 const maxA = Math.max(1, ...d.activity.map(a => a.c));
 document.getElementById('activityChart').innerHTML = d.activity.length
 ? d.activity.map(a => `
 <div class="bar-row">
 <div class="label" style="flex:0 0 100px">${a.day}</div>
 <div class="bar" style="width:${(a.c/maxA)*300}px"></div>
 <div class="count">${a.c}</div>
 </div>`).join('')
 : '<p style="color:#666">Sin actividad aún.</p>';
}

function resolveConv(id) {
 fetch('/api/conversations/'+id+'/resolve', { method:'POST', headers: { 'x-admin-password': password } })
 .then(() => { loadDashboard(); toast('Marcado como resuelto'); });
}

function viewConv(id) {
 document.querySelectorAll('.nav-item').forEach(b => b.classList.remove('active'));
 document.querySelector('.nav-item[data-tab="convs"]')?.classList.add('active');
 document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
 document.getElementById('tab-convs').classList.add('active');
 loadConvs(); loadMessages(id);
}

function loadDocs() {
 fetch('/api/docs', { headers: { 'x-admin-password': password } })
 .then(r => r.json()).then(docs => {
 const el = document.getElementById('docList');
 if (!docs.length) { el.innerHTML = '<p style="color:#666">Aún no hay documentos.</p>'; return; }
 el.innerHTML = docs.map(d => `
 <div class="faq-item">
 <button onclick="deleteDoc(${d.id})">Eliminar</button>
 <div style="font-weight:600;color:var(--gold)">${d.title}</div>
 <div style="color:#888;font-size:12px;margin-top:4px">
 ${d.source.toUpperCase()} · ${d.chunks} fragmentos · ${new Date(d.created_at).toLocaleString()}
 </div>
 </div>`).join('');
 });
}

function deleteDoc(id) {
 if (!confirm('¿Eliminar este documento?')) return;
 fetch('/api/docs/'+id, { method: 'DELETE', headers: { 'x-admin-password': password } })
 .then(() => { loadDocs(); toast('Eliminado'); });
}

function uploadText() {
 const title = document.getElementById('txtTitle').value.trim();
 const content = document.getElementById('txtContent').value.trim();
 if (!title || !content) return toast('Falta título o contenido');
 fetch('/api/docs/text', {
 method: 'POST',
 headers: { 'Content-Type': 'application/json', 'x-admin-password': password },
 body: JSON.stringify({ title, content })
 }).then(r => r.json()).then(() => {
 document.getElementById('txtTitle').value = '';
 document.getElementById('txtContent').value = '';
 toast('Texto añadido '); loadDocs();
 });
}

function scrapeUrl() {
 const url = document.getElementById('urlSrc').value.trim();
 if (!url) return toast('Ingresa una URL');
 const title = document.getElementById('urlTitle').value.trim();
 const btn = document.getElementById('btnScrape');
 btn.textContent = 'Extrayendo...'; btn.disabled = true;
 fetch('/api/docs/url', {
  method: 'POST',
  headers: { 'Content-Type': 'application/json', 'x-admin-password': password },
  body: JSON.stringify({ url, title })
 }).then(r => r.json()).then(d => {
  btn.textContent = 'Extraer contenido'; btn.disabled = false;
  if (d.error) return toast('Error: ' + d.error);
  document.getElementById('urlSrc').value = '';
  document.getElementById('urlTitle').value = '';
  toast(`Listo: "${d.title}" — ${d.chunks} fragmentos`);
  loadDocs();
 }).catch(e => { btn.textContent = 'Extraer contenido'; btn.disabled = false; toast('Error: ' + e.message); });
}

function uploadPdf() {
 const file = document.getElementById('pdfFile').files[0];
 if (!file) return toast('Selecciona un PDF');
 const fd = new FormData();
 fd.append('file', file);
 fd.append('title', document.getElementById('pdfTitle').value || file.name);
 toast('Procesando PDF...');
 fetch('/api/docs/pdf', { method: 'POST', headers: { 'x-admin-password': password }, body: fd })
 .then(r => r.json()).then(d => {
 if (d.error) return toast('Error: '+d.error);
 document.getElementById('pdfTitle').value = '';
 document.getElementById('pdfFile').value = '';
 toast(`PDF procesado: ${d.chunks} fragmentos `); loadDocs();
 });
}

let _allLeads = [];
function loadLeads() {
 fetch('/api/leads', { headers: { 'x-admin-password': password } })
 .then(r => r.json()).then(rows => {
  _allLeads = rows;
  renderLeads(rows);
 });
}
function filterLeads() {
 const q = (document.getElementById('leadSearch').value || '').toLowerCase();
 renderLeads(q ? _allLeads.filter(l =>
  (l.lead_name||'').toLowerCase().includes(q) ||
  (l.lead_email||'').toLowerCase().includes(q) ||
  (l.lead_phone||'').toLowerCase().includes(q)
 ) : _allLeads);
}
function renderLeads(rows) {
 const el = document.getElementById('leadList');
 if (!rows.length) { el.innerHTML = '<p style="color:#666;font-size:13px">No hay leads aun. Cuando alguien comparta su nombre, email o telefono en el chat aparecera aqui.</p>'; return; }
 el.innerHTML = `<div style="overflow-x:auto"><table style="width:100%;border-collapse:collapse;font-size:13px">
  <thead><tr style="border-bottom:1px solid var(--border);color:var(--muted)">
   <th style="text-align:left;padding:8px 6px">${t('th_name')}</th>
   <th style="text-align:left;padding:8px 6px">${t('th_email')}</th>
   <th style="text-align:left;padding:8px 6px">${t('th_phone')}</th>
   <th style="text-align:left;padding:8px 6px">${t('th_channel')}</th>
   <th style="text-align:left;padding:8px 6px">${t('th_first_query')}</th>
   <th style="text-align:left;padding:8px 6px">${t('th_date')}</th>
   <th style="padding:8px 6px"></th>
  </tr></thead><tbody>
  ${rows.map(l => `<tr style="border-bottom:1px solid #1a1f2a" data-id="${l.id}">
   <td style="padding:8px 6px">${l.lead_name || '<span style="color:#555">—</span>'}</td>
   <td style="padding:8px 6px">${l.lead_email ? `<a href="mailto:${l.lead_email}" style="color:var(--gold)">${l.lead_email}</a>` : '<span style="color:#555">—</span>'}</td>
   <td style="padding:8px 6px">${l.lead_phone || '<span style="color:#555">—</span>'}</td>
   <td style="padding:8px 6px;color:#888">${l.channel === 'whatsapp' ? 'WhatsApp' : l.channel === 'instagram' ? 'Instagram' : 'Web'}</td>
   <td style="padding:8px 6px;color:#aaa;max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${(l.first_msg||'').slice(0,60)}</td>
   <td style="padding:8px 6px;color:#666;white-space:nowrap">${new Date(l.updated_at).toLocaleDateString()}</td>
   <td style="padding:8px 6px"><button class="secondary" onclick="deleteLead('${l.id}')" style="font-size:11px;padding:4px 10px;text-transform:none;letter-spacing:0;border-color:#e55;color:#e55">Borrar</button></td>
  </tr>`).join('')}
  </tbody></table></div>`;
}
function deleteLead(id) {
 if (!confirm('Borrar este lead? Se eliminan los datos de contacto pero se conserva la conversacion.')) return;
 fetch('/api/leads/' + id, { method: 'DELETE', headers: { 'x-admin-password': password } })
 .then(r => r.json()).then(d => {
  if (d.error) return toast('Error: ' + d.error);
  toast('Lead borrado');
  loadLeads();
 });
}

let activeConvId = null;
let activeHumanMode = 0;

function loadConvs() {
 fetch('/api/conversations', { headers: { 'x-admin-password': password } })
 .then(r => r.json()).then(rows => {
 const el = document.getElementById('convList');
 el.innerHTML = rows.length ? '' : '<p style="color:#666">Aún no hay conversaciones.</p>';
 rows.forEach(c => {
 const d = document.createElement('div');
 d.className = 'conv';
 const ch = c.channel || 'web';
 const chLabel = ch === 'whatsapp' ? 'WA' : ch === 'instagram' ? 'IG' : 'Web';
 const color = ch === 'whatsapp' ? '#25D366' : ch === 'instagram' ? '#fd1d1d' : 'var(--gold)';
 const humanTag = c.human_mode ? ' <span style="background:#e55;color:#fff;font-size:10px;padding:2px 6px;border-radius:10px">HUMANO</span>' : '';
 const attnTag = c.needs_attention ? ' <span style="background:#f97316;color:#fff;font-size:10px;padding:2px 6px;border-radius:10px">ATENCIÓN</span>' : '';
 const fuLevel = c.followup_level > 0 && !c.followup_paused ? ` <span style="background:#1e293b;color:#94a3b8;font-size:10px;padding:2px 6px;border-radius:10px">FU-L${c.followup_level}</span>` : '';
 const fuPaused = c.followup_paused && !c.human_mode && !c.needs_attention ? ' <span style="background:#333;color:#666;font-size:10px;padding:2px 6px;border-radius:10px">⏸</span>' : '';
 d.innerHTML = `<span style="color:${color};font-weight:600;margin-right:8px">${chLabel}</span>${new Date(c.updated_at).toLocaleString()} — ${c.visitor_id}${attnTag}${humanTag}${fuLevel}${fuPaused}`;
 d.onclick = () => loadMessages(c.id);
 el.appendChild(d);
 });
 });
}

function waTest() {
 const phone = document.getElementById('waTestPhone').value.trim();
 const text = document.getElementById('waTestMsg').value.trim() || 'Test ';
 if (!phone) return toast('Falta número');
 fetch('/api/whatsapp/test', {
 method: 'POST',
 headers: { 'Content-Type': 'application/json', 'x-admin-password': password },
 body: JSON.stringify({ phone, text })
 }).then(() => toast('Enviado (revisa el WhatsApp)'));
}

let _waQrTimer = null, _waCountdownTimer = null;

function _clearWaTimers() {
 clearTimeout(_waQrTimer); clearInterval(_waCountdownTimer);
 _waQrTimer = null; _waCountdownTimer = null;
 document.getElementById('builtinCountdown').style.display = 'none';
}

function _startQrCountdown() {
 const cd = document.getElementById('builtinCountdown');
 cd.style.display = 'block';
 let secs = 25;
 cd.textContent = 'Se renueva en ' + secs + 's';
 _waCountdownTimer = setInterval(() => {
  secs--;
  if (secs <= 0) { clearInterval(_waCountdownTimer); }
  else cd.textContent = 'Se renueva en ' + secs + 's';
 }, 1000);
 // Auto-refresh before it expires
 _waQrTimer = setTimeout(() => { loadBuiltinQr(true); }, 22000);
}

function saveMetaApp() {
 const partial = {
  metaAppId: (document.getElementById('metaAppId')||{}).value||'',
  metaAppSecret: (document.getElementById('metaAppSecret')||{}).value||''
 };
 api('/api/config', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ ...config, ...partial }) })
 .then(d => {
  if (d.error) return toast('Error: ' + d.error);
  Object.assign(config, partial);
  toast('App guardada — ahora presiona Conectar con Instagram');
 });
}

function connectInstagram() {
 const popup = window.open(`/api/instagram/connect?adminPassword=${encodeURIComponent(password)}&companyId=${encodeURIComponent(activeCompanyId)}`, 'ig_oauth', 'width=600,height=700');
 window.addEventListener('message', function handler(e) {
  if (!e.data?.igOk) return;
  window.removeEventListener('message', handler);
  // Reload config from server so igAccessToken is properly loaded into config object
  api('/api/config').then(fresh => {
    Object.assign(config, fresh);
    document.getElementById('igConnectedUser').textContent = '@' + (fresh.igUsername || e.data.igUsername || '');
    document.getElementById('igConnected').style.display = 'block';
    document.getElementById('igNotConnected').style.display = 'none';
    toast('Instagram conectado como @' + (fresh.igUsername || e.data.igUsername));
   });
 });
}

function disconnectInstagram() {
 if (!confirm('¿Desconectar Instagram?')) return;
 const partial = { igAccessToken:'', igPageId:'', igUsername:'' };
 api('/api/config', {
  method: 'POST',
  headers: { 'Content-Type': 'application/json' },
  body: JSON.stringify({ ...config, ...partial })
 }).then(d => {
  if (d.error) return toast('Error: ' + d.error);
  Object.assign(config, partial);
  document.getElementById('igConnected').style.display = 'none';
  document.getElementById('igNotConnected').style.display = 'block';
  toast('Instagram desconectado');
 });
}

function loadBuiltinQr(silent) {
 _clearWaTimers();
 const btn = document.getElementById('btnBuiltinQr');
 const statusEl = document.getElementById('builtinStatus');
 const img = document.getElementById('builtinQrImg');
 if (!silent) { btn.textContent = 'Generando...'; btn.disabled = true; statusEl.textContent = 'Conectando...'; statusEl.style.color = '#888'; }
 fetch('/api/whatsapp/builtin/qr', { headers: { 'x-admin-password': password } })
 .then(r => r.json())
 .then(d => {
  btn.textContent = 'Generar QR'; btn.disabled = false;
  if (d.status === 'qr') {
   img.src = d.qr; img.style.display = 'block';
   statusEl.textContent = 'WhatsApp → Configuracion → Dispositivos vinculados → Vincular dispositivo';
   statusEl.style.color = 'var(--gold)';
   document.getElementById('btnDisconnect').style.display = 'none';
   _startQrCountdown();
  } else if (d.status === 'open') {
   _clearWaTimers();
   img.style.display = 'none';
   statusEl.textContent = 'Conectado' + (d.phone ? ' · ' + d.phone : '');
   statusEl.style.color = '#25D366';
   document.getElementById('btnDisconnect').style.display = 'inline-block';
  } else {
   statusEl.textContent = d.message || (d.status === 'connecting' ? 'Tardando más de lo esperado. Haz clic de nuevo.' : 'No se pudo obtener el QR. Intenta de nuevo.');
   statusEl.style.color = '#e55';
  }
 })
 .catch(e => { btn.textContent = 'Generar QR'; btn.disabled = false; statusEl.textContent = 'Error: ' + e.message; statusEl.style.color = '#e55'; });
}

function checkBuiltinStatus() {
 fetch('/api/whatsapp/builtin/status', { headers: { 'x-admin-password': password } })
 .then(r => r.json())
 .then(d => {
  const statusEl = document.getElementById('builtinStatus');
  const labels = { open: 'Conectado', disconnected: 'Desconectado', qr: 'Esperando escaneo', connecting: 'Conectando...', waiting: 'Sin iniciar', logged_out: 'Sesion cerrada' };
  const colors = { open: '#25D366', disconnected: '#e55', qr: 'var(--gold)', connecting: '#f0a500', waiting: '#888', logged_out: '#e55' };
  statusEl.textContent = (labels[d.status] || d.status) + (d.phone ? ' · ' + d.phone : '');
  statusEl.style.color = colors[d.status] || '#aaa';
  document.getElementById('btnDisconnect').style.display = d.status === 'open' ? 'inline-block' : 'none';
  if (d.status !== 'qr') { document.getElementById('builtinQrImg').style.display = 'none'; _clearWaTimers(); }
 });
}

function disconnectBuiltin() {
 if (!confirm('Desconectar WhatsApp? Tendras que escanear el QR de nuevo.')) return;
 _clearWaTimers();
 fetch('/api/whatsapp/builtin/disconnect', { method: 'POST', headers: { 'x-admin-password': password } })
 .then(() => { document.getElementById('builtinQrImg').style.display = 'none'; checkBuiltinStatus(); toast('WhatsApp desconectado'); });
}

function genContactQr() {
 const phone = (document.getElementById('waContactPhone').value || '').replace(/\D/g, '');
 if (!phone) return toast('Ingresa el número de WhatsApp');
 const msg = (document.getElementById('waContactMsg').value || '').trim();
 const params = new URLSearchParams({ phone });
 if (msg) params.set('msg', msg);
 fetch('/api/whatsapp/contact-qr?' + params.toString(), { headers: { 'x-admin-password': password } })
  .then(r => r.json())
  .then(d => {
   if (d.error) return toast('Error: ' + d.error);
   document.getElementById('waContactCanvas').src = d.dataUrl;
   document.getElementById('waContactQrUrl').textContent = d.waUrl;
   document.getElementById('waContactQrWrap').style.display = 'flex';
  })
  .catch(e => toast('Error: ' + e.message));
}

function clearContactQr() {
 document.getElementById('waContactQrWrap').style.display = 'none';
}

function downloadContactQr() {
 const img = document.getElementById('waContactCanvas');
 if (!img.src || img.src === window.location.href) return toast('Genera el QR primero');
 const phone = (document.getElementById('waContactPhone').value || '').replace(/\D/g, '') || 'whatsapp';
 const a = document.createElement('a');
 a.download = 'qr-whatsapp-' + phone + '.png';
 a.href = img.src;
 a.click();
}

function copyContactUrl() {
 const url = document.getElementById('waContactQrUrl').textContent;
 if (!url) return toast('Genera el QR primero');
 navigator.clipboard.writeText(url).then(() => toast('Enlace copiado'));
}

function getWaCreds() {
 return {
  waBaseUrl: (document.getElementById('waBaseUrl')||{}).value || '',
  waInstance: (document.getElementById('waInstance')||{}).value || '',
  waApiKey: (document.getElementById('waApiKey')||{}).value || ''
 };
}

function loadWaQr() {
 const creds = getWaCreds();
 if (!creds.waBaseUrl || !creds.waInstance || !creds.waApiKey)
  return toast('Completa Base URL, Instance Name y API Key primero');
 const btn = document.getElementById('btnGenQr');
 const wrap = document.getElementById('waQrWrap');
 btn.textContent = 'Cargando...';
 btn.disabled = true;
 fetch('/api/whatsapp/qr', {
  method: 'POST',
  headers: { 'Content-Type': 'application/json', 'x-admin-password': password },
  body: JSON.stringify(creds)
 })
 .then(r => r.json())
 .then(d => {
  btn.textContent = 'Generar QR'; btn.disabled = false;
  if (d.error) return toast('Error: ' + d.error);
  if (d.state === 'open') {
   wrap.style.display = 'none';
   showWaStatus('open');
   return toast('WhatsApp ya esta conectado');
  }
  if (!d.qr) return toast('No se pudo obtener el QR. Verifica que la instancia exista en Evolution.');
  document.getElementById('waQrImg').src = d.qr;
  wrap.style.display = 'flex';
  if (d.state) showWaStatus(d.state);
 })
 .catch(e => { btn.textContent = 'Generar QR'; btn.disabled = false; toast('Error: ' + e.message); });
}

function checkWaStatus() {
 const creds = getWaCreds();
 fetch('/api/whatsapp/status', {
  method: 'POST',
  headers: { 'Content-Type': 'application/json', 'x-admin-password': password },
  body: JSON.stringify(creds)
 })
 .then(r => r.json())
 .then(d => {
  if (d.error) return toast('Error: ' + d.error);
  showWaStatus(d.state);
  if (d.state === 'open') {
   document.getElementById('waQrWrap').style.display = 'none';
   toast('Conectado');
  }
 }).catch(e => toast('Error: ' + e.message));
}

function showWaStatus(state) {
 const badge = document.getElementById('waStatusBadge');
 const labels = { open: 'Conectado', close: 'Desconectado', connecting: 'Conectando...', unknown: 'Desconocido' };
 const colors = { open: '#25D366', close: '#e55', connecting: '#f0a500', unknown: '#888' };
 badge.textContent = labels[state] || state;
 badge.style.color = colors[state] || '#aaa';
 badge.style.borderColor = colors[state] || '#333';
 badge.style.display = 'inline-block';
}

function downloadWaQr() {
 const img = document.getElementById('waQrImg');
 if (!img.src || img.src === window.location.href) return toast('Genera el QR primero');
 const a = document.createElement('a');
 a.href = img.src;
 a.download = 'whatsapp-qr.png';
 a.click();
}

function loadMessages(id) {
 activeConvId = id;
 fetch('/api/conversations/'+id, { headers: { 'x-admin-password': password } })
 .then(r => r.json()).then(data => {
 const { conv, msgs } = data;
 activeHumanMode = conv.human_mode || 0;
 document.getElementById('convDetail').style.display = 'block';
 document.getElementById('convDetailTitle').textContent = (conv.channel || 'web').toUpperCase() + ' — ' + conv.visitor_id;
 document.getElementById('humanBadge').style.display = activeHumanMode ? 'inline-block' : 'none';
 document.getElementById('attnBadge').style.display = conv.needs_attention ? 'inline-block' : 'none';
 const fuB = document.getElementById('fuBadge');
 if (conv.followup_level > 0 && !conv.followup_paused) { fuB.textContent = 'Follow-up L'+conv.followup_level; fuB.style.display='inline-block'; } else fuB.style.display='none';
 document.getElementById('btnTakeover').style.display = activeHumanMode ? 'none' : 'inline-block';
 document.getElementById('btnReturnAI').style.display = activeHumanMode ? 'inline-block' : 'none';
 document.getElementById('btnFuPause').style.display = (!conv.followup_paused && conv.channel !== 'web') ? 'inline-block' : 'none';
 document.getElementById('btnFuResume').style.display = (conv.followup_paused && conv.channel !== 'web') ? 'inline-block' : 'none';
 document.getElementById('btnAttnClear').style.display = conv.needs_attention ? 'inline-block' : 'none';
 const log = document.getElementById('msgLog');
 log.innerHTML = msgs.map(m =>
  `<div class="${m.role==='user'?'u':'a'}"><b>${m.role==='user'?'Cliente':'Agente'}:</b> ${m.content.replace(/</g,'&lt;')}</div>`
 ).join('<hr style="border-color:#222">');
 log.scrollTop = log.scrollHeight;
 });
}

function toggleHumanMode(mode) {
 if (!activeConvId) return;
 fetch('/api/conversations/'+activeConvId+'/human-mode', {
  method: 'POST',
  headers: { 'Content-Type': 'application/json', 'x-admin-password': password },
  body: JSON.stringify({ mode })
 }).then(r => r.json()).then(() => {
  activeHumanMode = mode;
  document.getElementById('humanBadge').style.display = mode ? 'inline-block' : 'none';
  document.getElementById('btnTakeover').style.display = mode ? 'none' : 'inline-block';
  document.getElementById('btnReturnAI').style.display = mode ? 'inline-block' : 'none';
  toast(mode ? 'IA pausada — modo humano activo' : 'IA reactivada');
  loadConvs();
 });
}

function sendAdminReply() {
 const input = document.getElementById('adminReplyInput');
 const text = input.value.trim();
 if (!text || !activeConvId) return;
 // Special commands
 if (text === '/') { input.value = ''; return toggleHumanMode(1); }
 if (text === '//') { input.value = ''; return toggleHumanMode(0); }
 input.value = '';
 fetch('/api/conversations/'+activeConvId+'/reply', {
  method: 'POST',
  headers: { 'Content-Type': 'application/json', 'x-admin-password': password },
  body: JSON.stringify({ text })
 }).then(() => { loadMessages(activeConvId); toast('Enviado'); });
}

function copyEmbed() {
 const el = document.getElementById('embedCode');
 el.select(); document.execCommand('copy');
 toast('Copiado ');
}


function followupPause() {
 if (!activeConvId) return;
 fetch('/api/conversations/'+activeConvId+'/followup-pause', { method:'POST', headers:{'x-admin-password':password} })
 .then(()=>{ toast('Follow-up pausado'); loadMessages(activeConvId); loadConvs(); });
}
function followupResume() {
 if (!activeConvId) return;
 fetch('/api/conversations/'+activeConvId+'/followup-resume', { method:'POST', headers:{'x-admin-password':password} })
 .then(()=>{ toast('Follow-up reactivado desde L0'); loadMessages(activeConvId); loadConvs(); });
}
function attentionClear() {
 if (!activeConvId) return;
 fetch('/api/conversations/'+activeConvId+'/attention-clear', { method:'POST', headers:{'x-admin-password':password} })
 .then(()=>{ toast('Marcado como resuelto'); loadMessages(activeConvId); loadConvs(); if(document.querySelector('.nav-item[data-tab="followup"]').classList.contains('active')) loadFollowUp(); });
}
function saveFollowupToggle(enabled) {
 const partial = { followupEnabled: enabled };
 fetch('/api/config', { method:'POST', headers:{'Content-Type':'application/json','x-admin-password':password}, body:JSON.stringify(partial) })
 .then(()=>toast(enabled ? 'Follow-up activado' : 'Follow-up desactivado'));
}
let _fuFilter = 'all';
function loadFollowUp(filter) {
 if (filter) _fuFilter = filter;
 ['all','attention','active','paused'].forEach(f => {
  const b = document.getElementById('fu-filter-'+f);
  if (b) b.style.background = (f === _fuFilter) ? 'var(--gold)' : '';
  if (b) b.style.color = (f === _fuFilter) ? '#000' : '';
 });
 const fuEnabled = config.followupEnabled !== false;
 document.getElementById('followupEnabled').checked = fuEnabled;
 fetch('/api/conversations', { headers:{'x-admin-password':password} })
 .then(r=>r.json()).then(rows => {
  const eligible = rows.filter(c => c.channel !== 'web');
  let active = 0, attention = 0, paused = 0;
  eligible.forEach(c => {
   if (c.needs_attention) attention++;
   else if (c.followup_paused) paused++;
   else active++;
  });
  document.getElementById('fu-stat-active').textContent = active;
  document.getElementById('fu-stat-attention').textContent = attention;
  document.getElementById('fu-stat-paused').textContent = paused;
  let filtered = eligible;
  if (_fuFilter === 'attention') filtered = eligible.filter(c => c.needs_attention);
  else if (_fuFilter === 'active') filtered = eligible.filter(c => !c.followup_paused && !c.needs_attention);
  else if (_fuFilter === 'paused') filtered = eligible.filter(c => c.followup_paused && !c.needs_attention);
  const el = document.getElementById('followupList');
  if (!filtered.length) { el.innerHTML = '<p style="color:#666;font-size:13px">No hay conversaciones en este filtro.</p>'; return; }
  const levelColors = { 0:'#4ade80', 1:'#facc15', 2:'#f97316', 3:'#ef4444' };
  el.innerHTML = filtered.map(c => {
   const ch = c.channel === 'whatsapp' ? 'WA' : 'IG';
   const chColor = c.channel === 'whatsapp' ? '#25D366' : '#fd1d1d';
   const since = c.last_lead_msg_at ? Math.round((Date.now()-c.last_lead_msg_at)/3600000) + 'h' : '—';
   const levelBadge = c.followup_paused
    ? '<span style="font-size:11px;background:#333;color:#666;padding:2px 8px;border-radius:10px">⏸ Pausado</span>'
    : c.needs_attention
    ? '<span style="font-size:11px;background:#7c2d12;color:#fb923c;padding:2px 8px;border-radius:10px">Atención</span>'
    : `<span style="font-size:11px;background:#1e293b;color:${levelColors[c.followup_level]||'#aaa'};padding:2px 8px;border-radius:10px">L${c.followup_level}</span>`;
   const actions = [];
   if (c.needs_attention) actions.push(`<button onclick="attentionClearById('${c.id}')" style="font-size:11px;padding:3px 10px;background:#14532d;color:#4ade80">✓ Resolver</button>`);
   if (!c.followup_paused) actions.push(`<button onclick="followupPauseById('${c.id}')" style="font-size:11px;padding:3px 10px;background:#1e3a5f;color:#94a3b8">⏸ Pausar</button>`);
   if (c.followup_paused) actions.push(`<button onclick="followupResumeById('${c.id}')" style="font-size:11px;padding:3px 10px;background:#14532d;color:#4ade80">▶ Reanudar</button>`);
   actions.push(`<button onclick="loadMessages('${c.id}');tab('convs')" style="font-size:11px;padding:3px 10px">Ver chat</button>`);
   return `<div style="display:flex;align-items:center;justify-content:space-between;padding:10px 0;border-bottom:1px solid var(--border);gap:10px;flex-wrap:wrap">
    <div style="display:flex;align-items:center;gap:10px;min-width:0">
     <span style="color:${chColor};font-weight:700;font-size:12px">${ch}</span>
     ${levelBadge}
     <span style="font-size:12px;color:#888;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${c.lead_name||c.visitor_id}</span>
     <span style="font-size:11px;color:#555">Último contacto: ${since}</span>
    </div>
    <div style="display:flex;gap:6px;flex-shrink:0">${actions.join('')}</div>
   </div>`;
  }).join('');
 });
}
function followupPauseById(id) {
 fetch('/api/conversations/'+id+'/followup-pause', {method:'POST',headers:{'x-admin-password':password}})
 .then(()=>{ toast('Pausado'); loadFollowUp(); });
}
function followupResumeById(id) {
 fetch('/api/conversations/'+id+'/followup-resume', {method:'POST',headers:{'x-admin-password':password}})
 .then(()=>{ toast('Reactivado'); loadFollowUp(); });
}
function attentionClearById(id) {
 fetch('/api/conversations/'+id+'/attention-clear', {method:'POST',headers:{'x-admin-password':password}})
 .then(()=>{ toast('Resuelto'); loadFollowUp(); });
}

function renderTriggers() {
 const list = document.getElementById('triggerList');
 if (!list) return;
 config.keywordTriggers = config.keywordTriggers || [];
 const triggers = config.keywordTriggers;
 if (!triggers.length) {
  list.innerHTML = '<p style="color:#555;font-size:13px;text-align:center;padding:20px 0">No hay activadores. Haz clic en “+ Nuevo activador” para crear uno.</p>';
  return;
 }
 list.innerHTML = '';
 triggers.forEach(function(t, i) {
  const div = document.createElement('div');
  div.className = 'faq-item';
  div.style.marginBottom = '14px';
  const kws = (t.keywords || []).join(', ');
  const mt = t.matchType || 'contains';
  const mtOpts = ['contains','word','exact'].map(function(v) {
   const labels = {contains:'contains — contiene la palabra', word:'word — palabra completa', exact:'exact — mensaje exacto'};
   return '<option value="' + v + '"' + (mt === v ? ' selected' : '') + '>' + labels[v] + '</option>';
  }).join('');
  div.innerHTML = '<button onclick="removeTrigger(' + i + ')" title="Eliminar">✕</button>' +
   '<div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:10px">' +
    '<div><label style="font-size:11px;color:#888;display:block;margin-bottom:4px">Etiqueta (solo para ti)</label>' +
    '<input value="' + (t.label||'').replace(/"/g,'&quot;') + '" placeholder="ej: Solicitud de info" data-ti="' + i + '" data-field="label"></div>' +
    '<div><label style="font-size:11px;color:#888;display:block;margin-bottom:4px">Tipo de coincidencia</label>' +
    '<select style="width:100%" data-ti="' + i + '" data-field="matchType">' + mtOpts + '</select></div>' +
   '</div>' +
   '<div style="margin-bottom:10px"><label style="font-size:11px;color:#888;display:block;margin-bottom:4px">Palabras clave <span style="color:#555">(separadas por comas)</span></label>' +
   '<input value="' + kws.replace(/"/g,'&quot;') + '" placeholder="info, precio, quiero saber" data-ti="' + i + '" data-field="keywords"></div>' +
   '<div><label style="font-size:11px;color:#888;display:block;margin-bottom:4px">Respuesta automática</label>' +
   '<textarea style="min-height:80px" placeholder="Escribe el mensaje que se enviará cuando el lead use esta palabra..." data-ti="' + i + '" data-field="response">' + (t.response||'') + '</textarea></div>' +
   '<div style="margin-top:10px;padding:8px 10px;background:#1a1a2a;border-radius:6px;display:flex;align-items:center;gap:8px">' +
   '<input type="checkbox" id="tfu_' + i + '" data-ti="' + i + '" data-field="followupEnabled"' + (t.followupEnabled ? ' checked' : '') + ' style="width:auto;margin:0">' +
   '<label for="tfu_' + i + '" style="font-size:12px;color:#aaa;margin:0;cursor:pointer">Enviar seguimiento 1 hora después preguntando si tomó acción</label></div>';
  div.querySelectorAll('[data-field]').forEach(function(el) {
   el.addEventListener('change', function() {
    const idx = parseInt(el.dataset.ti);
    const field = el.dataset.field;
    if (field === 'keywords') config.keywordTriggers[idx].keywords = el.value.split(',').map(function(k){return k.trim();}).filter(Boolean);
    else if (field === 'followupEnabled') config.keywordTriggers[idx].followupEnabled = el.checked;
    else config.keywordTriggers[idx][field] = el.value;
   });
  });
  list.appendChild(div);
 });
}
function addTrigger() {
 config.keywordTriggers = config.keywordTriggers || [];
 config.keywordTriggers.push({ label:'', keywords:[], matchType:'contains', response:'', caseSensitive:false, followupEnabled:false });
 renderTriggers();
}
function removeTrigger(i) {
 config.keywordTriggers.splice(i, 1);
 renderTriggers();
}
function saveTriggers() { save(); }

function toast(msg) {
 const t = document.getElementById('toast');
 t.textContent = msg; t.classList.add('show');
 setTimeout(() => t.classList.remove('show'), 2000);
}

// ── USERS ──────────────────────────────────────────────────────
function loadUsers() {
 // Render company checkboxes for the "create user" form
 const companiesDiv = document.getElementById('newUserCompanies');
 if (companiesDiv) {
  companiesDiv.innerHTML = companies.map(c =>
   `<label style="display:flex;align-items:center;gap:6px;background:var(--input-bg);border:1px solid var(--border);padding:6px 12px;border-radius:20px;cursor:pointer;font-size:12px;text-transform:none;letter-spacing:0;color:var(--text)">
    <input type="checkbox" class="new-user-company" value="${c.id}" style="width:auto;margin:0"> ${c.name}
   </label>`
  ).join('');
 }
 api('/api/users').then(users => {
  const el = document.getElementById('usersList');
  if (!users.length) { el.innerHTML = '<p style="color:var(--muted);font-size:13px">No hay usuarios aún. Crea uno arriba.</p>'; return; }
  el.innerHTML = users.map(u => `
   <div class="faq-item" style="padding-right:160px">
    <div style="display:flex;gap:6px;position:absolute;top:10px;right:10px;flex-wrap:wrap;justify-content:flex-end;max-width:155px">
     <button onclick="resetUserPassword('${u.id}','${u.email}')" style="background:var(--card);color:var(--muted);border:1px solid var(--border);font-size:11px;text-transform:none;letter-spacing:0">Nueva clave</button>
     <button onclick="toggleUser('${u.id}',${u.active})" style="background:${u.active?'#2a2a0a':'#0a2a0a'};color:${u.active?'#fbbf24':'#4ade80'};border:1px solid var(--border);font-size:11px;text-transform:none;letter-spacing:0">${u.active?'Desactivar':'Activar'}</button>
     <button onclick="deleteUser('${u.id}','${u.email}')" style="font-size:11px">Eliminar</button>
    </div>
    <div style="font-weight:600;color:var(--text);font-size:14px;margin-bottom:6px">${u.email}</div>
    <div style="color:var(--muted);font-size:12px;margin-bottom:10px">
     ${u.active?'<span style="color:#4ade80"> Activo</span>':'<span style="color:#fbbf24"> Inactivo</span>'}
     · Creado ${new Date(u.created_at).toLocaleDateString()}
    </div>
    <div style="font-size:11px;color:var(--muted);margin-bottom:8px;text-transform:uppercase;letter-spacing:1px">Empresas asignadas</div>
    <div style="display:flex;flex-wrap:wrap;gap:6px">
     ${companies.map(c => {
      const assigned = u.company_ids.includes(c.id);
      return `<label style="display:flex;align-items:center;gap:5px;background:${assigned?'rgba(39,245,155,.08)':'var(--input-bg)'};border:1px solid ${assigned?'var(--gold)':'var(--border)'};padding:4px 10px;border-radius:16px;cursor:pointer;font-size:11px;text-transform:none;letter-spacing:0;color:${assigned?'var(--gold)':'var(--muted)'}">
       <input type="checkbox" data-company-id="${c.id}" ${assigned?'checked':''} style="width:auto;margin:0" onchange="updateUserCompanies('${u.id}', this)"> ${c.name}
      </label>`;
     }).join('')}
    </div>
   </div>`).join('');
 }).catch(() => toast('Error cargando usuarios'));
}

function createUser() {
 const email = document.getElementById('newUserEmail').value.trim();
 const password = document.getElementById('newUserPassword').value;
 const company_ids = [...document.querySelectorAll('.new-user-company:checked')].map(cb => cb.value);
 if (!email || !password) return toast('Completa email y contraseña');
 if (password.length < 8) return toast('La contraseña debe tener al menos 8 caracteres');
 api('/api/users', {
  method: 'POST',
  headers: { 'Content-Type': 'application/json' },
  body: JSON.stringify({ email, password, company_ids })
 }).then(d => {
  if (d.error) return toast('Error: ' + d.error);
  toast('Usuario creado');
  document.getElementById('newUserEmail').value = '';
  document.getElementById('newUserPassword').value = '';
  document.querySelectorAll('.new-user-company').forEach(cb => cb.checked = false);
  loadUsers();
 });
}

function toggleUser(id, active) {
 api(`/api/users/${id}`, { method: 'PATCH', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ active: !active }) })
 .then(() => loadUsers());
}

function deleteUser(id, email) {
 if (!confirm(`¿Eliminar usuario "${email}"? Esta acción no se puede deshacer.`)) return;
 api(`/api/users/${id}`, { method: 'DELETE' }).then(d => {
  if (d.error) return toast('Error: ' + d.error);
  toast('Usuario eliminado');
  loadUsers();
 });
}

function resetUserPassword(id, email) {
 const pw = prompt(`Nueva contraseña para ${email}:`);
 if (!pw) return;
 if (pw.length < 8) return toast('Mínimo 8 caracteres');
 api(`/api/users/${id}`, { method: 'PATCH', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ password: pw }) })
 .then(d => {
  if (d.error) return toast('Error: ' + d.error);
  toast('Contraseña actualizada');
 });
}

function updateUserCompanies(userId, checkbox) {
 const row = checkbox.closest('.faq-item');
 const ids = [...row.querySelectorAll('input[data-company-id]:checked')].map(cb => cb.getAttribute('data-company-id'));
 api(`/api/users/${userId}`, { method: 'PATCH', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ company_ids: ids }) })
 .then(d => { if (d.error) toast('Error: ' + d.error); else loadUsers(); });
}

// ── Campanas & Citas ─────────────────────────────────────────────────────────
const CAMP_IDS = ['ext_maint','keratin','inactive','birthday','review','winback','post_consult'];
const CITA_IDS = ['confirm','reminder_24h','reminder_2h','cancel','reschedule'];

function loadCampanas() {
  api('/api/config').then(cfg => {
    const camps = cfg.campaigns || {};
    CAMP_IDS.forEach(id => {
      const c = camps[id] || {};
      const el = document.getElementById('camp-' + id + '-enabled');
      if (el) { el.checked = !!c.enabled; syncCampCard(id); }
      if (c.channel) setCampChannelById(id, c.channel);
      const delayEl = document.getElementById('camp-' + id + '-delay');
      if (delayEl && c.delay != null) delayEl.value = c.delay;
      const msgEl = document.getElementById('camp-' + id + '-msg');
      if (msgEl && c.message) msgEl.value = c.message;
      if (id === 'birthday') {
        const t = document.getElementById('camp-birthday-time');
        if (t && c.send_time) t.value = c.send_time;
        const d = document.getElementById('camp-birthday-discount');
        if (d && c.discount != null) d.value = c.discount;
      }
      if (id === 'review') { const l = document.getElementById('camp-review-link'); if (l && c.review_link) l.value = c.review_link; }
      if (id === 'winback') { const d = document.getElementById('camp-winback-discount'); if (d && c.discount != null) d.value = c.discount; }
    });
    updateCampStat();
  }).catch(() => {});
}
function syncCampCard(id) {
  const card = document.getElementById('camp-card-' + id);
  if (!card) return;
  card.classList.toggle('camp-on', !!document.getElementById('camp-' + id + '-enabled')?.checked);
}
function toggleCampOpen(id) { document.getElementById('camp-card-' + id)?.classList.toggle('camp-open'); }
function setCampChannel(id, ch, btn) {
  const parent = btn.closest('.camp-channels');
  if (parent) parent.querySelectorAll('.camp-ch').forEach(b => b.classList.remove('camp-ch-on'));
  btn.classList.add('camp-ch-on');
  const hid = document.getElementById('camp-' + id + '-channel');
  if (hid) hid.value = ch;
}
function setCampChannelById(id, ch) {
  const parent = document.querySelector('#camp-card-' + id + ' .camp-channels');
  if (!parent) return;
  parent.querySelectorAll('.camp-ch').forEach(b => {
    b.classList.toggle('camp-ch-on',
      (ch === 'whatsapp' && b.classList.contains('camp-ch-wa')) ||
      (ch === 'sms' && b.classList.contains('camp-ch-sms')) ||
      (ch === 'instagram' && b.classList.contains('camp-ch-ig')));
  });
  const hid = document.getElementById('camp-' + id + '-channel');
  if (hid) hid.value = ch;
}
function updateCampStat() {
  CAMP_IDS.forEach(id => syncCampCard(id));
  const el = document.getElementById('camp-stat-active');
  if (el) el.textContent = CAMP_IDS.filter(id => document.getElementById('camp-' + id + '-enabled')?.checked).length;
}
function saveCampaign(id) {
  const enabled = document.getElementById('camp-' + id + '-enabled')?.checked ?? false;
  const channel = document.getElementById('camp-' + id + '-channel')?.value || 'whatsapp';
  const delayEl = document.getElementById('camp-' + id + '-delay');
  const msgEl   = document.getElementById('camp-' + id + '-msg');
  const campData = { enabled, channel, delay: delayEl ? Number(delayEl.value) : undefined, message: msgEl?.value };
  if (id === 'birthday') { const t = document.getElementById('camp-birthday-time'); const d = document.getElementById('camp-birthday-discount'); if (t) campData.send_time = t.value; if (d) campData.discount = Number(d.value); }
  if (id === 'review') { const l = document.getElementById('camp-review-link'); if (l) campData.review_link = l.value; }
  if (id === 'winback') { const d = document.getElementById('camp-winback-discount'); if (d) campData.discount = Number(d.value); }
  const merged = Object.assign({}, config.campaigns || {});
  merged[id] = campData;
  api('/api/config', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify(Object.assign({}, config, {campaigns: merged})) })
    .then(c => { config = c; updateCampStat(); toast('Campana guardada'); });
}
function loadCitas() {
  api('/api/config').then(cfg => {
    const banner = document.getElementById('cita-booking-banner');
    if (banner) banner.style.display = cfg.bookingUrl ? 'none' : 'flex';
    const citas = cfg.citas || {};
    CITA_IDS.forEach(id => {
      const c = citas[id] || {};
      const el = document.getElementById('cita-' + id + '-enabled');
      if (el) { el.checked = !!c.enabled; syncCitaCard(id); }
      if (c.channel) setCampChannelById('cita_' + id, c.channel);
      const msgEl = document.getElementById('cita-' + id + '-msg');
      if (msgEl && c.message) msgEl.value = c.message;
      if (id === 'reminder_2h') { const d = document.getElementById('cita-reminder_2h-delay'); if (d && c.delay != null) d.value = c.delay; }
      if (id === 'reminder_24h') { const r = document.getElementById('cita-reminder_24h-confirm_req'); if (r && c.confirm_required != null) r.checked = c.confirm_required; }
      if (id === 'cancel' || id === 'reschedule') {
        const kwCont = document.getElementById('cita-' + id + '-keywords');
        if (kwCont && c.keywords?.length) kwCont.innerHTML = c.keywords.map(k => `<span class="cita-kw">${k}<span onclick="removeCitaKw('${id}',this)">x</span></span>`).join('');
        if (id === 'cancel') { const o = document.getElementById('cita-cancel-offer_reschedule'); if (o && c.offer_reschedule != null) o.checked = c.offer_reschedule; }
      }
    });
  }).catch(() => {});
}
function syncCitaCard(id) { document.getElementById('cita-card-' + id)?.classList.toggle('cita-on', !!document.getElementById('cita-' + id + '-enabled')?.checked); }
function toggleCitaOpen(id) { document.getElementById('cita-card-' + id)?.classList.toggle('cita-open'); }
function updateCitaStat() { CITA_IDS.forEach(id => syncCitaCard(id)); }
function addCitaKw(id) {
  const input = document.getElementById('cita-' + id + '-kw-input');
  const val = input?.value.trim();
  if (!val) return;
  const cont = document.getElementById('cita-' + id + '-keywords');
  if (cont) { const sp = document.createElement('span'); sp.className = 'cita-kw'; sp.innerHTML = val + `<span onclick="removeCitaKw('${id}',this)">x</span>`; cont.appendChild(sp); }
  if (input) input.value = '';
}
function removeCitaKw(id, btn) { btn.closest('.cita-kw')?.remove(); }
function getCitaKeywords(id) { return [...document.querySelectorAll('#cita-' + id + '-keywords .cita-kw')].map(el => el.childNodes[0]?.textContent?.trim()).filter(Boolean); }
function saveCita(id) {
  const enabled = document.getElementById('cita-' + id + '-enabled')?.checked ?? false;
  const channel = document.getElementById('camp-cita_' + id + '-channel')?.value || 'whatsapp';
  const msgEl   = document.getElementById('cita-' + id + '-msg');
  const citaData = { enabled, channel, message: msgEl?.value };
  if (id === 'reminder_2h') { const d = document.getElementById('cita-reminder_2h-delay'); if (d) citaData.delay = Number(d.value); }
  if (id === 'reminder_24h') { const r = document.getElementById('cita-reminder_24h-confirm_req'); if (r) citaData.confirm_required = r.checked; }
  if (id === 'cancel') { citaData.keywords = getCitaKeywords('cancel'); const o = document.getElementById('cita-cancel-offer_reschedule'); if (o) citaData.offer_reschedule = o.checked; }
  if (id === 'reschedule') { citaData.keywords = getCitaKeywords('reschedule'); }
  const merged = Object.assign({}, config.citas || {});
  merged[id] = citaData;
  api('/api/config', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify(Object.assign({}, config, {citas: merged})) })
    .then(c => { config = c; syncCitaCard(id); toast('Flujo guardado'); });
}


// ── Commerce Pro ───────────────────────────────────────────────
async function loadBillingStatus() {
 try {
  const res = await fetch('/api/billing/status', {
   headers: { 'x-admin-password': password, 'x-admin-email': adminEmail, 'x-company-id': activeCompanyId }
  })
  const data = await res.json()
  const dot = document.getElementById('commerce-status-dot')
  const label = document.getElementById('commerce-status-label')
  const desc = document.getElementById('commerce-status-desc')
  const btnUpgrade = document.getElementById('btn-upgrade')
  const btnPortal = document.getElementById('btn-portal')
  const statusColors = { active:'#22c55e', past_due:'#f59e0b', cancelled:'#ef4444', inactive:'#555', pending_payment:'#f59e0b' }
  const statusLabels = { active:'● Commerce Pro activo', past_due:'⚠ Pago pendiente', cancelled:'✗ Cancelado', inactive:'Sin Commerce Pro', pending_payment:'Pago en proceso...' }
  dot.style.background = statusColors[data.commerce_pro_status] || '#555'
  label.textContent = statusLabels[data.commerce_pro_status] || data.commerce_pro_status || 'Sin datos'
  desc.textContent = data.commerce_pro_status === 'active'
   ? `Discovery Call: ${data.discovery_call_status} · Onboarding: ${data.onboarding_status}`
   : 'Activá Commerce Pro para conectar tu tienda Shopify o WooCommerce y habilitar el asistente de ventas.'
  btnUpgrade.style.display = (!data.commerce_pro_status || data.commerce_pro_status === 'inactive') ? 'inline-block' : 'none'
  btnPortal.style.display = data.stripe_customer_id ? 'inline-block' : 'none'
  const sections = document.getElementById('commerce-pro-sections')
  if (sections) {
    sections.style.display = data.commerce_pro_status === 'active' ? 'block' : 'none'
    if (data.commerce_pro_status === 'active') {
      loadCommerceStores()
      loadRelations()
      loadCommerceConfig()
      loadAnalytics()
    }
  }
 } catch(e) { console.error('billing status error', e) }
}

async function upgradeToCommercePro() {
 const res = await fetch('/api/billing/commerce-pro/upgrade', {
  method: 'POST',
  headers: { 'x-admin-password': password, 'x-admin-email': adminEmail, 'x-company-id': activeCompanyId }
 })
 const { url, error } = await res.json()
 if (error) return alert('Error: ' + error)
 window.location.href = url
}

async function connectShopify() {
  const url = document.getElementById('shopify-url').value.trim()
  const token = document.getElementById('shopify-token').value.trim()
  if (!url || !token) return alert('Completá la URL y el token')
  const res = await fetch('/api/commerce/stores/connect-shopify', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json', 'x-admin-password': password, 'x-admin-email': adminEmail, 'x-company-id': activeCompanyId },
    body: JSON.stringify({ store_url: url, access_token: token })
  })
  const data = await res.json()
  if (data.error) return alert('Error: ' + data.error)
  toast('Tienda conectada. Sincronizando catálogo...')
  document.getElementById('connect-shopify-form').style.display = 'none'
  loadCommerceStores()
}

async function loadCommerceStores() {
  const list = document.getElementById('stores-list')
  if (!list) return
  try {
    const res = await fetch('/api/commerce/stores', {
      headers: { 'x-admin-password': password, 'x-admin-email': adminEmail, 'x-company-id': activeCompanyId }
    })
    if (!res.ok) { list.innerHTML = '<p style="color:#888;font-size:13px">No disponible</p>'; return }
    const stores = await res.json()
    if (!stores.length) {
      list.innerHTML = '<p style="color:#888;font-size:13px">No hay tiendas conectadas.</p>'
      return
    }
    list.innerHTML = stores.map(s => `
      <div style="background:#1a1a1a;border:1px solid #2a2a2a;border-radius:10px;padding:16px;margin-bottom:10px;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:10px">
        <div>
          <span style="background:${s.platform==='shopify'?'#96bf48':'#7f54b3'};color:#fff;font-size:11px;padding:2px 8px;border-radius:4px;font-weight:600;margin-right:8px">${s.platform.toUpperCase()}</span>
          <strong style="font-size:13px">${s.store_url}</strong>
          <div style="font-size:11px;color:#888;margin-top:4px">${s.product_count||0} productos · ${s.sync_status} · ${s.last_sync_at?new Date(s.last_sync_at).toLocaleString('es-AR'):'nunca sincronizado'}</div>
        </div>
        <div style="display:flex;gap:8px">
          <button onclick="syncStore('${s.id}')" style="background:#1e1e2e;color:#aaa;border:1px solid #333;padding:6px 12px;border-radius:6px;cursor:pointer;font-size:12px">↻ Sync</button>
          <button onclick="disconnectStore('${s.id}')" style="background:transparent;color:#ef4444;border:1px solid #3a1414;padding:6px 12px;border-radius:6px;cursor:pointer;font-size:12px">Desconectar</button>
        </div>
      </div>
    `).join('')
  } catch(e) { list.innerHTML = '<p style="color:#ef4444;font-size:13px">Error cargando tiendas</p>' }
}

async function disconnectStore(storeId) {
  if (!confirm('¿Desconectar esta tienda? Se desactivarán sus productos del catálogo.')) return
  const res = await fetch(`/api/commerce/stores/${storeId}`, {
    method: 'DELETE',
    headers: { 'x-admin-password': password, 'x-admin-email': adminEmail, 'x-company-id': activeCompanyId }
  })
  const data = await res.json()
  if (data.error) return alert('Error: ' + data.error)
  toast('Tienda desconectada')
  loadCommerceStores()
}

async function loadRelations() {
  const list = document.getElementById('relations-list')
  if (!list) return
  try {
    const res = await fetch('/api/commerce/product-relations', {
      headers: { 'x-admin-password': password, 'x-admin-email': adminEmail, 'x-company-id': activeCompanyId }
    })
    if (!res.ok) { list.innerHTML = ''; return }
    const relations = await res.json()
    if (!relations.length) {
      list.innerHTML = '<p style="color:#888;font-size:13px;margin-bottom:10px">No hay relaciones definidas.</p>'
      return
    }
    list.innerHTML = `<table style="width:100%;border-collapse:collapse;font-size:13px;margin-bottom:12px">
      <thead><tr style="color:#888;text-align:left;border-bottom:1px solid #2a2a2a">
        <th style="padding:6px 8px">Origen</th><th style="padding:6px 8px">Tipo</th><th style="padding:6px 8px">Destino</th><th style="padding:6px 8px"></th>
      </tr></thead>
      <tbody>${relations.map(r=>`<tr style="border-bottom:1px solid #1a1a1a">
        <td style="padding:6px 8px;color:#ccc">${r.source_product_id}</td>
        <td style="padding:6px 8px"><span style="background:#1e1e2e;color:#aaa;padding:2px 8px;border-radius:4px;font-size:11px">${r.relation_type}</span></td>
        <td style="padding:6px 8px;color:#ccc">${r.target_product_id}</td>
        <td style="padding:6px 8px;text-align:right"><button onclick="deleteRelation('${r.id}')" style="background:transparent;color:#ef4444;border:none;cursor:pointer;font-size:12px">✕</button></td>
      </tr>`).join('')}</tbody>
    </table>`
  } catch(e) {}
}

async function addRelation() {
  const source = document.getElementById('rel-source').value.trim()
  const type = document.getElementById('rel-type').value
  const target = document.getElementById('rel-target').value.trim()
  if (!source || !target) return alert('Ingresá IDs de origen y destino')
  await fetch('/api/commerce/product-relations', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json', 'x-admin-password': password, 'x-admin-email': adminEmail, 'x-company-id': activeCompanyId },
    body: JSON.stringify({ source_product_id: source, relation_type: type, target_product_id: target })
  })
  document.getElementById('rel-source').value = ''
  document.getElementById('rel-target').value = ''
  toast('Relación agregada')
  loadRelations()
}

async function loadCommerceConfig() {
  try {
    const res = await fetch('/api/config', {
      headers: { 'x-admin-password': password, 'x-admin-email': adminEmail, 'x-company-id': activeCompanyId }
    })
    if (!res.ok) return
    const cfg = await res.json()
    const c = cfg.commerce || {}
    const el = id => document.getElementById(id)
    if (el('rec-coupon-enabled')) el('rec-coupon-enabled').checked = !!c.recovery_coupon_enabled
    if (el('rec-discount-type')) el('rec-discount-type').value = c.recovery_coupon_discount_type || 'percent'
    if (el('rec-discount-value')) el('rec-discount-value').value = c.recovery_coupon_discount_value ?? 10
    if (el('rec-expiration-hours')) el('rec-expiration-hours').value = c.recovery_coupon_expiration_hours ?? 48
    if (el('rec-delay-minutes')) el('rec-delay-minutes').value = c.recovery_delay_minutes ?? 60
  } catch(e) {}
}

async function loadAnalytics() {
  try {
    const res = await fetch('/api/commerce/analytics', {
      headers: { 'x-admin-password': password, 'x-admin-email': adminEmail, 'x-company-id': activeCompanyId }
    })
    if (!res.ok) return
    const data = await res.json()
    const set = (id, val) => { const el = document.querySelector(`#${id} .an-val`); if (el) el.textContent = val }
    set('an-discussed', data.products_discussed)
    set('an-sent', data.recovery_emails_sent)
    set('an-converted', data.recovery_emails_converted)
    set('an-rate', data.conversion_rate)
    const topList = document.getElementById('top-products-list')
    if (topList && data.top_products?.length) {
      topList.innerHTML = data.top_products.map(p =>
        `<div style="display:flex;justify-content:space-between;padding:8px 0;border-bottom:1px solid #1a1a1a;max-width:400px">
          <span style="color:#ccc">${p.title}</span>
          <span style="color:#888">${p.count} · <span style="color:${p.stock_status==='instock'?'#22c55e':'#ef4444'}">${p.stock_status}</span></span>
         </div>`
      ).join('')
    } else if (topList) {
      topList.innerHTML = '<p style="color:#888;font-size:13px">Sin datos aún.</p>'
    }
  } catch(e) {}
}

</script>
</body>
</html>
