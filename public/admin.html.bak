      <button class="camp-ch camp-ch-sms" onclick="setCampChannel('cita_reminder_2h','sms',this)">SMS</button>
      <button class="camp-ch camp-ch-ig" onclick="setCampChannel('cita_reminder_2h','instagram',this)">
       <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="12" height="12"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
       Instagram
      </button>
     </div>
     <input type="hidden" id="camp-cita_reminder_2h-channel" value="whatsapp">
     <div class="camp-timing"><label>Enviar</label><input type="number" id="cita-reminder_2h-delay" value="2" min="1" max="12"><label>horas antes de la cita</label></div>
     <label style="font-size:11px;color:var(--muted)">Mensaje del dia</label>
     <textarea id="cita-reminder_2h-msg" style="min-height:80px;font-size:12px;margin-top:6px">Hola {nombre}, en {horas} horas tienes tu cita de {servicio}. {negocio} — {hora} hrs. Te esperamos.</textarea>
     <div class="camp-vars" style="margin-top:6px">Variables: <code>{nombre}</code> <code>{hora}</code> <code>{horas}</code> <code>{servicio}</code> <code>{negocio}</code></div>
     <button style="font-size:12px;padding:6px 16px;margin-top:8px" onclick="saveCita('reminder_2h')">Guardar</button>
    </div>
   </div>

   <div class="cita-card" id="cita-card-cancel">
    <div class="cita-hdr" onclick="toggleCitaOpen('cancel')">
     <span class="cita-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg></span>
     <div style="flex:1"><div class="cita-name">Flujo de cancelacion</div><div class="cita-desc">Gestiona cancelaciones automaticamente y ofrece reagendamiento.</div></div>
     <label class="camp-toggle" onclick="event.stopPropagation()"><input type="checkbox" id="cita-cancel-enabled" onchange="updateCitaStat()"><span class="camp-track"></span><span class="camp-thumb"></span></label>
    </div>
    <div class="cita-body">
     <span class="cita-badge cita-badge-cancel">Trigger: cliente escribe palabra clave</span>
     <div class="camp-channels">
      <button class="camp-ch camp-ch-wa camp-ch-on" onclick="setCampChannel('cita_cancel','whatsapp',this)">
       <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="12" height="12"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
       WhatsApp
      </button>
      <button class="camp-ch camp-ch-sms" onclick="setCampChannel('cita_cancel','sms',this)">SMS</button>
      <button class="camp-ch camp-ch-ig" onclick="setCampChannel('cita_cancel','instagram',this)">
       <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="12" height="12"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
       Instagram
      </button>
     </div>
     <input type="hidden" id="camp-cita_cancel-channel" value="whatsapp">
     <label style="font-size:11px;color:var(--muted)">Palabras que activan este flujo <span style="color:#666">(Enter para anadir)</span></label>
     <div style="margin-top:6px;margin-bottom:10px">
      <div class="cita-keywords" id="cita-cancel-keywords">
       <span class="cita-kw">cancelar<span onclick="removeCitaKw('cancel',this)">x</span></span>
       <span class="cita-kw">quiero cancelar<span onclick="removeCitaKw('cancel',this)">x</span></span>
       <span class="cita-kw">no puedo ir<span onclick="removeCitaKw('cancel',this)">x</span></span>
       <span class="cita-kw">cancela mi cita<span onclick="removeCitaKw('cancel',this)">x</span></span>
      </div>
      <input type="text" id="cita-cancel-kw-input" placeholder="+ anadir frase" style="margin-top:8px;font-size:12px;padding:5px 10px" onkeydown="if(event.key==='Enter'){addCitaKw('cancel');event.preventDefault()}">
     </div>
     <div style="margin-bottom:10px">
      <label style="font-size:11px;color:var(--muted)">Ofrecer reagendar automaticamente</label>
      <div style="display:flex;align-items:center;gap:8px;margin-top:4px">
       <input type="checkbox" id="cita-cancel-offer_reschedule" style="width:auto;margin:0" checked>
       <label for="cita-cancel-offer_reschedule" style="font-size:12px;color:#aaa;margin:0;cursor:pointer">Si — incluir link de reserva en la respuesta</label>
      </div>
     </div>
     <label style="font-size:11px;color:var(--muted)">Mensaje al cancelar</label>
     <textarea id="cita-cancel-msg" style="min-height:80px;font-size:12px;margin-top:6px">Entendido {nombre}, hemos cancelado tu cita. Si quieres reagendar: {link_reserva}. Estamos aqui cuando nos necesites.</textarea>
     <div class="camp-vars" style="margin-top:6px">Variables: <code>{nombre}</code> <code>{fecha}</code> <code>{hora}</code> <code>{link_reserva}</code> <code>{negocio}</code></div>
     <button style="font-size:12px;padding:6px 16px;margin-top:8px" onclick="saveCita('cancel')">Guardar</button>
    </div>
   </div>

   <div class="cita-card" id="cita-card-reschedule" style="grid-column:span 2">
    <div class="cita-hdr" onclick="toggleCitaOpen('reschedule')">
     <span class="cita-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/></svg></span>
     <div style="flex:1"><div class="cita-name">Flujo de reagendamiento</div><div class="cita-desc">Detecta cuando un cliente quiere cambiar su cita y lo guia al link de reserva sin intervencion manual.</div></div>
     <label class="camp-toggle" onclick="event.stopPropagation()"><input type="checkbox" id="cita-reschedule-enabled" onchange="updateCitaStat()"><span class="camp-track"></span><span class="camp-thumb"></span></label>
    </div>
    <div class="cita-body">
     <span class="cita-badge cita-badge-reschedule">Trigger: cliente escribe palabra clave</span>
     <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px">
      <div>
       <label style="font-size:11px;color:var(--muted)">Palabras que activan este flujo <span style="color:#666">(Enter para anadir)</span></label>
       <div style="margin-top:6px;margin-bottom:10px">
        <div class="cita-keywords" id="cita-reschedule-keywords">
         <span class="cita-kw">reagendar<span onclick="removeCitaKw('reschedule',this)">x</span></span>
         <span class="cita-kw">cambiar cita<span onclick="removeCitaKw('reschedule',this)">x</span></span>
         <span class="cita-kw">otra fecha<span onclick="removeCitaKw('reschedule',this)">x</span></span>
         <span class="cita-kw">cambiar fecha<span onclick="removeCitaKw('reschedule',this)">x</span></span>
        </div>
        <input type="text" id="cita-reschedule-kw-input" placeholder="+ anadir frase" style="margin-top:8px;font-size:12px;padding:5px 10px" onkeydown="if(event.key==='Enter'){addCitaKw('reschedule');event.preventDefault()}">
       </div>
      </div>
      <div>
       <label style="font-size:11px;color:var(--muted)">Mensaje de reagendamiento</label>
       <textarea id="cita-reschedule-msg" style="min-height:110px;font-size:12px;margin-top:6px">Claro {nombre}, podemos reagendar tu cita sin problema. Aqui puedes elegir el dia y hora que mejor te quede: {link_reserva}</textarea>
       <div class="camp-vars" style="margin-top:4px">Variables: <code>{nombre}</code> <code>{link_reserva}</code> <code>{negocio}</code></div>
      </div>
     </div>
     <button style="font-size:12px;padding:6px 16px;margin-top:4px" onclick="saveCita('reschedule')">Guardar</button>
    </div>
   </div>

  </div>
 </div>

