   <div class="sb-label" data-i18n="sb_data">Datos</div>
   <button class="nav-item" data-tab="leads" onclick="tab('leads')"><span class="ic"><i data-lucide="users"></i></span><span data-i18n="nav_leads">Leads</span></button>
   <button class="nav-item" data-tab="convs" onclick="tab('convs')"><span class="ic"><i data-lucide="message-square"></i></span><span data-i18n="nav_convs">Conversaciones</span></button>
   <button class="nav-item" data-tab="reports" onclick="tab('reports')"><span class="ic"><i data-lucide="trending-up"></i></span><span data-i18n="nav_reports">Reportes</span></button>
  </div>
  <div class="sb-group">
   <div class="sb-label" data-i18n="sb_training">Entrenamiento</div>
   <button class="nav-item" data-tab="knowledge" onclick="tab('knowledge')"><span class="ic"><i data-lucide="book-open"></i></span><span data-i18n="nav_knowledge">Conocimiento</span></button>
   <button class="nav-item" data-tab="training" onclick="tab('training')"><span class="ic"><i data-lucide="graduation-cap"></i></span><span data-i18n="nav_training">Entrenar</span></button>
  </div>
