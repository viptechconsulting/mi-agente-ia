<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<title>Admin — Chat.Lynkro.io</title>
<link rel="icon" type="image/png" href="https://lynkro.io/logo1-removebg-preview.png">
<script src="https://unpkg.com/lucide@latest/dist/umd/lucide.min.js"></script>
<style>
 :root{--gold:#27F59B;--gold-dim:#1ac77a;--blue:#3BA5FF;
  --bg:#0B0F14;--card:#151922;--border:#252A38;--muted:#9FB0C8;--text:#F5F7FA;
  --sb:#0d1117;--sb-text:#8899b0;--sb-hover:rgba(255,255,255,.05);--sb-active:rgba(39,245,155,.1);
  --input-bg:#0e1219;--card-from:#151922;--card-to:#0e1219}
 [data-theme="light"]{
  --bg:#f0f4f8;--card:#fff;--border:#e2e8f0;--muted:#64748b;--text:#1e293b;
  --sb:#1e293b;--sb-text:#94a3b8;--sb-hover:rgba(255,255,255,.08);--sb-active:rgba(39,245,155,.18);
  --input-bg:#f8fafc;--card-from:#fff;--card-to:#f8fafc}
 *{box-sizing:border-box;margin:0;padding:0}
 html,body{height:100%}
 body{background:var(--bg);color:var(--text);font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;min-height:100vh}
 /* ── Sidebar ── */
 #sidebar{width:240px;min-height:100vh;background:var(--sb);border-right:1px solid rgba(255,255,255,.07);display:flex;flex-direction:column;position:fixed;left:0;top:0;bottom:0;overflow-y:auto;z-index:200}
 #sidebar::-webkit-scrollbar{width:3px}#sidebar::-webkit-scrollbar-thumb{background:#2a2a2a;border-radius:4px}
 .sb-logo{padding:22px 20px 16px;border-bottom:1px solid rgba(255,255,255,.06)}
 .sb-logo h1{font-weight:300;font-size:20px;color:#fff;letter-spacing:-.3px}
 .sb-logo h1 span{background:linear-gradient(135deg,var(--gold),var(--gold-dim));-webkit-background-clip:text;-webkit-text-fill-color:transparent;font-weight:700}
 .sb-logo .sub{color:var(--sb-text);font-size:11px;margin-top:3px}
 .sb-co{padding:14px 16px;border-bottom:1px solid rgba(255,255,255,.06)}
 .sb-co label{font-size:9px;color:var(--sb-text);text-transform:uppercase;letter-spacing:1.5px;margin-bottom:6px;display:block}
 .sb-co select{width:100%;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.1);color:#cdd6e3;padding:8px 10px;border-radius:7px;font-size:12px;outline:none}
 .sb-group{padding:6px 0}
 .sb-label{font-size:9px;color:var(--sb-text);text-transform:uppercase;letter-spacing:1.8px;padding:10px 20px 4px;font-weight:600;opacity:.7}
 .nav-item{display:flex;align-items:center;gap:11px;padding:9px 20px;cursor:pointer;color:var(--sb-text);font-size:13px;border-left:3px solid transparent;transition:all .12s;user-select:none;font-weight:400;letter-spacing:0;text-transform:none;background:none;border-top:none;border-right:none;border-bottom:none;border-radius:0;width:100%;text-align:left}
 .nav-item:hover{background:var(--sb-hover);color:#d0dae8;opacity:1}
 .nav-item.active{background:var(--sb-active);color:var(--gold);border-left-color:var(--gold)}
 .nav-item .ic{width:16px;height:16px;flex-shrink:0;display:flex;align-items:center;justify-content:center}
 .nav-item .ic svg{width:16px;height:16px;stroke:currentColor;fill:none;stroke-width:1.75;flex-shrink:0}
 .sb-footer{margin-top:auto;padding:14px 16px;border-top:1px solid rgba(255,255,255,.06)}
 .theme-btn{width:100%;background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.1);color:var(--sb-text);padding:9px;border-radius:8px;cursor:pointer;font-size:12px;display:flex;align-items:center;justify-content:center;gap:8px;transition:background .15s;text-transform:none;letter-spacing:0;font-weight:400}
 .theme-btn:hover{background:rgba(255,255,255,.1);color:#fff;opacity:1}
 /* ── Main ── */
 #main{margin-left:240px;padding:36px 44px;min-height:100vh}
 .content-wrap{max-width:880px}
 h1{font-weight:300;font-size:26px}
 h1 span{background:linear-gradient(135deg,var(--gold),var(--gold-dim));-webkit-background-clip:text;-webkit-text-fill-color:transparent;font-weight:700}
 .sub{color:var(--muted);font-size:13px;margin-top:4px}
 .card{background:linear-gradient(135deg,var(--card-from),var(--card-to));border:1px solid var(--border);border-radius:14px;padding:28px;margin-bottom:20px}
 .card h2{margin:0 0 18px;font-size:14px;text-transform:uppercase;letter-spacing:2px;color:var(--gold);font-weight:500}
 label{display:block;font-size:12px;color:var(--muted);margin:14px 0 6px;letter-spacing:.5px;text-transform:uppercase}
 input,textarea,select{width:100%;background:var(--input-bg);border:1px solid var(--border);color:var(--text);padding:11px 14px;border-radius:8px;font-size:14px;outline:none;font-family:inherit;transition:border-color .2s}
 input:focus,textarea:focus,select:focus{border-color:var(--gold)}
 textarea{min-height:90px;resize:vertical}
 .row{display:grid;grid-template-columns:1fr 1fr;gap:16px}
 button{background:linear-gradient(135deg,var(--gold),var(--gold-dim));color:#0B0F14;border:none;padding:12px 24px;border-radius:8px;cursor:pointer;font-weight:600;font-size:13px;letter-spacing:.5px;text-transform:uppercase;transition:opacity .2s}
 button:hover{opacity:.9}
 button.secondary{background:#1a1f2e;color:var(--gold);border:1px solid var(--border)}
 [data-theme="light"] button.secondary{background:#e8edf3;color:var(--gold)}
 .faq-item{background:var(--input-bg);border:1px solid var(--border);border-radius:8px;padding:14px;margin-bottom:10px;position:relative}
 .faq-item button{position:absolute;top:10px;right:10px;background:#2a0a0a;color:#ff6b6b;border:1px solid #4a1515;padding:4px 10px;font-size:11px}
 /* ── Login page ── */
 #login{position:fixed;inset:0;z-index:500;display:grid;grid-template-columns:1fr 1fr;background:#0a0c12}
 @media(max-width:760px){#login{grid-template-columns:1fr}}
 /* Left panel */
 .ll{background:#07090d;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:clamp(60px,9vh,120px) 48px;position:relative;overflow:hidden;gap:0}
 @media(max-width:760px){.ll{display:none}}
 .ll-orb1{position:absolute;width:420px;height:420px;background:radial-gradient(circle,rgba(39,245,155,.14),transparent 70%);top:-120px;right:-80px;border-radius:50%;filter:blur(70px);pointer-events:none}
 .ll-orb2{position:absolute;width:300px;height:300px;background:radial-gradient(circle,rgba(59,165,255,.1),transparent 70%);bottom:-80px;left:-60px;border-radius:50%;filter:blur(60px);pointer-events:none}
 /* Phone shell — iPhone 17 style */
 .lp-shell{position:relative;z-index:1;flex-shrink:0}
 .lp-phone{width:340px;border-radius:52px;background:#0b1410;border:11px solid #1c1c1e;box-shadow:0 50px 100px rgba(0,0,0,.85),0 0 0 1px rgba(255,255,255,.08),inset 0 0 0 1px rgba(255,255,255,.04);overflow:hidden;position:relative}
 /* Side button grooves */
 .lp-phone::before{content:'';position:absolute;right:-14px;top:100px;width:4px;height:70px;background:#2a2a2e;border-radius:0 3px 3px 0;z-index:10}
 .lp-phone::after{content:'';position:absolute;left:-14px;top:90px;width:4px;height:44px;background:#2a2a2e;border-radius:3px 0 0 3px;box-shadow:0 56px 0 #2a2a2e,0 100px 0 #2a2a2e;z-index:10}
 /* Dynamic Island */
 .lp-island{height:48px;background:#1f2c23;display:flex;align-items:center;justify-content:space-between;padding:0 20px;position:relative}
 .lp-island::after{content:'';position:absolute;top:10px;left:50%;transform:translateX(-50%);width:100px;height:28px;background:#0b1410;border-radius:20px;z-index:2;box-shadow:0 0 0 1px rgba(255,255,255,.07)}
 .lp-island .time{font-size:13px;font-weight:600;color:#e9edef;z-index:3;position:relative}
 .lp-island .icons{display:flex;gap:6px;align-items:center;z-index:3;position:relative}
 .lp-island .icons svg{width:14px;height:14px;stroke:#e9edef;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;opacity:.85}
 /* WA header */
 .lp-hdr{background:#1f2c23;padding:10px 18px 12px;display:flex;align-items:center;gap:12px;border-bottom:1px solid rgba(255,255,255,.05)}
 .lp-back{color:#25D366;font-size:20px;line-height:1;margin-right:-2px;font-weight:300}
 .lp-av{width:40px;height:40px;border-radius:50%;background:linear-gradient(135deg,#27F59B,#1ac77a);display:flex;align-items:center;justify-content:center;font-size:15px;color:#0a0c12;font-weight:800;flex-shrink:0}
 .lp-hinfo{flex:1}
 .lp-hinfo .n{font-size:14px;font-weight:600;color:#e9edef;line-height:1.3}
 .lp-hinfo .s{font-size:11.5px;color:#25D366;margin-top:2px;display:flex;align-items:center;gap:4px}
 .lp-hinfo .s::before{content:'';width:6px;height:6px;border-radius:50%;background:#25D366;box-shadow:0 0 5px #25D366;display:inline-block;flex-shrink:0}
 .lp-icons{display:flex;gap:16px;color:#8696a0;font-size:19px}
 /* Messages */
 .lp-msgs{background:#0c1a10;padding:14px 14px 10px;display:flex;flex-direction:column;gap:8px}
 .lp-b{padding:10px 13px 6px;border-radius:10px;font-size:13.5px;line-height:1.5;max-width:82%;color:#e9edef;word-break:break-word}
 .lp-b.i{background:#1e2d22;align-self:flex-start;border-radius:0 10px 10px 10px}
 .lp-b.o{background:#1a4a22;align-self:flex-end;border-radius:10px 10px 0 10px}
 .lp-t{font-size:10.5px;color:#8696a0;margin-top:4px;text-align:right;display:flex;align-items:center;justify-content:flex-end;gap:3px}
 .lp-t .check{color:#53bdeb}
 /* Footer input */
 .lp-ft{background:#1f2c23;padding:10px 14px;display:flex;gap:10px;align-items:center}
 .lp-ft .inp{flex:1;background:#2a3942;border-radius:22px;padding:9px 15px;font-size:13px;color:#8696a0;font-family:inherit}
 .lp-ft .send{width:38px;height:38px;border-radius:50%;background:#00a884;display:flex;align-items:center;justify-content:center;color:#fff;flex-shrink:0}
 .lp-ft .send svg{width:16px;height:16px;fill:#fff}
 /* Floating badges */
 .lp-badges{display:flex;gap:10px;margin-top:22px;position:relative;z-index:1;flex-wrap:wrap;justify-content:center}
 .lp-badge{background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.1);border-radius:50px;padding:7px 14px;display:flex;align-items:center;gap:8px;backdrop-filter:blur(8px)}
 .lp-badge .dot{width:7px;height:7px;border-radius:50%;flex-shrink:0}
 .lp-badge .dot.green{background:#27F59B;box-shadow:0 0 6px rgba(39,245,155,.6)}
 .lp-badge .dot.blue{background:#3BA5FF;box-shadow:0 0 6px rgba(59,165,255,.5)}
 .lp-badge span{font-size:12px;color:#c8d6e8;font-weight:500}
 .lp-badge strong{color:#F5F7FA;font-size:13px}
 /* Tagline */
 .ll-tag{text-align:center;max-width:360px;font-size:22px;font-weight:800;color:#F5F7FA;line-height:1.35;letter-spacing:-.4px;margin-top:24px;position:relative;z-index:1}
 .ll-tag .g{background:linear-gradient(135deg,#27F59B,#1ac77a);-webkit-background-clip:text;-webkit-text-fill-color:transparent}
 .ll-tag .b{background:linear-gradient(135deg,#3BA5FF,#1a7fcf);-webkit-background-clip:text;-webkit-text-fill-color:transparent}
 /* Right panel */
 .lr{background:#ffffff;display:flex;align-items:center;justify-content:center;padding:48px 40px}
 .lf{width:100%;max-width:380px}
 .lf-top{text-align:center;margin-bottom:32px}
 .lf-top img{height:54px;margin-bottom:14px;display:block;margin-left:auto;margin-right:auto}
 .lf-top .n{font-size:17px;font-weight:700;color:#0f172a;letter-spacing:-.2px}
 .lf-top .s{font-size:12px;color:#64748b;margin-top:3px}
 .lf-title{font-size:28px;font-weight:800;color:#0f172a;text-align:center;margin-bottom:28px;letter-spacing:-.6px}
 .lf-inp{margin-bottom:13px}
 .lf-inp input{width:100%;border:1.5px solid #e2e8f0;border-radius:10px;padding:13px 16px;font-size:14px;color:#0f172a;outline:none;background:#f8fafc;transition:border-color .2s,box-shadow .2s;font-family:inherit}
 .lf-inp input:focus{border-color:#27F59B;background:#fff;box-shadow:0 0 0 3px rgba(39,245,155,.12)}
 .lf-inp input::placeholder{color:#94a3b8}
 .lf-btn{width:100%;background:linear-gradient(135deg,#27F59B,#1ac77a);color:#0B0F14;border:none;padding:14px;border-radius:10px;font-size:15px;font-weight:700;cursor:pointer;transition:all .2s;letter-spacing:.1px;margin-top:4px}
 .lf-btn:hover{box-shadow:0 8px 28px rgba(39,245,155,.38);transform:translateY(-1px)}
 .lf-privacy{text-align:center;margin-top:28px;font-size:12px;color:#94a3b8}
 .lf-privacy a{color:#27F59B;text-decoration:none}
 .login{width:100%;max-width:380px}
 .toast{position:fixed;bottom:24px;right:24px;background:var(--card);border:1px solid var(--gold);color:var(--gold);padding:14px 20px;border-radius:10px;transform:translateY(100px);transition:transform .3s;z-index:1000}
 .toast.show{transform:none}
 .tab{display:none}.tab.active{display:block}
 .conv{padding:14px;border:1px solid var(--border);border-radius:8px;margin-bottom:8px;cursor:pointer;font-size:13px;color:var(--muted)}
 .conv:hover{border-color:var(--gold)}
 .msg-log{background:var(--input-bg);padding:14px;border-radius:8px;margin-top:10px;max-height:400px;overflow-y:auto;font-size:13px;line-height:1.6}
 .msg-log .u{color:var(--gold)}.msg-log .a{color:#c7d2e3}
 .metric{background:var(--input-bg);border:1px solid var(--border);border-radius:10px;padding:18px;text-align:center}
 .metric .v{font-size:28px;font-weight:600;color:var(--gold);margin-bottom:4px}
 .metric .l{font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:1px}
 .bar{height:24px;background:linear-gradient(90deg,var(--gold),var(--gold-dim));border-radius:4px;display:inline-block;vertical-align:middle}
 .bar-row{display:flex;align-items:center;gap:10px;margin-bottom:8px;font-size:13px}
 .bar-row .label{flex:1;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
 .bar-row .count{color:var(--gold);font-weight:600;min-width:30px;text-align:right}
 @media(max-width:800px){#sidebar{transform:translateX(-240px);transition:transform .3s}#sidebar.open{transform:none}#main{margin-left:0;padding:20px 16px}#menuToggle{display:flex!important}}
 /* ── Admin lang toggle ── */
 .admin-lang-toggle{display:flex;gap:4px;margin-bottom:10px}
 .admin-lt-btn{flex:1;padding:7px;border-radius:8px;border:1px solid rgba(255,255,255,.1);background:transparent;color:var(--sb-text);font-size:12px;font-weight:700;cursor:pointer;font-family:inherit;transition:all .2s;text-transform:none;letter-spacing:0}
 .admin-lt-btn.active{background:rgba(39,245,155,.15);color:var(--gold);border-color:rgba(39,245,155,.3)}
 .admin-lt-btn:hover{opacity:1;background:rgba(255,255,255,.06);color:#d0dae8}

/* ── Campanas & Citas ── */
.camp-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}
@media(max-width:900px){.camp-grid{grid-template-columns:1fr}}
.camp-card{background:var(--card);border:1px solid var(--border);border-radius:12px;overflow:hidden;transition:border-color .2s}
.camp-card.camp-on{border-color:rgba(39,245,155,.3)}
.camp-hdr{display:flex;align-items:flex-start;gap:12px;padding:16px 18px;cursor:pointer}
.camp-icon{width:28px;height:28px;flex-shrink:0;margin-top:2px;display:flex;align-items:center;justify-content:center;color:var(--muted)}
.camp-name{font-size:13px;font-weight:600;letter-spacing:-.2px;margin-bottom:3px}
.camp-desc{font-size:11px;color:var(--muted);line-height:1.4}
.camp-toggle{position:relative;width:36px;height:20px;flex-shrink:0;margin-left:auto}
.camp-toggle input{opacity:0;width:0;height:0;position:absolute}
.camp-track{position:absolute;inset:0;border-radius:10px;background:#2a2a2a;border:1px solid #3a3a3a;transition:.2s}
.camp-toggle input:checked~.camp-track{background:rgba(39,245,155,.25);border-color:rgba(39,245,155,.5)}
.camp-thumb{position:absolute;top:3px;left:3px;width:14px;height:14px;border-radius:50%;background:#555;transition:.2s}
.camp-toggle input:checked~.camp-thumb{left:19px;background:#27F59B}
.camp-body{padding:0 18px 18px;display:none}
.camp-card.camp-open .camp-body{display:block}
.camp-channels{display:flex;gap:6px;margin-bottom:12px;flex-wrap:wrap}
.camp-ch{display:flex;align-items:center;gap:5px;font-size:11px;padding:5px 10px;border-radius:6px;border:1px solid var(--border);background:transparent;color:var(--muted);cursor:pointer;text-transform:none;letter-spacing:0;font-weight:500;transition:all .15s}
.camp-ch:hover{background:rgba(255,255,255,.05);color:var(--text)}
.camp-ch.camp-ch-on{background:rgba(39,245,155,.1);color:#27F59B;border-color:rgba(39,245,155,.3)}
.camp-ch-wa.camp-ch-on{background:rgba(37,211,102,.1);color:#25D366;border-color:rgba(37,211,102,.3)}
.camp-ch-sms.camp-ch-on{background:rgba(59,130,246,.1);color:#3B82F6;border-color:rgba(59,130,246,.3)}
.camp-ch-ig.camp-ch-on{background:rgba(253,29,29,.1);color:#fd1d1d;border-color:rgba(253,29,29,.3)}
.camp-timing{display:flex;align-items:center;gap:8px;margin-bottom:10px;flex-wrap:wrap}
.camp-timing label{font-size:11px;color:var(--muted);white-space:nowrap}
.camp-timing input[type=number],.camp-timing select{width:80px;padding:5px 8px;font-size:12px}
.camp-vars{font-size:10px;color:var(--muted);margin:6px 0 8px;line-height:1.7}
.camp-vars code{background:rgba(39,245,155,.08);color:#27F59B;border-radius:3px;padding:1px 5px;font-size:10px}
.cita-card{background:var(--card);border:1px solid var(--border);border-radius:12px;overflow:hidden;transition:border-color .2s}
.cita-card.cita-on{border-color:rgba(59,130,246,.35)}
.cita-hdr{display:flex;align-items:flex-start;gap:12px;padding:16px 18px;cursor:pointer;user-select:none}
.cita-icon{width:28px;height:28px;flex-shrink:0;margin-top:2px;display:flex;align-items:center;justify-content:center;color:var(--muted)}
.cita-name{font-size:13px;font-weight:600;letter-spacing:-.2px;margin-bottom:3px}
.cita-desc{font-size:11px;color:var(--muted);line-height:1.4}
.cita-body{padding:0 18px 18px;display:none}
.cita-card.cita-open .cita-body{display:block}
.cita-badge{display:inline-block;font-size:10px;font-weight:700;padding:2px 8px;border-radius:99px;text-transform:uppercase;letter-spacing:.5px;margin-bottom:10px}
.cita-badge-confirm{background:rgba(74,222,128,.12);color:#4ade80;border:1px solid rgba(74,222,128,.25)}
.cita-badge-remind{background:rgba(249,115,22,.12);color:#f97316;border:1px solid rgba(249,115,22,.25)}
.cita-badge-cancel{background:rgba(239,68,68,.12);color:#ef4444;border:1px solid rgba(239,68,68,.25)}
.cita-badge-reschedule{background:rgba(59,130,246,.12);color:#3B82F6;border:1px solid rgba(59,130,246,.25)}
.cita-keywords{display:flex;flex-wrap:wrap;gap:5px;margin-top:6px}
.cita-kw{font-size:11px;background:#111;border:1px solid #2a2a2a;border-radius:4px;padding:2px 8px;color:#aaa;display:flex;align-items:center;gap:4px}
.cita-kw span{cursor:pointer;color:#666;font-size:13px;line-height:1}.cita-kw span:hover{color:#ef4444}

/* Commerce Pro */
.analytics-card{background:#1a1a1a;border:1px solid #2a2a2a;border-radius:10px;padding:16px;display:flex;flex-direction:column;gap:6px}
.an-val{font-size:28px;font-weight:700;color:#fff}
.an-lbl{font-size:11px;color:#888;line-height:1.3}
</style>
</head>
<body>

<div id="login">
  <!-- LEFT: product showcase -->
  <div class="ll">
    <div class="ll-orb1"></div>
    <div class="ll-orb2"></div>
    <div class="lp-shell">
      <div class="lp-phone">
        <!-- Dynamic Island -->
        <div class="lp-island">
          <span class="time">9:41</span>
          <div class="icons">
            <svg viewBox="0 0 24 24"><path d="M1 6l11 11 11-11"/><path d="M4 9l8 8 8-8"/></svg>
            <svg viewBox="0 0 24 24"><rect x="2" y="7" width="14" height="10" rx="2" ry="2"/><path d="M22 11v2"/></svg>
          </div>
        </div>
        <!-- WA header -->
        <div class="lp-hdr">
          <div class="lp-back">&#8592;</div>
          <div class="lp-av">L</div>
          <div class="lp-hinfo">
            <div class="n">Lynkro AI — Glow MedSpa</div>
            <div class="s">&#9679; en l&#237;nea ahora</div>
          </div>
          <div class="lp-icons">
            <span>&#x260E;</span>
          </div>
        </div>
        <!-- Messages -->
        <div class="lp-msgs">
          <div class="lp-b i">
            &#161;Hola! Soy el asistente de Glow MedSpa. &#191;En qu&#233; te puedo ayudar hoy?
            <div class="lp-t">14:02</div>
          </div>
          <div class="lp-b o">
            Hola, quiero info sobre el Botox para frente y contorno de ojos
            <div class="lp-t">14:03 <span class="check">&#10003;&#10003;</span></div>
          </div>
          <div class="lp-b i">
            &#161;Perfecto! &#191;Te va bien el <strong>jueves a las 3pm</strong> para una consulta gratuita?
            <div class="lp-t">14:03</div>
          </div>
          <div class="lp-b o">
            &#161;S&#237;, perfecto! All&#225; estar&#233; &#128079;
            <div class="lp-t">14:04 <span class="check">&#10003;&#10003;</span></div>
          </div>
        </div>
        <!-- Input bar -->
        <div class="lp-ft">
          <div class="inp">Escribe un mensaje...</div>
          <div class="send">
            <svg viewBox="0 0 24 24"><path d="M22 2L11 13"/><path d="M22 2L15 22 11 13 2 9l20-7z"/></svg>
          </div>
        </div>
      </div>
    </div>
    <!-- Stat badges -->
    <div class="lp-badges">
      <div class="lp-badge">
        <div class="dot green"></div>
        <span><strong>31</strong> conversaciones hoy</span>
      </div>
      <div class="lp-badge">
        <div class="dot blue"></div>
        <span>Respuesta en <strong>&lt;2 min</strong></span>
      </div>
    </div>
    <!-- Tagline -->
    <div class="ll-tag">
      <span class="g">Organiza</span> conversaciones<br>y convierte leads en <span class="b">citas.</span>
    </div>
  </div>

  <!-- RIGHT: login form -->
  <div class="lr">
    <div class="lf">
      <div class="lf-top">
        <img src="https://lynkro.io/logo1-removebg-preview.png" alt="Chat.Lynkro.io">
        <div class="n">Chat.Lynkro.io</div>
        <div class="s">Conversation &amp; Follow-Up System</div>
      </div>
      <div class="lf-title" data-i18n="login_title">Iniciar sesi&#243;n</div>
      <div class="lf-inp">
        <input type="email" id="adminEmail" placeholder="Correo electr&#243;nico" data-i18n-placeholder="login_email" onkeydown="if(event.key==='Enter')login()" autocomplete="username">
      </div>
      <div class="lf-inp">
        <input type="password" id="pw" placeholder="Contrase&#241;a" data-i18n-placeholder="login_pw" onkeydown="if(event.key==='Enter')login()" autocomplete="current-password">
      </div>
      <button class="lf-btn" onclick="login()" data-i18n="login_btn">Iniciar sesi&#243;n</button>
      <div class="lf-privacy"><a href="https://lynkro.io" data-i18n="login_privacy">Pol&#237;ticas de privacidad</a></div>
    </div>
  </div>
</div>

<div id="app" style="display:none">

 <!-- Mobile menu toggle -->
 <button id="menuToggle" onclick="document.getElementById('sidebar').classList.toggle('open')" style="display:none;position:fixed;top:14px;left:14px;z-index:300;background:var(--sb);border:1px solid rgba(255,255,255,.15);color:#fff;padding:8px 12px;border-radius:8px;font-size:18px;cursor:pointer;text-transform:none;letter-spacing:0;line-height:1">☰</button>

 <nav id="sidebar">
