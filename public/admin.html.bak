     <div style="margin-bottom:10px"><label style="font-size:11px;color:var(--muted)">Link de resena (Google, Yelp, etc.)</label><input type="url" id="camp-review-link" placeholder="https://g.page/r/..." style="margin-top:4px;font-size:12px"></div>
     <textarea id="camp-review-msg" style="min-height:80px;font-size:12px">Hola {nombre}, esperamos que hayas disfrutado tu visita. ¿Nos dejarias una resena de 5 estrellas? Solo toma 1 minuto: {link_resena}</textarea>
     <div class="camp-vars">Variables: <code>{nombre}</code> <code>{link_resena}</code> <code>{servicio}</code> <code>{negocio}</code></div>
