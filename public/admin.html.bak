 </nav>

 <main id="main">
 <div class="content-wrap">

 <div id="tab-companies" class="tab">
 <div class="card">
 <h2 data-i18n="h2_create_company">Crear nueva empresa</h2>
 <div class="row">
 <div><label data-i18n="label_name">Nombre</label><input id="newCompanyName" placeholder="Ej. Mi Nueva Empresa"></div>
 <div><label data-i18n="label_slug">Slug (opcional, para subdominio)</label><input id="newCompanySlug" placeholder="mi-empresa"></div>
 </div>
 <br>
 <button onclick="createCompany()" data-i18n="btn_create_company">+ Crear empresa</button>
 </div>
 <div class="card">
 <h2 data-i18n="h2_companies_list">Empresas del sistema</h2>
 <p style="color:#888;font-size:13px;margin:0 0 16px" data-i18n="p_companies">Cada empresa tiene su propia configuración, conversaciones, base de conocimiento y métricas aisladas.</p>
 <div id="companiesList"></div>
 </div>
 </div>

 <div id="tab-demos" class="tab">
 <div id="demosContextBadge" style="display:none;background:rgba(39,245,155,.08);border:1px solid rgba(39,245,155,.2);border-radius:8px;padding:8px 14px;font-size:12px;color:var(--green);margin-bottom:16px;font-weight:500"></div>

 <!-- PLANTILLAS — primero para visibilidad inmediata -->
 <div class="card" style="border-color:rgba(0,200,90,.25)">
 <h2 style="display:flex;align-items:center;gap:10px" data-i18n="h2_templates">Plantillas de demo <span style="font-size:11px;font-weight:600;background:rgba(0,200,90,.15);color:#4ade80;border:1px solid rgba(0,200,90,.3);border-radius:6px;padding:2px 10px">Cuenta Lynkro.io</span></h2>
 <p style="color:var(--muted);font-size:13px;margin:0 0 16px" data-i18n="p_templates">Crea plantillas base que luego puedes clonar al crear cada demo. Usa IA para generar el contenido automáticamente.</p>
 <div style="display:flex;flex-direction:column;gap:10px;margin-bottom:20px;padding:16px;background:rgba(0,200,90,.04);border:1px solid rgba(0,200,90,.15);border-radius:10px">
  <div style="display:flex;gap:10px">
   <input id="newTemplateName" placeholder="Nombre de la plantilla (ej. Medspa base, Dental base...)" style="flex:1">
   <button onclick="createTemplate()" style="background:linear-gradient(135deg,#00C85A,#00A84A);color:#fff;border:none;white-space:nowrap" data-i18n="btn_create_template">+ Crear plantilla</button>
  </div>
  <textarea id="newTemplateInfo" rows="3" placeholder="Opcional — pega aquí un párrafo con info del negocio y la IA generará: nombre del agente, descripción, FAQs, mensaje de bienvenida..." style="resize:vertical;font-size:13px;line-height:1.5;border-color:rgba(0,200,90,.2)"></textarea>
  <div id="templateGenerating" style="display:none;color:var(--green);font-size:12px;text-align:center"> Generando contenido con IA... esto toma unos segundos</div>
 </div>
 <div id="templatesListDemo"></div>
 </div>

 <div class="card">
 <h2 data-i18n="h2_create_demo">Crear demo para prospecto</h2>
 <p style="color:var(--muted);font-size:13px;margin:0 0 16px" data-i18n="p_create_demo">
 Cada demo es un entorno aislado con su propio branding, FAQ, conversaciones y métricas. Genera un link único compartible con tu prospecto.
 </p>
 <label data-i18n="label_demo_name">Nombre del demo / prospecto</label>
 <input id="demoName" placeholder="Ej. Demo — Clínica Dental ABC">
 <div class="row">
 <div>
 <label data-i18n="label_demo_clone">Clonar configuración desde</label>
 <select id="demoParent">
 <option value="" data-i18n="opt_demo_empty">— Empresa vacía (plantilla)</option>
 </select>
 </div>
 <div>
 <label data-i18n="label_demo_expiry">Expira en (días, vacío = no expira)</label>
 <input id="demoExpiry" type="number" placeholder="14">
 </div>
 </div>
 <label style="display:flex;align-items:center;gap:10px;cursor:pointer;margin-top:12px">
 <input type="checkbox" id="demoSeed" checked style="width:auto">
 <span data-i18n="label_demo_seed">Precargar FAQs y conversaciones de ejemplo</span>
 </label>
 <br>
 <button onclick="createDemo()" data-i18n="btn_create_demo"> Crear demo</button>
 </div>

 <div class="card">
 <h2 data-i18n="h2_demos_list">Demos existentes</h2>
 <div id="demosList"></div>
 </div>
 </div>

 <div id="tab-dashboard" class="tab active">
 <div class="card" style="display:flex;justify-content:space-between;align-items:center;gap:16px">
 <div>
 <h2 style="margin:0" data-i18n="h2_demo_mode">Modo demo</h2>
 <p style="color:#888;font-size:13px;margin:4px 0 0" data-i18n="p_demo_mode">Prueba tu agente como si fueras un cliente. Las conversaciones demo NO se guardan ni afectan las métricas.</p>
 </div>
 <button onclick="openDemo()" style="white-space:nowrap" data-i18n="btn_demo_client"> Probar como cliente</button>
 </div>

 <div class="card">
 <h2 data-i18n="h2_metrics">Métricas <span style="float:right;font-size:10px;color:#555"></span></h2>
 <div class="metrics" id="metrics" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:14px"></div>
 </div>
 <div class="card">
 <h2 data-i18n="h2_unresolved">Consultas sin resolver</h2>
 <div id="unresolvedList"></div>
 </div>
 <div class="card">
 <h2 data-i18n="h2_top_questions">Preguntas más frecuentes (desde chats reales)</h2>
 <div id="topQuestions"></div>
 </div>
 <div class="card">
 <h2 data-i18n="h2_activity">Actividad últimos 7 días</h2>
 <div id="activityChart"></div>
 </div>
 </div>

 <div id="tab-config" class="tab">
 <div class="card">
 <h2 data-i18n="h2_biz_info">Información del negocio</h2>
 <label data-i18n="label_biz_name">Nombre del negocio</label>
 <input id="businessName">
 <label data-i18n="label_description">Descripción</label>
 <textarea id="description"></textarea>
 <div class="row">
 <div><label data-i18n="label_hours">Horario</label><input id="hours"></div>
 <div><label data-i18n="label_contact">Contacto</label><input id="contact"></div>
 </div>
 <label data-i18n="label_products">Productos / servicios</label>
 <textarea id="products"></textarea>
 </div>

 <div class="card">
 <h2 data-i18n="h2_agent_behavior">Comportamiento del agente</h2>
 <label data-i18n="label_tone">Tono</label>
 <input id="tone">
 <label data-i18n="label_welcome">Mensaje de bienvenida</label>
 <input id="welcomeMessage">
 <label data-i18n="label_booking">Link de citas (opcional) — se incluye automaticamente cuando alguien pide una cita</label>
 <input id="bookingUrl" placeholder="https://calendly.com/tu-link">
 <div style="display:flex;align-items:center;gap:8px;margin-top:-4px;margin-bottom:8px">
  <input type="checkbox" id="bookingFollowupEnabled" style="width:auto;margin:0">
  <label for="bookingFollowupEnabled" style="font-size:12px;color:#aaa;margin:0;cursor:pointer">Preguntar 30 min después si pudo agendar la cita</label>
 </div>
 <label data-i18n="label_extra">Instrucciones adicionales (opcional)</label>
 <textarea id="systemPromptExtra"></textarea>
 <div class="row">
 <div>
 <label data-i18n="label_model">Modelo Claude</label>
 <select id="model">
 <option value="claude-haiku-4-5-20251001" data-i18n="opt_haiku">Haiku 4.5 (rápido/barato)</option>
 <option value="claude-sonnet-4-6" data-i18n="opt_sonnet">Sonnet 4.6 (balance)</option>
 <option value="claude-opus-4-6" data-i18n="opt_opus">Opus 4.6 (máxima calidad)</option>
 </select>
 </div>
 <div>
 <label data-i18n="label_accent_color">Color de acento</label>
 <input id="accentColor" type="color" value="#D4AF37" style="height:45px;padding:4px">
 </div>
 </div>
 </div>

 <!-- Human handoff card -->
 <div class="card" style="border-left:3px solid #F59E0B">
  <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:6px">
   <h2 style="margin:0" data-i18n="h2_handoff">Redireccionamiento a humano</h2>
   <label style="display:flex;align-items:center;gap:8px;cursor:pointer;margin:0">
    <span style="font-size:12px;color:#888" data-i18n="handoff_enabled">Activado</span>
    <span style="position:relative;display:inline-block;width:42px;height:24px">
     <input type="checkbox" id="humanHandoffEnabled" style="opacity:0;width:0;height:0;position:absolute">
     <span id="humanHandoffSlider" onclick="document.getElementById('humanHandoffEnabled').click();updateHandoffSlider()" style="position:absolute;cursor:pointer;inset:0;background:#333;border-radius:24px;transition:.3s">
      <span style="position:absolute;content:'';height:18px;width:18px;left:3px;top:3px;background:#fff;border-radius:50%;transition:.3s;display:block" id="humanHandoffThumb"></span>
     </span>
    </span>
   </label>
  </div>
  <p style="color:#888;font-size:12px;margin:0 0 18px;line-height:1.6" data-i18n="p_handoff">Si el usuario menciona alguna de estas frases, la IA dejará de responder y alertará al número de WhatsApp configurado para atención manual.</p>

  <label data-i18n="label_triggers">Si el usuario menciona o pregunta…
   <span style="color:#888;font-size:11px;font-weight:400;margin-left:6px">(una frase por línea)</span>
  </label>
  <textarea id="humanHandoffTriggers" style="min-height:110px;font-size:13px" placeholder="quiero hablar con una persona&#10;hablar con un agente&#10;hablar con humano&#10;factura&#10;cancelar mi cuenta&#10;reembolso&#10;queja"></textarea>

  <label style="margin-top:12px" data-i18n="label_handoff_phone">Entonces la IA alertará a este número de WhatsApp</label>
  <input id="humanHandoffPhone" type="tel" placeholder="Ej. 13055550100 (con código de país, sin + ni espacios)">

  <label style="margin-top:12px" data-i18n="label_handoff_msg">Mensaje que recibe el usuario al ser redireccionado</label>
  <input id="humanHandoffUserMsg" placeholder="Ej. Un momento, te conecto con un agente que te ayudará.">
 </div>

 <button onclick="save()" data-i18n="btn_save_changes">Guardar cambios</button>
 </div>

 <div id="tab-persona" class="tab">
 <div class="card">
 <h2 data-i18n="h2_identity">Identidad del agente</h2>
 <div class="row">
 <div><label data-i18n="label_agent_name">Nombre del agente</label><input id="agentName" placeholder="Ej. Sofía, Max, Aura"></div>
 <div>
 <label data-i18n="label_language">Idioma por defecto</label>
 <select id="language">
 <option value="español">Español</option>
 <option value="inglés">Inglés (English)</option>
 <option value="portugués">Portugués (Português)</option>
 <option value="francés">Francés (Français)</option>
 <option value="hebreo">Hebreo (עברית)</option>
 <option value="italiano">Italiano</option>
 <option value="alemán">Alemán (Deutsch)</option>
 </select>
 </div>
 </div>
 <label style="display:flex;align-items:center;gap:10px;cursor:pointer;margin-top:14px">
 <input type="checkbox" id="autoDetectLanguage" style="width:auto">
 <span data-i18n="label_auto_detect">Detectar idioma automáticamente (responde en el idioma del cliente)</span>
 </label>
 <p style="color:#888;font-size:12px;margin:6px 0 0" data-i18n="p_lang_support">Soporta: español, inglés, francés, portugués, hebreo y más.</p>
 <label data-i18n="label_personality">Personalidad</label>
 <textarea id="personality" placeholder="Ej. Amable, resolutiva, con sentido del humor. Usa frases cortas. Nunca usa jerga técnica."></textarea>
 <label data-i18n="label_voice_tone">Tono de voz</label>
 <input id="tone2" placeholder="Ej. profesional pero cercano, con toque juvenil">
 </div>

 <div class="card">
 <h2 data-i18n="h2_voice_examples">Ejemplos de tu tono (entrena al agente)</h2>
 <p style="color:#888;font-size:13px;margin:0 0 10px" data-i18n="p_voice_examples">Pega fragmentos reales tuyos: posts, emails, respuestas de WhatsApp. El agente imitará este estilo.</p>
 <textarea id="voiceExamples" style="min-height:140px" placeholder="Ejemplo 1: 'Hey! Claro que sí, te mando el link ahora mismo '&#10;Ejemplo 2: 'Perfecto, quedamos entonces para el viernes. Cualquier cosa me avisas!'"></textarea>
 </div>

 <div class="card">
 <h2 data-i18n="h2_defaults">Respuestas predeterminadas</h2>
 <p style="color:#888;font-size:13px;margin:0 0 10px" data-i18n="p_defaults">El agente usará estas respuestas (o adaptaciones) en situaciones comunes.</p>
 <div id="defaultsList"></div>
 <button class="secondary" onclick="addDefault()" data-i18n="btn_add_default">+ Añadir situación</button>
 <br><br>
 <button onclick="save()" data-i18n="btn_save_all">Guardar todo</button>
 </div>
 </div>

 <div id="tab-triggers" class="tab">
  <div class="card">
   <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:16px;flex-wrap:wrap;gap:10px">
    <div>
     <h2 style="margin:0 0 4px">Palabras activadoras</h2>
     <p style="margin:0;font-size:12px;color:#777">Cuando el lead escribe una palabra clave, el sistema responde con el mensaje predefinido. La conversación continúa con normalidad porque la respuesta queda en el historial.</p>
    </div>
    <button onclick="addTrigger()" style="white-space:nowrap">+ Nuevo activador</button>
   </div>
   <div id="triggerList"></div>
   <div style="background:#111;border-radius:8px;padding:14px;margin-top:16px">
    <div style="font-size:12px;color:#666;line-height:1.6">
     <strong style="color:#888">Tipos de coincidencia:</strong>
     &nbsp;<span style="color:#facc15">contains</span> — el mensaje contiene la palabra en cualquier posición &nbsp;·&nbsp;
     <span style="color:#f97316">word</span> — coincide como palabra completa (no como parte de otra) &nbsp;·&nbsp;
     <span style="color:#ef4444">exact</span> — el mensaje completo es exactamente esa palabra
    </div>
   </div>
  </div>
  <div style="background:var(--card);border:1px solid var(--border);border-radius:10px;padding:16px;margin-top:8px;display:flex;justify-content:flex-end">
   <button onclick="saveTriggers()">Guardar activadores</button>
  </div>
 </div>
 <div id="tab-faqs" class="tab">
 <div class="card">
 <h2 data-i18n="h2_faqs">Preguntas frecuentes</h2>
 <div id="faqList"></div>
 <button class="secondary" onclick="addFaq()" data-i18n="btn_add_faq">+ Añadir FAQ</button>
 <br><br>
 <button onclick="save()" data-i18n="btn_save_faqs">Guardar FAQs</button>
 </div>
 </div>

 <div id="tab-quick" class="tab">
 <div class="card">
 <h2 data-i18n="h2_quick">Botones rápidos al iniciar chat</h2>
 <p style="color:#888;font-size:13px;margin:0 0 16px" data-i18n="p_quick">
 El cliente verá estos botones debajo del mensaje de bienvenida. Al clickearlos envían el mensaje configurado automáticamente.
 </p>
 <div id="quickList"></div>
 <button class="secondary" onclick="addQuick()" data-i18n="btn_add_quick">+ Añadir botón</button>
 <br><br>
 <button onclick="save()" data-i18n="btn_save">Guardar</button>
 </div>
 </div>

 <div id="tab-hours" class="tab">
 <div class="card">
 <h2 data-i18n="h2_hours">Horarios de atención</h2>
 <label style="display:flex;align-items:center;gap:10px;cursor:pointer">
 <input type="checkbox" id="ohEnabled" style="width:auto"> <span data-i18n="label_enable_hours">Activar horarios de atención</span>
 </label>
 <div class="row">
 <div>
 <label data-i18n="label_timezone">Zona horaria</label>
 <select id="ohTimezone">
 <option value="America/Mexico_City">Ciudad de México (GMT-6)</option>
 <option value="America/Bogota">Bogotá (GMT-5)</option>
 <option value="America/Lima">Lima (GMT-5)</option>
 <option value="America/New_York">Nueva York (GMT-5/-4)</option>
 <option value="America/Los_Angeles">Los Ángeles (GMT-8/-7)</option>
 <option value="America/Buenos_Aires">Buenos Aires (GMT-3)</option>
 <option value="America/Santiago">Santiago (GMT-4/-3)</option>
 <option value="Europe/Madrid">Madrid (GMT+1/+2)</option>
 <option value="Europe/London">Londres (GMT+0/+1)</option>
 </select>
 </div>
 </div>
 <label data-i18n="label_schedule">Días y horarios</label>
 <div id="scheduleList"></div>
 </div>

 <div class="card">
 <h2 data-i18n="h2_offline_msg">Mensaje fuera de horario</h2>
 <p style="color:#888;font-size:13px;margin:0 0 10px" data-i18n="p_offline_msg">El agente usará (o adaptará) este mensaje cuando un cliente escriba fuera de horario.</p>
 <textarea id="ohOfflineMessage" style="min-height:100px"></textarea>
 <br><br>
 <button onclick="save()" data-i18n="btn_save_hours">Guardar horarios</button>
 </div>
 </div>

 <div id="tab-appearance" class="tab">
 <div style="display:grid;grid-template-columns:1fr 1fr;gap:20px">
 <div>
 <div class="card">
 <h2 data-i18n="h2_colors">Colores</h2>
 <div class="row">
 <div><label data-i18n="label_accent_btn">Acento (botones, bordes)</label><input type="color" id="accentColor2" oninput="syncAppearance()" style="height:45px"></div>
 <div><label data-i18n="label_bg_color">Fondo del chat</label><input type="color" id="bgColor" oninput="syncAppearance()" style="height:45px"></div>
 </div>
 <label data-i18n="label_user_bubble">Color burbuja usuario</label>
 <input type="color" id="userBubbleColor" oninput="syncAppearance()" style="height:45px">
 </div>

 <div class="card">
 <h2 data-i18n="h2_logo">Logo de la empresa</h2>
 <div style="display:flex;align-items:center;gap:14px;margin-bottom:10px">
 <img id="logoPreview" src="" style="width:50px;height:50px;border-radius:50%;object-fit:cover;background:#161616;border:1px solid #333">
 <input type="file" accept="image/*" onchange="uploadImage(this,'logoUrl','logoPreview')">
 </div>
 <button class="secondary" onclick="clearImg('logoUrl','logoPreview')" style="font-size:11px;padding:6px 12px" data-i18n="btn_clear_logo">Quitar logo</button>
 </div>

 <div class="card">
 <h2 data-i18n="h2_avatar">Avatar del agente</h2>
 <div style="display:flex;align-items:center;gap:14px;margin-bottom:10px">
 <img id="avatarPreview" src="" style="width:50px;height:50px;border-radius:50%;object-fit:cover;background:#161616;border:1px solid #333">
 <input type="file" accept="image/*" onchange="uploadImage(this,'avatarUrl','avatarPreview')">
 </div>
 <button class="secondary" onclick="clearImg('avatarUrl','avatarPreview')" style="font-size:11px;padding:6px 12px" data-i18n="btn_clear_avatar">Quitar avatar</button>
 </div>

 <div class="card">
 <h2 data-i18n="h2_widget_pos">Posición del widget</h2>
 <label style="display:flex;align-items:center;gap:10px;cursor:pointer;margin-bottom:8px">
 <input type="radio" name="pos" value="right" onchange="config.widgetPosition='right';renderAppearance()" style="width:auto"> <span data-i18n="pos_right">Esquina inferior derecha</span>
 </label>
 <label style="display:flex;align-items:center;gap:10px;cursor:pointer">
 <input type="radio" name="pos" value="left" onchange="config.widgetPosition='left';renderAppearance()" style="width:auto"> <span data-i18n="pos_left">Esquina inferior izquierda</span>
 </label>
 </div>

 <button onclick="save()" data-i18n="btn_save_appearance">Guardar apariencia</button>
 </div>

 <div>
 <div class="card" style="position:sticky;top:20px">
 <h2 data-i18n="h2_live_preview">Preview en vivo</h2>
 <div id="previewBox" style="position:relative;height:520px;background:#1a1a1a;border-radius:12px;overflow:hidden;border:1px solid #222">
 <div style="position:absolute;top:0;left:0;right:0;padding:14px 18px;background:linear-gradient(180deg,#0f0f0f,transparent);color:#555;font-size:11px;letter-spacing:1px">SIMULACIÓN DE TU WEB</div>
 <div id="previewLauncher" style="position:absolute;bottom:16px;width:50px;height:50px;border-radius:50%;display:flex;align-items:center;justify-content:center;cursor:pointer;transition:all .3s;overflow:hidden"></div>
 <div id="previewPanel" style="position:absolute;bottom:80px;width:300px;height:380px;border-radius:12px;display:flex;flex-direction:column;overflow:hidden;transition:all .3s;border:1px solid;box-shadow:0 12px 40px rgba(0,0,0,.6)">
 <div id="previewHeader" style="padding:10px 14px;border-bottom:1px solid;display:flex;align-items:center;gap:8px;font-size:13px;font-weight:600;color:#fff"></div>
 <div style="flex:1;padding:12px;display:flex;flex-direction:column;gap:8px;overflow:hidden">
 <div id="previewAgentMsg" style="align-self:flex-start;padding:8px 12px;border-radius:10px;background:#161616;border:1px solid #222;color:#e8e8e8;font-size:12px;max-width:85%;display:flex;gap:6px;align-items:flex-start"></div>
 <div style="align-self:flex-end;padding:8px 12px;border-radius:10px;color:#f5e9b8;font-size:12px;max-width:75%" id="previewUserMsg">Gracias!</div>
 </div>
 <div id="previewInput" style="padding:8px;border-top:1px solid;display:flex;gap:6px">
 <div style="flex:1;background:#161616;border:1px solid #222;padding:6px 10px;border-radius:8px;color:#666;font-size:11px">Escribe tu mensaje...</div>
 <div id="previewBtn" style="padding:6px 12px;border-radius:8px;font-weight:600;font-size:11px;color:#000">Enviar</div>
 </div>
 </div>
 </div>
 </div>
 </div>
 </div>
 </div>

 <div id="tab-notifications" class="tab">
 <div class="card">
 <h2 data-i18n="h2_email_notifs">Notificaciones por email</h2>
 <p style="color:#888;font-size:13px;margin:0 0 16px" data-i18n="p_email_notifs">
 Recibirás un email cuando el agente capture un lead (email/teléfono del cliente) o cuando escale una conversación que no pudo resolver.
 </p>
 <label data-i18n="label_notify_email">Tu email de destino</label>
 <input type="email" id="notifyEmail" placeholder="tu@email.com">
 <div style="display:flex;gap:20px;margin-top:14px">
 <label style="display:flex;align-items:center;gap:8px;cursor:pointer">
 <input type="checkbox" id="notifyOnLead" style="width:auto"> <span data-i18n="notif_leads">Avisarme cuando capture leads</span>
 </label>
 <label style="display:flex;align-items:center;gap:8px;cursor:pointer">
 <input type="checkbox" id="notifyOnEscalation" style="width:auto"> <span data-i18n="notif_escalation">Avisarme de escalamientos</span>
 </label>
 </div>
 </div>

 <div class="card">
 <h2 data-i18n="h2_smtp">Servidor SMTP</h2>
 <p style="color:#888;font-size:13px;margin:0 0 16px" data-i18n="p_smtp">
 Configura tu SMTP. Opciones comunes: Gmail (smtp.gmail.com:587 con App Password), SendGrid, Mailgun, Resend SMTP, etc.
 </p>
 <div class="row">
 <div><label data-i18n="label_smtp_host">Host</label><input id="smtpHost" placeholder="smtp.gmail.com"></div>
 <div><label data-i18n="label_smtp_port">Puerto</label><input id="smtpPort" type="number" placeholder="587"></div>
 </div>
 <div class="row">
 <div><label data-i18n="label_smtp_user">Usuario</label><input id="smtpUser" placeholder="tu@gmail.com"></div>
 <div><label data-i18n="label_smtp_pass">Contraseña / App Password</label><input id="smtpPass" type="password" placeholder="••••••••"></div>
 </div>
 <label data-i18n="label_smtp_from">Remitente (From)</label>
 <input id="smtpFrom" placeholder="Agente IA &lt;notificaciones@tudominio.com&gt;">
 <label style="display:flex;align-items:center;gap:8px;cursor:pointer;margin-top:10px">
 <input type="checkbox" id="smtpSecure" style="width:auto"> <span data-i18n="label_ssl">Conexión SSL/TLS directa (puerto 465)</span>
 </label>
 <br>
 <button onclick="save()" data-i18n="btn_save">Guardar</button>
 <button class="secondary" onclick="testEmail()" style="margin-left:8px" data-i18n="btn_test_email">Enviar email de prueba</button>
 </div>
 </div>

 <div id="tab-reports" class="tab">

  <!-- Period selector -->
  <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:18px;flex-wrap:wrap;gap:12px">
    <h2 style="margin:0;font-size:16px;font-weight:600" data-i18n="h2_stats">Estadísticas</h2>
    <div style="display:flex;align-items:center;gap:8px">
      <label style="font-size:12px;color:#888;margin:0" data-i18n="label_period">Período:</label>
      <select id="statsPeriod" onchange="loadStats()" style="padding:6px 12px;border-radius:8px;background:#1a1a2e;border:1px solid rgba(255,255,255,.1);color:#e0e0e0;font-size:12px;cursor:pointer">
        <option value="all" data-i18n="period_all">Histórico</option>
        <option value="month" data-i18n="period_month">Últimos 30 días</option>
        <option value="week" data-i18n="period_week">Últimos 7 días</option>
        <option value="today" data-i18n="period_today">Hoy</option>
      </select>
      <button class="secondary" onclick="loadStats()" style="padding:6px 12px;font-size:12px" data-i18n="btn_refresh">↻ Actualizar</button>
    </div>
  </div>

  <!-- Row 1: Channel origin + Pie chart -->
  <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:16px">

    <!-- Channel origin card -->
    <div class="card" style="margin:0;padding:22px">
      <h3 style="font-size:13px;font-weight:600;color:#aab;letter-spacing:.5px;text-transform:uppercase;margin:0 0 18px" data-i18n="h3_channel_origin">Origen de conversación</h3>
      <div id="statsChannels" style="display:flex;flex-direction:column;gap:14px">
        <div style="color:#555;font-size:13px">Cargando...</div>
      </div>
    </div>

    <!-- Donut chart card -->
    <div class="card" style="margin:0;padding:22px;display:flex;flex-direction:column;align-items:center">
      <h3 style="font-size:13px;font-weight:600;color:#aab;letter-spacing:.5px;text-transform:uppercase;margin:0 0 18px;align-self:flex-start" data-i18n="h3_distribution">Distribución</h3>
      <svg id="statsDonut" width="160" height="160" viewBox="0 0 160 160">
        <text x="80" y="88" text-anchor="middle" style="font-size:28px;font-weight:700;fill:#e0e0e0" id="donutTotal">0</text>
        <text x="80" y="104" text-anchor="middle" style="font-size:10px;fill:#666">total</text>
      </svg>
      <div id="statsLegend" style="display:flex;flex-wrap:wrap;gap:10px;justify-content:center;margin-top:8px"></div>
    </div>
  </div>

  <!-- Row 2: Campaigns + Stages -->
  <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px">

    <!-- Campaigns card -->
    <div class="card" style="margin:0;padding:22px">
      <h3 style="font-size:13px;font-weight:600;color:#aab;letter-spacing:.5px;text-transform:uppercase;margin:0 0 14px" data-i18n="h3_campaigns">Conversaciones por campaña</h3>
      <input type="text" placeholder="Buscar campañas…" style="width:100%;padding:7px 12px;border-radius:8px;background:#111;border:1px solid rgba(255,255,255,.08);color:#ccc;font-size:12px;margin-bottom:12px" oninput="filterCampaigns(this.value)">
      <div id="statsCampaigns">
        <div style="text-align:center;padding:28px 0;color:#444;font-size:13px">
          <div style="font-size:28px;margin-bottom:6px"></div>
          No se encontraron campañas
          <div style="font-size:11px;color:#333;margin-top:4px">0–0 de 0</div>
        </div>
      </div>
      <div style="display:flex;align-items:center;gap:6px;justify-content:flex-end;margin-top:12px">
        <button class="secondary" style="padding:5px 10px;font-size:12px" disabled>‹</button>
        <span style="background:var(--gold);color:#000;font-size:12px;font-weight:700;padding:4px 9px;border-radius:5px">1</span>
        <button class="secondary" style="padding:5px 10px;font-size:12px" disabled>›</button>
      </div>
    </div>

    <!-- Stages card -->
    <div class="card" style="margin:0;padding:22px">
      <h3 style="font-size:13px;font-weight:600;color:#aab;letter-spacing:.5px;text-transform:uppercase;margin:0 0 18px" data-i18n="h3_stages">Conversación por etapa</h3>
      <div id="statsStages" style="display:flex;flex-direction:column;gap:10px">
        <div style="color:#555;font-size:13px">Cargando...</div>
      </div>
    </div>
  </div>

  <!-- Row 3: Activity sparkline + PDF report -->
  <div style="display:grid;grid-template-columns:2fr 1fr;gap:16px;margin-top:16px">
    <div class="card" style="margin:0;padding:22px">
      <h3 style="font-size:13px;font-weight:600;color:#aab;letter-spacing:.5px;text-transform:uppercase;margin:0 0 14px" data-i18n="h3_activity">Actividad (últimos 30 días)</h3>
      <svg id="statsActivity" width="100%" height="64" style="display:block"></svg>
    </div>
    <div class="card" style="margin:0;padding:22px">
      <h3 style="font-size:13px;font-weight:600;color:#aab;letter-spacing:.5px;text-transform:uppercase;margin:0 0 14px" data-i18n="h3_report">Reporte PDF</h3>
      <select id="reportDays" style="width:100%;margin-bottom:12px">
        <option value="7" data-i18n="report_7d">Últimos 7 días</option>
        <option value="30" data-i18n="report_30d">Últimos 30 días</option>
        <option value="90" data-i18n="report_90d">Últimos 90 días</option>
      </select>
      <button onclick="downloadReport()" style="width:100%;margin-bottom:8px" data-i18n="btn_download_pdf">Descargar PDF</button>
      <button class="secondary" onclick="previewReport()" style="width:100%" data-i18n="btn_preview">Vista previa</button>
    </div>
  </div>

  <div class="card" id="reportPreview" style="display:none;margin-top:16px">
    <h2>Vista previa</h2>
    <div id="reportContent"></div>
  </div>

 </div>

 <div id="tab-knowledge" class="tab">
 <div class="card">
 <h2 data-i18n="h2_from_url">Agregar desde website</h2>
 <p style="color:#888;font-size:13px;margin:0 0 16px" data-i18n="p_from_url">Extrae automáticamente el contenido de una página web y lo agrega a la base de conocimiento.</p>
 <label data-i18n="label_url">URL de la página</label>
 <input id="urlSrc" placeholder="https://tuempresa.com/servicios" type="url">
 <label data-i18n="label_url_title">Título (opcional — si no, se usa el título de la página)</label>
 <input id="urlTitle" placeholder="Ej. Página de servicios">
 <br><br>
 <button id="btnScrape" onclick="scrapeUrl()" data-i18n="btn_scrape">Extraer contenido</button>
 </div>
 <div class="card">
 <h2 data-i18n="h2_upload_pdf">Subir PDF</h2>
 <label data-i18n="label_pdf_title">Título (opcional)</label>
 <input id="pdfTitle" placeholder="Ej. Catálogo de productos 2026">
 <label data-i18n="label_pdf_file">Archivo PDF</label>
 <input id="pdfFile" type="file" accept="application/pdf">
 <br><br>
 <button onclick="uploadPdf()" data-i18n="btn_upload_pdf">Subir PDF</button>
 </div>
 <div class="card">
 <h2 data-i18n="h2_add_text">Añadir texto</h2>
 <label data-i18n="label_txt_title">Título</label>
 <input id="txtTitle" placeholder="Ej. Política de devoluciones">
 <label data-i18n="label_txt_content">Contenido</label>
 <textarea id="txtContent" style="min-height:160px" placeholder="Pega aquí el texto: descripciones, precios, políticas, etc."></textarea>
 <br><br>
 <button onclick="uploadText()" data-i18n="btn_add_text">Añadir</button>
 </div>
 <div class="card">
 <h2 data-i18n="h2_docs">Documentos cargados</h2>
 <div id="docList"></div>
 </div>
 </div>

 <div id="tab-training" class="tab">
 <div class="card">
 <h2 data-i18n="h2_pending_training">Preguntas pendientes de entrenar</h2>
 <p style="color:#888;font-size:13px;margin:0 0 16px" data-i18n="p_pending_training">
 Aquí aparecen preguntas que el agente no supo responder (escalamientos) o que recibieron . Enséñale la respuesta correcta y la usará la próxima vez.
 </p>
 <div id="pendingList"></div>
 </div>
 <div class="card">
 <h2 data-i18n="h2_trained">Respuestas ya entrenadas</h2>
 <div id="trainedList"></div>
 </div>
 </div>

 <div id="tab-leads" class="tab">
 <div class="card">
 <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px;margin-bottom:16px">
  <h2 style="margin:0" data-i18n="h2_leads">Leads capturados</h2>
  <input id="leadSearch" placeholder="Buscar por nombre, email o telefono..." data-i18n-placeholder="leads_search_placeholder" style="width:260px;font-size:13px" oninput="filterLeads()">
 </div>
 <div id="leadList"><p style="color:#666">Cargando...</p></div>
 </div>
 </div>

 <div id="tab-convs" class="tab">
 <div class="card">
 <h2 data-i18n="h2_convs">Conversaciones recientes</h2>
 <div id="convList"></div>
 </div>
 <div id="convDetail" style="display:none">
  <div class="card">
   <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px;flex-wrap:wrap;gap:8px">
    <div style="display:flex;align-items:center;gap:10px">
     <span id="convDetailTitle" style="font-weight:600;color:#fff"></span>
     <span id="humanBadge" style="display:none;background:#e55;color:#fff;font-size:11px;padding:3px 10px;border-radius:20px">HUMANO ACTIVO</span>
     <span id="attnBadge" style="display:none;background:#f97316;color:#fff;font-size:11px;padding:3px 10px;border-radius:20px">REQUIERE ATENCIÓN</span>
     <span id="fuBadge" style="display:none;background:#1e293b;color:#94a3b8;font-size:11px;padding:3px 10px;border-radius:20px" id="fuBadge"></span>
    </div>
    <div style="display:flex;gap:8px">
     <button id="btnTakeover" onclick="toggleHumanMode(1)" style="background:#e55;text-transform:none;letter-spacing:0;font-size:13px;padding:7px 16px" data-i18n="btn_takeover">Tomar control (/)</button>
     <button id="btnReturnAI" onclick="toggleHumanMode(0)" style="display:none;text-transform:none;letter-spacing:0;font-size:13px;padding:7px 16px" data-i18n="btn_return_ai">Devolver a IA (//)</button>
     <button id="btnFuPause" onclick="followupPause()" style="display:none;background:#1e3a5f;color:#94a3b8;text-transform:none;letter-spacing:0;font-size:13px;padding:7px 14px" title="Pausar follow-up">⏸ Pausar FU</button>
     <button id="btnFuResume" onclick="followupResume()" style="display:none;background:#14532d;color:#4ade80;text-transform:none;letter-spacing:0;font-size:13px;padding:7px 14px" title="Reanudar follow-up">▶ Reanudar FU</button>
     <button id="btnAttnClear" onclick="attentionClear()" style="display:none;background:#7c2d12;color:#fb923c;text-transform:none;letter-spacing:0;font-size:13px;padding:7px 14px" title="Marcar atención resuelta">✓ Resolver</button>
    </div>
   </div>
   <div id="msgLog" class="msg-log"></div>
   <div style="display:flex;gap:8px;margin-top:12px">
    <input id="adminReplyInput" placeholder="Escribí tu respuesta..." style="flex:1" onkeydown="if(event.key==='Enter')sendAdminReply()">
    <button onclick="sendAdminReply()" style="text-transform:none;letter-spacing:0;padding:8px 18px">Enviar</button>
   </div>
   <p style="color:#555;font-size:11px;margin:6px 0 0">Escribí <b style="color:#aaa">/</b> para tomar control · <b style="color:#aaa">//</b> para devolver a la IA</p>
  </div>
 </div>
 </div>

 <div id="tab-followup" class="tab">
  <div class="card">
   <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:16px;flex-wrap:wrap;gap:10px">
    <h2 style="margin:0">Follow-up automático</h2>
    <div style="display:flex;align-items:center;gap:10px">
     <label style="display:flex;align-items:center;gap:8px;font-size:13px;color:#aaa;cursor:pointer">
      <input type="checkbox" id="followupEnabled" onchange="saveFollowupToggle(this.checked)" style="width:auto;margin:0">
      Activado para esta empresa
     </label>
    </div>
   </div>
   <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-bottom:20px">
    <div class="metric"><div class="v" id="fu-stat-active" style="color:#4ade80">0</div><div class="l">Con follow-up activo</div></div>
    <div class="metric"><div class="v" id="fu-stat-attention" style="color:#ef4444">0</div><div class="l">Requieren atención</div></div>
    <div class="metric"><div class="v" id="fu-stat-paused" style="color:#888">0</div><div class="l">Pausados</div></div>
   </div>
   <div style="margin-bottom:12px;display:flex;gap:8px;flex-wrap:wrap">
    <button onclick="loadFollowUp('all')" id="fu-filter-all" style="font-size:12px;padding:5px 12px;background:var(--gold);color:#000">Todos</button>
    <button onclick="loadFollowUp('attention')" id="fu-filter-attention" style="font-size:12px;padding:5px 12px">Atención</button>
    <button onclick="loadFollowUp('active')" id="fu-filter-active" style="font-size:12px;padding:5px 12px">▶ Activos</button>
    <button onclick="loadFollowUp('paused')" id="fu-filter-paused" style="font-size:12px;padding:5px 12px">⏸ Pausados</button>
   </div>
   <div id="followupList"><p style="color:#666">Cargando...</p></div>
  </div>
  <div style="background:var(--card);border:1px solid var(--border);border-radius:10px;padding:20px;margin-top:12px">
   <h3 style="margin:0 0 12px;font-size:14px;color:#aaa">¿Cómo funciona?</h3>
   <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:12px">
    <div style="background:#111;border-radius:8px;padding:14px">
     <div style="font-weight:700;color:var(--gold);margin-bottom:6px">Nivel 1 — 24 horas</div>
     <div style="font-size:12px;color:#888;line-height:1.5">Tono casual. Asume que el lead está ocupado. Mantiene la conversación viva con una pregunta fácil o puerta abierta.</div>
    </div>
    <div style="background:#111;border-radius:8px;padding:14px">
     <div style="font-weight:700;color:#f97316;margin-bottom:6px">Nivel 2 — 3 días</div>
     <div style="font-size:12px;color:#888;line-height:1.5">Tono directo. Cambia el ángulo. Disponibilidad específica, resultado de otro cliente, o respuesta a duda frecuente.</div>
    </div>
    <div style="background:#111;border-radius:8px;padding:14px">
     <div style="font-weight:700;color:#ef4444;margin-bottom:6px">Nivel 3 — 7 días</div>
     <div style="font-size:12px;color:#888;line-height:1.5">Tono fresco, casi primer contacto. Sin referencias al silencio previo. Después de este nivel se detiene el ciclo.</div>
    </div>
   </div>
   <div style="margin-top:12px;font-size:12px;color:#666">
    ⟳ El contador se reinicia cada vez que el lead responde. · ⏸ El seguimiento se pausa automáticamente al escalar a humano. · El scheduler revisa cada 30 minutos.
   </div>
  </div>
 </div>

 <div id="tab-whatsapp" class="tab">
 <div class="card">
 <h2 data-i18n="h2_connect_wa">Conectar WhatsApp</h2>
 <p style="color:#888;font-size:13px;margin:0 0 16px" data-i18n="p_connect_wa">Escanea el QR con WhatsApp en tu telefono (Configuracion → Dispositivos vinculados → Vincular dispositivo). Una vez conectado, el agente responde automaticamente.</p>
 <div id="builtinQrWrap" style="display:flex;flex-direction:column;align-items:center;gap:12px">
  <div id="builtinStatus" style="font-size:13px;color:#888">Haz clic en Generar QR para empezar</div>
  <img id="builtinQrImg" style="display:none;width:260px;height:260px;border-radius:12px;border:3px solid var(--gold);background:#fff;padding:8px" src="" alt="QR WhatsApp">
  <div id="builtinCountdown" style="display:none;font-size:12px;color:#888"></div>
  <div style="display:flex;gap:8px;flex-wrap:wrap;justify-content:center">
   <button id="btnBuiltinQr" onclick="loadBuiltinQr()">Generar QR</button>
   <button class="secondary" onclick="checkBuiltinStatus()" style="text-transform:none;letter-spacing:0">Verificar estado</button>
   <button class="secondary" id="btnDisconnect" onclick="disconnectBuiltin()" style="display:none;text-transform:none;letter-spacing:0;border-color:#e55;color:#e55">Desconectar</button>
  </div>
 </div>
 </div>

 <div class="card">
 <h2>Conexion via Evolution API (avanzado)</h2>
 <p style="color:#888;font-size:13px;margin:0 0 16px">
 Conecta WhatsApp usando <b>Evolution API</b> (ya corre en tu VPS). Crea una instancia en Evolution y pega los datos aquí.
 </p>
 <label>Base URL de Evolution</label>
 <input id="waBaseUrl" placeholder="https://evolution.tudominio.com">
 <div class="row">
 <div><label>Instance Name</label><input id="waInstance" placeholder="lynkro"></div>
 <div><label>API Key</label><input id="waApiKey" type="password" placeholder="tu apikey"></div>
 </div>
 <br>
 <button onclick="save()">Guardar credenciales</button>
 </div>

 <div class="card">
 <h2>Webhook</h2>
 <p style="color:#888;font-size:13px;margin:0 0 10px">
 En Evolution API → tu instance → <b>Webhook Settings</b> pega esta URL y activa el evento <code style="color:var(--gold)">messages.upsert</code>:
 </p>
 <input readonly id="waWebhook" style="font-family:monospace;font-size:12px" value="https://chat.lynkro.io/api/whatsapp/webhook">
 </div>

 <div class="card">
 <h2>QR para clientes (link de contacto)</h2>
 <p style="color:#888;font-size:13px;margin:0 0 16px">
 Genera un QR para poner en tu web, local o materiales. Cuando un cliente lo escanea, se abre directamente un chat de WhatsApp con tu numero.
 </p>
 <label>Número de WhatsApp del negocio (con código de país, sin +)</label>
 <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:flex-end;margin-bottom:16px">
  <input id="waContactPhone" placeholder="17865551234" style="flex:1;min-width:180px" oninput="clearContactQr()">
  <input id="waContactMsg" placeholder="Mensaje predefinido (opcional)" style="flex:2;min-width:200px" oninput="clearContactQr()">
  <button onclick="genContactQr()" style="white-space:nowrap">Generar QR</button>
 </div>
 <div id="waContactQrWrap" style="display:none;flex-direction:column;align-items:center;gap:12px">
  <img id="waContactCanvas" style="width:220px;height:220px;border-radius:12px;border:3px solid var(--gold);background:#fff;padding:8px" src="" alt="QR WhatsApp">
  <p style="color:#aaa;font-size:11px;margin:0;text-align:center;word-break:break-all" id="waContactQrUrl"></p>
  <div style="display:flex;gap:8px;flex-wrap:wrap;justify-content:center">
   <button onclick="downloadContactQr()">Descargar QR</button>
   <button class="secondary" onclick="copyContactUrl()" style="text-transform:none;letter-spacing:0">Copiar enlace</button>
   <button class="secondary" onclick="window.open(document.getElementById('waContactQrUrl').textContent,'_blank')" style="text-transform:none;letter-spacing:0">Probar link</button>
  </div>
 </div>
 </div>

 <div class="card">
 <h2>Conectar instancia al agente (Evolution API)</h2>
 <p style="color:#888;font-size:13px;margin:0 0 16px">
 Genera el QR, escanéalo con el teléfono que usará el agente, o descárgalo para enviárselo a quien vaya a testearlo.
 </p>
 <div style="display:flex;gap:10px;flex-wrap:wrap;align-items:center;margin-bottom:16px">
  <button onclick="loadWaQr()" id="btnGenQr">Generar QR</button>
  <button class="secondary" onclick="checkWaStatus()" style="text-transform:none;letter-spacing:0">Verificar estado</button>
  <span id="waStatusBadge" style="font-size:13px;padding:4px 12px;border-radius:20px;background:#1a1a1a;border:1px solid #333;display:none"></span>
 </div>
 <div id="waQrWrap" style="display:none;flex-direction:column;align-items:center;gap:12px">
  <img id="waQrImg" style="width:220px;height:220px;border-radius:12px;border:3px solid var(--gold);background:#fff;padding:8px" src="" alt="QR WhatsApp">
  <div style="display:flex;gap:8px">
   <button class="secondary" onclick="downloadWaQr()" style="text-transform:none;letter-spacing:0">Descargar QR</button>
   <button class="secondary" onclick="loadWaQr()" style="text-transform:none;letter-spacing:0">Refrescar</button>
  </div>
  <p style="color:#888;font-size:12px;margin:0;text-align:center">El QR expira en ~60 segundos. Si caduca, haz clic en Refrescar.</p>
 </div>
 </div>

 <div class="card">
 <h2>Probar envío</h2>
 <div class="row">
 <div><label>Número (con código país, sin +)</label><input id="waTestPhone" placeholder="5215551234567"></div>
 <div><label>Mensaje</label><input id="waTestMsg" placeholder="Hola desde el agente"></div>
 </div>
 <br>
 <button class="secondary" onclick="waTest()">Enviar prueba</button>
 </div>
 </div>

 <div id="tab-instagram" class="tab">
 <div class="card">
  <h2>Instagram Direct Messages</h2>
  <p style="color:#888;font-size:13px;margin:0 0 20px">Conecta tu cuenta de Instagram Business para que el agente responda automaticamente los DMs.</p>

  <!-- Not connected -->
  <div id="igNotConnected">
   <button onclick="connectInstagram()" style="background:linear-gradient(135deg,#833ab4,#fd1d1d,#fcb045);border:none;font-size:15px;padding:12px 28px;border-radius:10px;letter-spacing:0;text-transform:none">Conectar con Instagram</button>
   <br><br>
   <!-- Advanced: app credentials (collapsed by default) -->
   <details style="margin-top:8px">
    <summary style="color:#aaa;font-size:13px;cursor:pointer;user-select:none;margin-top:4px">Configuracion avanzada (App de Meta)</summary>
    <div style="margin-top:12px">
     <p style="color:#888;font-size:12px;margin:0 0 10px">Solo necesario si el administrador no configuró las credenciales en el servidor.</p>
     <div class="row">
      <div><label>Meta App ID</label><input id="metaAppId" placeholder="123456789012345"></div>
      <div><label>Meta App Secret</label><input id="metaAppSecret" type="password" placeholder="abcdef1234..."></div>
     </div>
     <br>
     <button onclick="saveMetaApp()" style="text-transform:none;letter-spacing:0;font-size:13px;padding:8px 18px">Guardar credenciales</button>
    </div>
   </details>
  </div>

  <!-- Connected state -->
  <div id="igConnected" style="display:none">
   <div style="display:flex;align-items:center;gap:12px;background:#1a1a1a;border:1px solid #333;border-radius:8px;padding:14px 16px;margin-bottom:16px">
    <span style="font-size:26px"></span>
    <div style="flex:1">
     <div style="font-weight:600;color:#fff;font-size:15px" id="igConnectedUser">@username</div>
     <div style="font-size:12px;color:#4caf50;margin-top:3px">Conectado</div>
    </div>
    <button onclick="disconnectInstagram()" style="background:transparent;border:1px solid #e55;color:#e55;padding:6px 14px;border-radius:6px;cursor:pointer;font-size:13px;text-transform:none;letter-spacing:0">Desconectar</button>
   </div>
  </div>

  <p style="color:#666;font-size:12px;margin:16px 0 4px">URL del webhook (Meta → Webhooks → Instagram → messages):</p>
  <input readonly id="igWebhookUrl" style="font-family:monospace;font-size:12px" value="">
 </div>
 </div>

 <div id="tab-users" class="tab">
 <div class="card">
  <h2 data-i18n="h2_create_user">Crear usuario</h2>
  <p style="color:var(--muted);font-size:13px;margin:0 0 16px" data-i18n="p_create_user">Cada usuario accede con su email y contraseña y solo puede ver las empresas que le asignes.</p>
  <div class="row">
   <div><label data-i18n="label_user_email">Email</label><input id="newUserEmail" type="email" placeholder="cliente@empresa.com"></div>
   <div><label data-i18n="label_user_pw">Contraseña</label><input id="newUserPassword" type="password" placeholder="Mínimo 8 caracteres"></div>
  </div>
  <label data-i18n="label_assigned_companies">Empresas asignadas</label>
  <div id="newUserCompanies" style="display:flex;flex-wrap:wrap;gap:8px;margin-top:6px"></div>
  <br>
  <button onclick="createUser()" data-i18n="btn_create_user">+ Crear usuario</button>
 </div>
 <div class="card">
  <h2 data-i18n="h2_users_list">Usuarios del sistema</h2>
  <div id="usersList"></div>
 </div>
 </div>

 <div id="tab-embed" class="tab">
 <div class="card">
 <h2 data-i18n="h2_embed">Código para embeber</h2>
 <p style="color:#aaa;font-size:14px" data-i18n="p_embed">Pega este script antes de <code style="color:var(--gold)">&lt;/body&gt;</code> en cualquier web:</p>
 <textarea readonly id="embedCode" style="min-height:80px;font-family:monospace;font-size:12px"></textarea>
 <br><br>
 <button class="secondary" onclick="copyEmbed()" data-i18n="btn_copy_embed">Copiar código</button>
 </div>
 </div>
</div>

 <div id="tab-billing" class="tab">
  <h2 style="margin-bottom:20px">Commerce Pro</h2>
  <div id="commerce-status-card" style="background:#1a1a1a;border:1px solid #2a2a2a;border-radius:12px;padding:24px;margin-bottom:20px;max-width:540px">
    <div style="display:flex;align-items:center;gap:12px;margin-bottom:16px">
      <span id="commerce-status-dot" style="width:10px;height:10px;border-radius:50%;background:#555;display:inline-block;flex-shrink:0"></span>
      <strong id="commerce-status-label">Cargando...</strong>
    </div>
    <p id="commerce-status-desc" style="color:#aaa;font-size:14px;margin-bottom:20px;line-height:1.5"></p>
    <div style="display:flex;gap:12px;flex-wrap:wrap">
      <button id="btn-upgrade" onclick="upgradeToCommercePro()" style="background:#6c47ff;color:#fff;border:none;padding:10px 20px;border-radius:8px;cursor:pointer;font-weight:600;display:none">⬆️ Activar Commerce Pro</button>
      <button id="btn-portal" onclick="openBillingPortal()" style="background:#2a2a2a;color:#fff;border:1px solid #3a3a3a;padding:10px 20px;border-radius:8px;cursor:pointer;display:none">Gestionar facturación</button>
    </div>
  </div>

 <!-- Commerce Pro sections — only visible when active -->
 <div id="commerce-pro-sections" style="display:none">

  <!-- STORES -->
  <h3 style="margin:28px 0 14px;font-size:16px">Tiendas conectadas</h3>
  <div id="stores-list" style="margin-bottom:16px"></div>
  <div style="display:flex;gap:10px;flex-wrap:wrap;margin-bottom:20px">
   <button onclick="showConnectForm()" style="background:#1e1e2e;color:#fff;border:1px solid #3a3a4a;padding:8px 16px;border-radius:8px;cursor:pointer;font-size:13px">+ Conectar Shopify</button>
   <button onclick="showConnectWooForm()" style="background:#1e1e2e;color:#fff;border:1px solid #3a3a4a;padding:8px 16px;border-radius:8px;cursor:pointer;font-size:13px">+ Conectar WooCommerce</button>
  </div>
  <div id="connect-shopify-form" style="display:none;background:#1a1a1a;border:1px solid #2a2a2a;border-radius:10px;padding:20px;max-width:480px;margin-bottom:20px">
   <h4 style="margin:0 0 14px;font-size:14px">Conectar Shopify</h4>
   <input id="shopify-url" placeholder="https://tu-tienda.myshopify.com" style="width:100%;box-sizing:border-box;background:#111;border:1px solid #333;color:#fff;padding:8px 12px;border-radius:6px;font-size:13px;margin-bottom:8px">
   <input id="shopify-token" placeholder="shpat_..." style="width:100%;box-sizing:border-box;background:#111;border:1px solid #333;color:#fff;padding:8px 12px;border-radius:6px;font-size:13px;margin-bottom:12px">
   <div style="display:flex;gap:8px">
    <button onclick="connectShopify()" style="background:#6c47ff;color:#fff;border:none;padding:8px 16px;border-radius:6px;cursor:pointer;font-size:13px">Conectar</button>
    <button onclick="document.getElementById('connect-shopify-form').style.display='none'" style="background:transparent;color:#aaa;border:1px solid #333;padding:8px 16px;border-radius:6px;cursor:pointer;font-size:13px">Cancelar</button>
   </div>
  </div>
  <div id="connect-woo-form" style="display:none;background:#1a1a1a;border:1px solid #2a2a2a;border-radius:10px;padding:20px;max-width:480px;margin-bottom:28px">
   <h4 style="margin:0 0 14px;font-size:14px">Conectar WooCommerce</h4>
   <input id="woo-url" placeholder="https://tu-tienda.com" style="width:100%;box-sizing:border-box;background:#111;border:1px solid #333;color:#fff;padding:8px 12px;border-radius:6px;font-size:13px;margin-bottom:8px">
   <input id="woo-key" placeholder="ck_..." style="width:100%;box-sizing:border-box;background:#111;border:1px solid #333;color:#fff;padding:8px 12px;border-radius:6px;font-size:13px;margin-bottom:8px">
   <input id="woo-secret" placeholder="cs_..." style="width:100%;box-sizing:border-box;background:#111;border:1px solid #333;color:#fff;padding:8px 12px;border-radius:6px;font-size:13px;margin-bottom:12px">
   <div style="display:flex;gap:8px">
    <button onclick="connectWoo()" style="background:#6c47ff;color:#fff;border:none;padding:8px 16px;border-radius:6px;cursor:pointer;font-size:13px">Conectar</button>
    <button onclick="document.getElementById('connect-woo-form').style.display='none'" style="background:transparent;color:#aaa;border:1px solid #333;padding:8px 16px;border-radius:6px;cursor:pointer;font-size:13px">Cancelar</button>
   </div>
  </div>

  <!-- PRODUCT RELATIONS -->
  <h3 style="margin:28px 0 14px;font-size:16px">Relaciones de productos</h3>
  <div id="relations-list" style="margin-bottom:14px;font-size:13px"></div>
  <div style="background:#1a1a1a;border:1px solid #2a2a2a;border-radius:10px;padding:16px;max-width:600px;margin-bottom:32px">
   <div style="display:grid;grid-template-columns:1fr 1fr 1fr auto;gap:8px;align-items:end">
    <div>
     <label style="font-size:11px;color:#888;display:block;margin-bottom:4px">Origen (ID)</label>
     <input id="rel-source" placeholder="ID producto" style="width:100%;box-sizing:border-box;background:#111;border:1px solid #333;color:#fff;padding:7px 10px;border-radius:6px;font-size:12px">
    </div>
    <div>
     <label style="font-size:11px;color:#888;display:block;margin-bottom:4px">Tipo</label>
     <select id="rel-type" style="width:100%;box-sizing:border-box;background:#111;border:1px solid #333;color:#fff;padding:7px 10px;border-radius:6px;font-size:12px">
      <option value="alternative">Alternativa</option>
      <option value="upsell">Upsell</option>
      <option value="downsell">Downsell</option>
      <option value="cross_sell">Cross-sell</option>
      <option value="bundle">Bundle</option>
      <option value="replacement">Reemplazo</option>
     </select>
    </div>
    <div>
     <label style="font-size:11px;color:#888;display:block;margin-bottom:4px">Destino (ID)</label>
     <input id="rel-target" placeholder="ID producto" style="width:100%;box-sizing:border-box;background:#111;border:1px solid #333;color:#fff;padding:7px 10px;border-radius:6px;font-size:12px">
    </div>
    <button onclick="addRelation()" style="background:#6c47ff;color:#fff;border:none;padding:8px 14px;border-radius:6px;cursor:pointer;font-size:13px;white-space:nowrap">+ Agregar</button>
   </div>
  </div>

  <!-- RECOVERY SETTINGS -->
  <h3 style="margin:28px 0 14px;font-size:16px">Configuración de recuperación</h3>
  <div style="background:#1a1a1a;border:1px solid #2a2a2a;border-radius:10px;padding:20px;max-width:480px;margin-bottom:32px">
   <label style="display:flex;align-items:center;gap:10px;margin-bottom:16px;cursor:pointer">
    <input type="checkbox" id="rec-coupon-enabled" style="width:16px;height:16px;accent-color:#6c47ff">
    <span style="font-size:14px">Enviar cupón de descuento en emails de recuperación</span>
   </label>
   <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:16px">
    <div>
     <label style="font-size:11px;color:#888;display:block;margin-bottom:4px">Tipo de descuento</label>
     <select id="rec-discount-type" style="width:100%;box-sizing:border-box;background:#111;border:1px solid #333;color:#fff;padding:8px;border-radius:6px;font-size:13px">
      <option value="percent">Porcentaje (%)</option>
      <option value="fixed">Monto fijo</option>
     </select>
    </div>
    <div>
     <label style="font-size:11px;color:#888;display:block;margin-bottom:4px">Valor del descuento</label>
     <input type="number" id="rec-discount-value" min="1" max="100" value="10" style="width:100%;box-sizing:border-box;background:#111;border:1px solid #333;color:#fff;padding:8px;border-radius:6px;font-size:13px">
    </div>
    <div>
     <label style="font-size:11px;color:#888;display:block;margin-bottom:4px">Expiración (horas)</label>
     <input type="number" id="rec-expiration-hours" min="1" value="48" style="width:100%;box-sizing:border-box;background:#111;border:1px solid #333;color:#fff;padding:8px;border-radius:6px;font-size:13px">
    </div>
    <div>
     <label style="font-size:11px;color:#888;display:block;margin-bottom:4px">Delay de envío (min)</label>
     <input type="number" id="rec-delay-minutes" min="15" value="60" style="width:100%;box-sizing:border-box;background:#111;border:1px solid #333;color:#fff;padding:8px;border-radius:6px;font-size:13px">
    </div>
   </div>
   <button onclick="saveRecoveryConfig()" style="background:#6c47ff;color:#fff;border:none;padding:9px 20px;border-radius:7px;cursor:pointer;font-size:13px;font-weight:600">Guardar configuración</button>
  </div>

  <!-- ANALYTICS -->
  <h3 style="margin:28px 0 14px;font-size:16px">Analytics</h3>
  <div id="analytics-grid" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:12px;margin-bottom:24px">
   <div class="analytics-card" id="an-discussed"><span class="an-val">—</span><span class="an-lbl">Conversaciones con productos</span></div>
   <div class="analytics-card" id="an-sent"><span class="an-val">—</span><span class="an-lbl">Emails de recuperación</span></div>
   <div class="analytics-card" id="an-converted"><span class="an-val">—</span><span class="an-lbl">Recuperados</span></div>
   <div class="analytics-card" id="an-rate"><span class="an-val">—</span><span class="an-lbl">Tasa de conversión</span></div>
  </div>
  <h4 style="font-size:13px;color:#aaa;margin:0 0 10px">Productos más consultados</h4>
  <div id="top-products-list" style="margin-bottom:32px;font-size:13px"></div>

 </div><!-- /#commerce-pro-sections -->
 </div><!-- /#tab-billing -->
</div>
</main>
</div>

<div id="toast" class="toast"></div>

<div id="demoModal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.75);z-index:9999;align-items:center;justify-content:center;padding:16px">
 <div style="background:var(--card);border:1px solid var(--border);border-radius:16px;width:100%;max-width:420px;display:flex;flex-direction:column;height:580px;max-height:calc(100vh - 40px)">
 <div style="padding:16px 20px;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;flex-shrink:0">
 <span style="font-weight:600;color:var(--gold);font-size:15px">Vista previa del agente</span>
 <div style="display:flex;gap:8px">
 <button class="secondary" onclick="resetDemo()" style="font-size:12px;padding:6px 12px;text-transform:none;letter-spacing:0">Reiniciar</button>
 <button class="secondary" onclick="closeDemo()" style="font-size:12px;padding:6px 12px;text-transform:none;letter-spacing:0">Cerrar</button>
 </div>
 </div>
 <div id="demoMessages" style="flex:1;overflow-y:auto;padding:16px;display:flex;flex-direction:column;gap:10px;background:#0c0f14;scrollbar-width:thin"></div>
 <form style="display:flex;gap:8px;padding:12px;border-top:1px solid var(--border);flex-shrink:0"
 onsubmit="event.preventDefault();const t=document.getElementById('demoInput').value.trim();if(t){document.getElementById('demoInput').value='';sendDemo(t);}">
 <input id="demoInput" placeholder="Escribe un mensaje..." style="flex:1;font-size:14px" autocomplete="off">
 <button type="submit" style="padding:8px 20px;text-transform:none;letter-spacing:0">Enviar</button>
 </form>
 </div>
</div>



</main>
