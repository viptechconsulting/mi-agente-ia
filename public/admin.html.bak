};
let _adminLang = localStorage.getItem('admin-lang') || 'es';
function t(key) { return (T_ADMIN[_adminLang] || T_ADMIN.es)[key] || key; }
function setAdminLang(lang) {
 _adminLang = lang;
 localStorage.setItem('admin-lang', lang);
 document.getElementById('al-es').classList.toggle('active', lang === 'es');
 document.getElementById('al-en').classList.toggle('active', lang === 'en');
 document.querySelectorAll('[data-i18n]').forEach(el => {
  const k = el.dataset.i18n;
  if (T_ADMIN[lang] && T_ADMIN[lang][k] !== undefined) el.textContent = T_ADMIN[lang][k];
 });
 document.querySelectorAll('[data-i18n-placeholder]').forEach(el => {
  const k = el.dataset.i18nPlaceholder;
  if (T_ADMIN[lang] && T_ADMIN[lang][k] !== undefined) el.placeholder = T_ADMIN[lang][k];
 });
 const isDark = (document.documentElement.getAttribute('data-theme') || 'dark') === 'dark';
 const themeTxt = document.getElementById('themeTxt');
 if (themeTxt) themeTxt.textContent = isDark ? t('theme_light') : t('theme_dark');
}
(function(){ setAdminLang(_adminLang); })();

let config = {}, password = '', adminEmail = '', activeCompanyId = sessionStorage.getItem('ai_active_company') || 'default', companies = [], isSuperAdmin = false, masterCompanyId = null;

const _origFetch = window.fetch.bind(window);
window.fetch = function(url, opts = {}) {
 if (typeof url === 'string' && url.startsWith('/api/')) {
 opts.headers = { ...(opts.headers || {}) };
 if (password && !opts.headers['x-admin-password']) opts.headers['x-admin-password'] = password;
 if (adminEmail && !opts.headers['x-admin-email']) opts.headers['x-admin-email'] = adminEmail;
 if (activeCompanyId && !opts.headers['x-company-id']) opts.headers['x-company-id'] = activeCompanyId;
 }
 return _origFetch(url, opts);
};

function api(url, opts) { return fetch(url, opts).then(r => r.json()); }

function toggleTheme() {
 const current = document.documentElement.getAttribute('data-theme') || 'dark';
 const next = current === 'light' ? 'dark' : 'light';
 document.documentElement.setAttribute('data-theme', next);
 localStorage.setItem('admin-theme', next);
 const icon = document.getElementById('themeIcon');
 const txt  = document.getElementById('themeTxt');
 if (icon) { icon.setAttribute('data-lucide', next === 'light' ? 'moon' : 'sun'); lucide.createIcons(); }
 if (txt)  txt.textContent = next === 'light' ? t('theme_dark') : t('theme_light');
}
(function(){
 const th = localStorage.getItem('admin-theme') || 'dark';
 document.documentElement.setAttribute('data-theme', th);
 if (th === 'light') {
  const icon = document.getElementById('themeIcon'); if (icon) icon.setAttribute('data-lucide','moon');
  const txt  = document.getElementById('themeTxt');  if (txt)  txt.textContent = 'Dark mode';
 }
})();

function isLynkroTemplate(c) {
 return masterCompanyId && c.parent_company_id === masterCompanyId;
}

function loadCompaniesList() {
 return fetch('/api/companies?demo=0', { headers: { 'x-admin-password': password } })
 .then(r => r.json()).then(rows => {
 companies = rows;
 // Real client companies only — exclude Lynkro.io demo templates
 const clientRows = rows.filter(c => !isLynkroTemplate(c));
 const sel = document.getElementById('companySelector');
 if (sel) {
  sel.innerHTML = clientRows.map(c => `<option value="${c.id}" ${c.id===activeCompanyId?'selected':''}>${c.active?'':' '}${c.name}</option>`).join('');
 }
 // Only auto-reset activeCompanyId if it's not a template being edited
 const activeIsTemplate = rows.find(c => c.id === activeCompanyId && isLynkroTemplate(c));
 if (!activeIsTemplate && !clientRows.find(c => c.id === activeCompanyId)) {
  activeCompanyId = clientRows[0]?.id || 'default';
  sessionStorage.setItem('ai_active_company', activeCompanyId);
 }
 renderCompaniesList();
 });
}

function renderCompaniesList() {
 const el = document.getElementById('companiesList');
 if (!el) return;
 const displayRows = companies.filter(c => !isLynkroTemplate(c));
 el.innerHTML = displayRows.map(c => `
 <div class="faq-item">
 <div style="display:flex;gap:8px;position:absolute;top:10px;right:10px">
 <button onclick="toggleCompany('${c.id}', ${c.active?0:1})" style="background:${c.active?'#2a2a0a':'#0a2a0a'};color:${c.active?'#fbbf24':'#4ade80'};border:1px solid #333;font-size:11px">${c.active?'Desactivar':'Activar'}</button>
 ${c.id!=='default'?`<button onclick="deleteCompanyAdmin('${c.id}','${c.name}')" style="font-size:11px">Eliminar</button>`:''}
 </div>
 <div style="margin-right:180px">
 <div style="font-weight:600;color:var(--gold);font-size:15px">${c.name} ${c.id===activeCompanyId?'<span style="color:#4ade80;font-size:11px;margin-left:8px"> ACTIVA</span>':''}</div>
 <div style="color:#888;font-size:12px;margin-top:4px">slug: <code style="background:#1a1a1a;padding:2px 6px;border-radius:4px">${c.slug}</code> · creada ${new Date(c.created_at).toLocaleDateString()}</div>
 <div style="color:#666;font-size:12px;margin-top:6px">Widget: <code style="background:#1a1a1a;padding:2px 6px;border-radius:4px;font-size:11px">&lt;script src="${location.origin}/widget.js" data-api="${location.origin}" data-company="${c.id}"&gt;&lt;/script&gt;</code></div>
 </div>
 </div>
 `).join('');
}

function editTemplate(id) {
 activeCompanyId = id;
 sessionStorage.setItem('ai_active_company', id);
 const sel = document.getElementById('companySelector');
 if (sel) sel.value = id;
 api('/api/config').then(c => {
  config = c;
  render();
  tab('config');
  toast('Plantilla lista para editar ✓');
 });
}

function switchCompany(id) {
 activeCompanyId = id;
 sessionStorage.setItem('ai_active_company', id);
 const sel = document.getElementById('companySelector');
 if (sel) sel.value = id;
 api('/api/config').then(c => {
  config = c;
  render();
  const activeTab = document.querySelector('.nav-item.active')?.dataset?.tab;
  if (activeTab === 'convs') loadConvs();
  else if (activeTab === 'leads') loadLeads();
  else if (activeTab === 'dashboard') loadDashboard();
  else if (activeTab === 'knowledge') loadDocs();
  else if (activeTab === 'training') loadTraining();
  else if (activeTab === 'reports') loadStats();
  toast('Empresa cambiada ✓'); if (window.__aiChatReload) window.__aiChatReload(id);
 });
}

function createCompany() {
 const name = document.getElementById('newCompanyName').value.trim();
 const slug = document.getElementById('newCompanySlug').value.trim();
 if (!name) return toast('Falta nombre');
 fetch('/api/companies', {
 method: 'POST',
 headers: { 'Content-Type': 'application/json', 'x-admin-password': password },
 body: JSON.stringify({ name, slug: slug || undefined })
 }).then(r => r.json()).then(d => {
 if (d.error) return toast('Error: '+d.error);
 toast('Empresa creada ');
 document.getElementById('newCompanyName').value = '';
 document.getElementById('newCompanySlug').value = '';
 loadCompaniesList();
 });
}

function toggleCompany(id, active) {
 fetch('/api/companies/'+id, {
 method: 'PATCH',
 headers: { 'Content-Type': 'application/json', 'x-admin-password': password },
 body: JSON.stringify({ active: !!active })
 }).then(() => loadCompaniesList());
}

function deleteCompanyAdmin(id, name) {
 if (!confirm(`¿Eliminar "${name}" y TODOS sus datos (conversaciones, docs, métricas)? Esto es irreversible.`)) return;
 fetch('/api/companies/'+id, { method: 'DELETE', headers: { 'x-admin-password': password } })
 .then(r => r.json()).then(d => {
 if (d.error) return toast('Error: '+d.error);
 if (id === activeCompanyId) { activeCompanyId = 'default'; sessionStorage.setItem('ai_active_company','default'); }
 toast('Empresa eliminada');
 loadCompaniesList();
 });
}

async function _doLogin(pw, email) {
 const rows = await fetch('/api/companies', { headers: { 'x-admin-password': pw, 'x-admin-email': email } })
  .then(r => { if (!r.ok) throw new Error('auth'); return r.json(); });
 password = pw; adminEmail = email;
 companies = rows;
 if (!rows.find(c => c.id === activeCompanyId)) activeCompanyId = rows[0]?.id || 'default';
 sessionStorage.setItem('ai_active_company', activeCompanyId);
 sessionStorage.setItem('ai_pw', pw);
 sessionStorage.setItem('ai_email', email);

 const me = await fetch('/api/auth/me', { headers: { 'x-admin-password': pw, 'x-admin-email': email } }).then(r => r.json());
 isSuperAdmin = me.isSuperAdmin || false;
 masterCompanyId = rows.find(c => /lynkro/i.test(c.name) && !c.parent_company_id)?.id || null;

 const cfgRes = await fetch('/api/config', { headers: { 'x-admin-password': pw, 'x-admin-email': email, 'x-company-id': activeCompanyId } });
 config = await cfgRes.json();
 document.getElementById('login').style.display = 'none';
 document.getElementById('app').style.display = 'block';
 document.querySelectorAll('.nav-superadmin').forEach(el => el.style.display = isSuperAdmin ? '' : 'none');
 await loadCompaniesList();
 render();
}

function login() {
 const pw = document.getElementById('pw').value;
 const email = (document.getElementById('adminEmail')?.value || '').trim();
 _doLogin(pw, email).catch(() => toast('Email o contraseña incorrectos'));
}

function logout() {
 sessionStorage.removeItem('ai_pw');
 sessionStorage.removeItem('ai_email');
 sessionStorage.removeItem('ai_active_company');
 password = ''; adminEmail = ''; config = {}; companies = []; masterCompanyId = null;
 document.getElementById('login').style.display = '';
 document.getElementById('app').style.display = 'none';
 document.getElementById('pw').value = '';
 const em = document.getElementById('adminEmail'); if (em) em.value = '';
}

// Auto-restore session on page load
(async function() {
 const savedPw = sessionStorage.getItem('ai_pw');
 const savedEmail = sessionStorage.getItem('ai_email') || '';
 if (!savedPw) return;
 try { await _doLogin(savedPw, savedEmail); }
 catch(e) { sessionStorage.removeItem('ai_pw'); sessionStorage.removeItem('ai_email'); }
})();

function render() {
 ['businessName','description','hours','contact','products','tone',
 'welcomeMessage','bookingUrl','systemPromptExtra','model','accentColor',
 'agentName','personality','language','voiceExamples',
 'waBaseUrl','waInstance','waApiKey',
 'metaAppId','metaAppSecret',
 'bgColor','userBubbleColor',
 'notifyEmail','smtpHost','smtpPort','smtpUser','smtpPass','smtpFrom'].forEach(k => {
 const el = document.getElementById(k);
 if (el) el.value = config[k] || '';
 });
 const t2 = document.getElementById('tone2'); if (t2) t2.value = config.tone || '';
 const ad = document.getElementById('autoDetectLanguage'); if (ad) ad.checked = config.autoDetectLanguage !== false;
 ['notifyOnLead','notifyOnEscalation','smtpSecure','bookingFollowupEnabled'].forEach(k => {
 const el = document.getElementById(k); if (el) el.checked = !!config[k];
 });
 // Human handoff
 const hhEnabled = document.getElementById('humanHandoffEnabled');
 if (hhEnabled) { hhEnabled.checked = !!config.humanHandoffEnabled; updateHandoffSlider(); }
 const hhTrig = document.getElementById('humanHandoffTriggers'); if (hhTrig) hhTrig.value = config.humanHandoffTriggers || '';
 const hhPhone = document.getElementById('humanHandoffPhone'); if (hhPhone) hhPhone.value = config.humanHandoffPhone || '';
 const hhMsg = document.getElementById('humanHandoffUserMsg'); if (hhMsg) hhMsg.value = config.humanHandoffUserMsg || '';
 const wh = document.getElementById('waWebhook'); if (wh) wh.value = `${location.origin}/api/whatsapp/webhook`;
 const igwh = document.getElementById('igWebhookUrl'); if (igwh) igwh.value = `${location.origin}/api/instagram/webhook`;
 // Instagram connected state
 const igNotConn = document.getElementById('igNotConnected');
 const igConn = document.getElementById('igConnected');
 if (config.igUsername) {
  if (igNotConn) igNotConn.style.display = 'none';
  if (igConn) { igConn.style.display = 'block'; document.getElementById('igConnectedUser').textContent = '@' + config.igUsername; }
 } else {
  if (igNotConn) igNotConn.style.display = 'block';
  if (igConn) igConn.style.display = 'none';
 }
 renderFaqs(); renderDefaults(); renderQuick(); renderHours(); renderAppearance();
 document.getElementById('embedCode').value =
 `<script src="${location.origin}/widget.js" data-api="${location.origin}" data-company="${activeCompanyId}"><\/script>`;
}

function renderFaqs() {
 const list = document.getElementById('faqList');
 list.innerHTML = '';
 (config.faqs || []).forEach((f, i) => {
 const div = document.createElement('div');
 div.className = 'faq-item';
 div.innerHTML = `
 <button onclick="removeFaq(${i})">Eliminar</button>
 <label>Pregunta</label>
 <input value="${(f.q||f.question||'').replace(/"/g,'&quot;')}" onchange="config.faqs[${i}].q=this.value">
 <label>Respuesta</label>
 <textarea onchange="config.faqs[${i}].a=this.value">${f.a||f.answer||''}</textarea>`;
 list.appendChild(div);
 });
}

function addFaq() { config.faqs = config.faqs || []; config.faqs.push({q:'',a:''}); renderFaqs(); }
function removeFaq(i) { config.faqs.splice(i,1); renderFaqs(); }

function renderDefaults() {
 const list = document.getElementById('defaultsList');
 if (!list) return;
 list.innerHTML = '';
 (config.defaultResponses || []).forEach((d, i) => {
 const div = document.createElement('div');
 div.className = 'faq-item';
 div.innerHTML = `
 <button onclick="removeDefault(${i})">Eliminar</button>
 <label>Situación</label>
 <input value="${(d.situation||'').replace(/"/g,'&quot;')}" onchange="config.defaultResponses[${i}].situation=this.value">
 <label>Respuesta</label>
 <textarea onchange="config.defaultResponses[${i}].response=this.value">${d.response||''}</textarea>`;
 list.appendChild(div);
 });
}
function addDefault() { config.defaultResponses = config.defaultResponses || []; config.defaultResponses.push({situation:'',response:''}); renderDefaults(); }
function removeDefault(i) { config.defaultResponses.splice(i,1); renderDefaults(); }

function testEmail() {
 fetch('/api/notify/test', { method:'POST', headers:{'x-admin-password': password}})
 .then(r => r.json()).then(d => toast(d.error ? 'Error: '+d.error : 'Email enviado '));
}

// ── STATS PORTAL ──────────────────────────────────────────
