   <img src="https://lynkro.io/logo1-removebg-preview.png" alt="Lynkro" style="height:30px;display:block;margin-bottom:10px">
   <div class="sub" data-i18n="sb_subtitle">Panel Admin · Multi-empresa</div>
  </div>
  <div class="sb-co">
   <label data-i18n="sb_empresa_label">Empresa activa</label>
   <select id="companySelector" onchange="switchCompany(this.value)">
    <option>Cargando...</option>
   </select>
  </div>
  <div class="sb-group">
   <div class="sb-label" data-i18n="sb_general">General</div>
   <button class="nav-item active" data-tab="dashboard" onclick="tab('dashboard')"><span class="ic"><i data-lucide="bar-chart-2"></i></span><span data-i18n="nav_dashboard">Dashboard</span></button>
   <button class="nav-item nav-superadmin" data-tab="companies" onclick="tab('companies')" style="display:none"><span class="ic"><i data-lucide="building-2"></i></span><span data-i18n="nav_companies">Empresas</span></button>
   <button class="nav-item" data-tab="demos" onclick="tab('demos')"><span class="ic"><i data-lucide="play-circle"></i></span><span data-i18n="nav_demos">Demos</span></button>
   <button class="nav-item nav-superadmin" data-tab="users" onclick="tab('users')" style="display:none"><span class="ic"><i data-lucide="users-round"></i></span><span data-i18n="nav_users">Usuarios</span></button>
  </div>
  <div class="sb-group">
   <div class="sb-label" data-i18n="sb_empresa">Empresa activa</div>
   <button class="nav-item" data-tab="config" onclick="tab('config')"><span class="ic"><i data-lucide="settings"></i></span><span data-i18n="nav_config">Configuración</span></button>
   <button class="nav-item" data-tab="persona" onclick="tab('persona')"><span class="ic"><i data-lucide="user-round"></i></span><span data-i18n="nav_persona">Personalidad</span></button>
   <button class="nav-item" data-tab="triggers" onclick="tab('triggers')"><span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg></span><span>Activadores</span></button>
   <button class="nav-item" data-tab="faqs" onclick="tab('faqs')"><span class="ic"><i data-lucide="help-circle"></i></span><span data-i18n="nav_faqs">FAQs</span></button>
   <button class="nav-item" data-tab="quick" onclick="tab('quick')"><span class="ic"><i data-lucide="zap"></i></span><span data-i18n="nav_quick">Resp. rápidas</span></button>
   <button class="nav-item" data-tab="hours" onclick="tab('hours')"><span class="ic"><i data-lucide="clock"></i></span><span data-i18n="nav_hours">Horarios</span></button>
   <button class="nav-item" data-tab="appearance" onclick="tab('appearance')"><span class="ic"><i data-lucide="palette"></i></span><span data-i18n="nav_appearance">Apariencia</span></button>
   <button class="nav-item" data-tab="notifications" onclick="tab('notifications')"><span class="ic"><i data-lucide="bell"></i></span><span data-i18n="nav_notifications">Notificaciones</span></button>
  </div>
